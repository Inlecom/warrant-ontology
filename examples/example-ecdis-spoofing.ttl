# ═══════════════════════════════════════════════════════════════════════════════
# VULNERABILITIES AND THREAT SCENARIOS
#
# The cyber content of the 0.9 file existed only as deviations and free text.
# Representing the threat scenarios explicitly is what lets a compromise be
# traced from the weakness it exploits to the assets it degrades and the risk
# it is evaluated as.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:Vul_UnauthenticatedAISBroadcast a cdm:Vulnerability ;
    warrant:hasName "AIS messages are broadcast without authentication" ;
    warrant:hasDescription "AIS operates as an open broadcast on the VHF AIS channels (87B/88B). A receiver cannot distinguish a genuine transmission from a counterfeit one, so any transmitter within VHF range can insert, displace or suppress contacts in the traffic picture." ;
    cdm:affectsComponent ll1:AIS_Transponder .

ll1:Vul_UnauthenticatedGNSSSignal a cdm:Vulnerability ;
    warrant:hasName "Civil GNSS signals carry no authentication" ;
    warrant:hasDescription "The receiver cannot distinguish a genuine satellite signal from a counterfeit one without integrity monitoring. Signal-strength monitoring does not help: a spoofed signal normally arrives at normal or elevated carrier-to-noise density." ;
    cdm:affectsComponent ll1:GPS_1 , ll1:GPS_2 .

ll1:Vul_RemovableMediaUpdatePath a cdm:Vulnerability ;
    warrant:hasName "Removable-media update and storage paths on bridge OT" ;
    warrant:hasDescription "ECDIS carries CF and SD storage with a DVD update interface, the VDR a CF card, and Inmarsat-C a legacy floppy update path, per the equipment inventory. Each is an unmediated route for code or configuration onto a bridge OT device." ;
    cdm:affectsComponent ll1:ECDIS_1 , ll1:VDR , ll1:InmarsatC_1 .

ll1:Vul_SatTerminalNoEndpointProtection a cdm:Vulnerability ;
    warrant:hasName "Satellite terminals without endpoint protection" ;
    warrant:hasDescription "Both Inmarsat GX and FBB-500 run Linux with no antivirus or firewall configured, per the equipment inventory, on the LAN that also carries shore internet traffic to the Communications PC." ;
    cdm:affectsComponent ll1:InmarsatGX , ll1:InmarsatFBB .

ll1:Vul_FlatBridgeLANSegment a cdm:Vulnerability ;
    warrant:hasName "Shared bridge LAN segment" ;
    warrant:hasDescription "The radar to ECDIS LAN is shared with other bridge systems, so a foothold on one device has a path to the others without crossing a conduit." ;
    cdm:affectsComponent ll1:ECDIS_1 .

ll1:Threat_AISSpoofing a cdm:ThreatScenario ;
    warrant:hasName "AIS target spoofing" ;
    warrant:hasDescription "An adversary within VHF range transmits counterfeit AIS messages, inserting phantom contacts, displacing real ones or suppressing them. Detected by correlation against radar returns, not by signal quality. Own-ship position is unaffected." ;
    cdm:exploits ll1:Vul_UnauthenticatedAISBroadcast ;
    cdm:degrades ll1:AIS_Transponder , ll1:Link_AIS_NavBus , ll1:NavigationFunction ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskCollisionGrounding .

ll1:Threat_GNSSSpoofing a cdm:ThreatScenario ;
    warrant:hasName "GNSS spoofing" ;
    warrant:hasDescription "Counterfeit GNSS signals cause the receiver to output a plausible but false position, which propagates over the serial navigation bus to every consumer, including the ECDIS own-ship position and the AIS position the vessel broadcasts about itself. Detected by RAIM integrity, by consistency against radar ranges to charted features and dead reckoning, and by disagreement between constellations." ;
    cdm:exploits ll1:Vul_UnauthenticatedGNSSSignal ;
    cdm:degrades ll1:GPS_1 , ll1:GPS_2 , ll1:NavigationFunction ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskCollisionGrounding .

ll1:Threat_ECDISCompromise a cdm:ThreatScenario ;
    warrant:hasName "ECDIS compromise through removable media or the shared LAN" ;
    warrant:hasDescription "Unauthorised change to ECDIS display parameters, chart datum or software, introduced through the storage and update paths or laterally across the bridge LAN." ;
    cdm:exploits ll1:Vul_RemovableMediaUpdatePath , ll1:Vul_FlatBridgeLANSegment ;
    cdm:degrades ll1:ECDIS_1 , ll1:NavigationFunction ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskCollisionGrounding .

ll1:Threat_VDRTampering a cdm:ThreatScenario ;
    warrant:hasName "VDR tampering to conceal an incident timeline" ;
    warrant:hasDescription "Erasure or overwriting of stored voyage data, typically alongside another attack so that the record of it is unavailable to the investigation. The highest-RPN entry in the navigation OT worksheet." ;
    cdm:exploits ll1:Vul_RemovableMediaUpdatePath ;
    cdm:degrades ll1:VDR , ll1:VoyageRecordingFunction ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskVDREvidenceLoss .

ll1:Threat_AMSCompromise a cdm:ThreatScenario ;
    warrant:hasName "Alarm monitoring system data compromise" ;
    warrant:hasDescription "Falsification of engine room and vessel-wide alarm data so that the crew cannot detect fire, flooding or machinery failure. Highest RPN in the whole worksheet at 315." ;
    cdm:degrades ll1:AlarmMonitoringSystem , ll1:ElectricalAlarmFunction ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskEngineRoomUnmonitored .

ll1:Threat_SatCommCompromise a cdm:ThreatScenario ;
    warrant:hasName "Satellite terminal compromise at the IT/OT boundary" ;
    warrant:hasDescription "Compromise of an unprotected satellite terminal from the shore side, removing long-range communications and providing a foothold on the LAN shared with the Communications PC." ;
    cdm:exploits ll1:Vul_SatTerminalNoEndpointProtection ;
    cdm:degrades ll1:InmarsatGX , ll1:InmarsatFBB , ll1:CommunicationFunction , ll1:Zone_ShipBusinessIT ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskDistressCommsLoss .


# ═══════════════════════════════════════════════════════════════════════════════
# DESIGN-TIME CONTROLS AND RESIDUAL RISK
#
# These are the controls recorded in the FMEA "current" and "recommended"
# columns, which the 0.9 file carried only inside the mitigation-rule
# descriptions. Modelling them explicitly is what lets a runtime action point
# back at the approved control it relies on, and lets a claim be made about
# the control rather than about the action.
#
# Residual risk is quantified for the two controls whose worksheet records a
# before-and-after judgement; the others are approved but not yet quantified.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:CTRL_RadarGPSCrossCheck a cdm:Control ;
    warrant:hasIdentifier "CTRL-NAV-001" ;
    warrant:hasName "Cross-check of AIS and GNSS position against radar" ;
    warrant:hasDescription "Standing bridge practice and an automated IDS check: AIS contacts are correlated against radar returns, and the GNSS fix against radar ranges and bearings to charted features. The independent leg is the radar; comparing the two GPS receivers with each other is not independent." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_AISSpoofing , ll1:Threat_GNSSSpoofing , ll1:HazHazardousAreaApproach ;
    cdm:hasResidualRisk ll1:ResidualRisk_SpoofingWithCrossCheck .

ll1:ResidualRisk_SpoofingWithCrossCheck a cdm:Risk ;
    warrant:hasName "Residual collision or grounding risk with the radar cross-check in force" ;
    warrant:hasDescription "The cross-check does not eliminate the exposure: it depends on the officer performing it, on charted features being in radar range, and on the radar itself not being compromised." ;
    cdm:hasLikelihood          "0.15"^^xsd:decimal ;
    cdm:hasSafetyImpact        "0.95"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.70"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.85"^^xsd:decimal ;
    cdm:hasImpact              "0.95"^^xsd:decimal ;
    cdm:hasRiskLevel           "Medium" ;
    cdm:hasAcceptability       "ALARP" ;
    cdm:hasHazardClass         cdm:CYBER_THREAT .

ll1:CTRL_USBPortLocking a cdm:Control ;
    warrant:hasIdentifier "CTRL-CYB-002" ;
    warrant:hasName "USB port locking on navigation and automation OT" ;
    warrant:hasDescription "Physical port blockers on radar, ECDIS, GPS, AIS, VDR and BNWAS, recorded as a recommended control across the worksheet. Addresses the removable-media path but not the LAN path." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_ECDISCompromise , ll1:Threat_VDRTampering , ll1:Threat_AMSCompromise .

ll1:CTRL_BridgeRestrictedArea a cdm:Control ;
    warrant:hasIdentifier "CTRL-CYB-003" ;
    warrant:hasName "Bridge restricted area and visitor logging" ;
    warrant:hasDescription "The bridge is a restricted area with log entry for all non-crew personnel, monitored during audits and superintendence inspections. A detective control across all navigation OT." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_ECDISCompromise , ll1:Threat_VDRTampering .

ll1:CTRL_ServiceEngineerAccessControl a cdm:Control ;
    warrant:hasIdentifier "CTRL-CYB-004" ;
    warrant:hasName "Service-engineer-only access with authorisation codes" ;
    warrant:hasDescription "Configuration access to radar, ECDIS, gyrocompass, autopilot, speed log, AIS, BNWAS and VDR is restricted to the maker's service engineer and gated by authorisation codes, per the equipment inventory." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_ECDISCompromise .

ll1:CTRL_VDRIntegrityMonitoring a cdm:Control ;
    warrant:hasIdentifier "CTRL-VDR-005" ;
    warrant:hasName "Hash-based VDR record integrity monitoring" ;
    warrant:hasDescription "Periodic cryptographic verification of stored voyage data, so that erasure or modification is detected while the evidence may still be recoverable rather than at the point of investigation." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_VDRTampering ;
    cdm:hasResidualRisk ll1:ResidualRisk_VDRWithHashMonitoring .

ll1:ResidualRisk_VDRWithHashMonitoring a cdm:Risk ;
    warrant:hasName "Residual voyage-record evidence loss with integrity monitoring in force" ;
    cdm:hasLikelihood          "0.15"^^xsd:decimal ;
    cdm:hasSafetyImpact        "0.20"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.10"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.70"^^xsd:decimal ;
    cdm:hasImpact              "0.70"^^xsd:decimal ;
    cdm:hasRiskLevel           "Medium" ;
    cdm:hasAcceptability       "ALARP" ;
    cdm:hasHazardClass         cdm:CYBER_THREAT .

ll1:CTRL_PaperChartBackup a cdm:Control ;
    warrant:hasIdentifier "CTRL-NAV-006" ;
    warrant:hasName "Paper chart and celestial navigation backup" ;
    warrant:hasDescription "The SOLAS backup arrangement: a second ECDIS and paper charts, with celestial navigation and dead reckoning available when GNSS is lost. Adequate in open ocean for extended periods; the constraint is the coastal phase." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:HazLossOfNavigationPicture .

ll1:CTRL_RedundantCommunications a cdm:Control ;
    warrant:hasIdentifier "CTRL-COM-007" ;
    warrant:hasName "Redundant distress communication paths" ;
    warrant:hasDescription "Three VHF DSC sets, MF/HF, two Inmarsat-C terminals and FBB, so that no single compromised or misconfigured set removes distress alerting." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_SatCommCompromise , ll1:HazLossOfDistressComms .

ll1:CTRL_AMSBackupAndLogMonitoring a cdm:Control ;
    warrant:hasIdentifier "CTRL-ELE-008" ;
    warrant:hasName "AMS data backup and log monitoring" ;
    warrant:hasDescription "Backup of alarm monitoring data to removable media with log monitoring, the existing control against the highest-RPN entry in the worksheet. The Chief Engineer is the responsible authority." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos technical department" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_AMSCompromise .

# The runtime advisories and procedures already in this file implement these
# approved controls; this is the link that lets a claim about a control be
# supported by evidence that the corresponding action was actually taken.
ll1:ActionCrossCheckRADARGPS    mit:implementsControl ll1:CTRL_RadarGPSCrossCheck .
ll1:ActionDualGPSCrossCheck     mit:implementsControl ll1:CTRL_RadarGPSCrossCheck .
ll1:ActionUSBLocker             mit:implementsControl ll1:CTRL_USBPortLocking .
ll1:ActionBridgeAccessRestriction mit:implementsControl ll1:CTRL_BridgeRestrictedArea .
ll1:ActionVDRHashMonitoring     mit:implementsControl ll1:CTRL_VDRIntegrityMonitoring .
ll1:ActionPaperChartsBackup     mit:implementsControl ll1:CTRL_PaperChartBackup .
ll1:ActionDeadReckoningFallback mit:implementsControl ll1:CTRL_PaperChartBackup .
ll1:ActionRedundantVHF          mit:implementsControl ll1:CTRL_RedundantCommunications .
ll1:ActionAMSBackupRestore      mit:implementsControl ll1:CTRL_AMSBackupAndLogMonitoring .

# Response strategy typing and default posture for the existing actions.
ll1:ActionCrossCheckRADARGPS      mit:hasStrategyType mit:ENHANCED_MONITORING ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionDualGPSCrossCheck       mit:hasStrategyType mit:ENHANCED_MONITORING ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionAlertMasterVSOC         mit:hasStrategyType mit:OPERATOR_ESCALATION ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionDeadReckoningFallback   mit:hasStrategyType mit:SAFE_DEGRADED_MODE ;  mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionPaperChartsBackup       mit:hasStrategyType mit:RECONFIGURATION ;     mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionVDRHashMonitoring       mit:hasStrategyType mit:ENHANCED_MONITORING ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionUSBLocker               mit:hasStrategyType mit:LOGICAL_ISOLATION ;   mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionBridgeAccessRestriction mit:hasStrategyType mit:LOGICAL_ISOLATION ;   mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionAMSBackupRestore        mit:hasStrategyType mit:RECOVERY ;            mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionRedundantVHF            mit:hasStrategyType mit:REDUNDANCY_ACTIVATION ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL .

ll1:ActionAlertMasterVSOC   mit:requiresAuthorisationFrom ll1:NavigationOfficerRole .
ll1:ActionAMSBackupRestore  mit:requiresAuthorisationFrom ll1:ChiefEngineerRole .


# ═══════════════════════════════════════════════════════════════════════════════
# ASSURANCE DEGRADATION & SCORES
# ═══════════════════════════════════════════════════════════════════════════════

ll1:NavigationCyberDegradation a assr:AssuranceDegradation ;
    warrant:hasName "Navigation Cybersecurity Assurance Degradation" .

ll1:PositionSensorDegradation a assr:AssuranceDegradation ;
    warrant:hasName "Position and Heading Sensor Degradation" .

ll1:VDRIntegrityDegradation a assr:AssuranceDegradation ;
    warrant:hasName "VDR Data Integrity Degradation" .

ll1:CommAvailabilityDegradation a assr:AssuranceDegradation ;
    warrant:hasName "Communication Availability Degradation" .

ll1:AMSReliabilityDegradation a assr:AssuranceDegradation ;
    warrant:hasName "AMS Monitoring Reliability Degradation" .

ll1:DevSpoofedAIS            assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .
ll1:DevGPSSpoofed            assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .
ll1:DevECDISSettingsModified assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .
ll1:WrongCourseAlterationUCA assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .
ll1:DevGPSJammed             assr:causesAssuranceDegradation ll1:PositionSensorDegradation .
ll1:DevGyroSettingsModified  assr:causesAssuranceDegradation ll1:PositionSensorDegradation .
ll1:DevGyroInterfaceDisconnected assr:causesAssuranceDegradation ll1:PositionSensorDegradation .
ll1:DevSpeedlogModified      assr:causesAssuranceDegradation ll1:PositionSensorDegradation .
ll1:DevVDRDataModified       assr:causesAssuranceDegradation ll1:VDRIntegrityDegradation .
ll1:DevVDRDataNotStored      assr:causesAssuranceDegradation ll1:VDRIntegrityDegradation .
ll1:DevVHFSettingsModified   assr:causesAssuranceDegradation ll1:CommAvailabilityDegradation .
ll1:DevSatCommUnavailable    assr:causesAssuranceDegradation ll1:CommAvailabilityDegradation .
ll1:DevAMSDataCorrupted      assr:causesAssuranceDegradation ll1:AMSReliabilityDegradation .

# — Assurance scores (per function, at time of spoofing event)
ll1:NavCyberAssuranceScore a assr:AssuranceScore ;
    assr:hasScoreValue "0.20"^^xsd:decimal ;
    di:calculatedAt    "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:SensorAssuranceScore a assr:AssuranceScore ;
    assr:hasScoreValue "0.35"^^xsd:decimal ;
    di:calculatedAt    "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:VDRAssuranceScore a assr:AssuranceScore ;
    assr:hasScoreValue "0.30"^^xsd:decimal ;
    di:calculatedAt    "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:CommAssuranceScore a assr:AssuranceScore ;
    assr:hasScoreValue "0.60"^^xsd:decimal ;
    di:calculatedAt    "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:AMSAssuranceScore a assr:AssuranceScore ;
    assr:hasScoreValue "0.15"^^xsd:decimal ;
    di:calculatedAt    "2026-06-01T07:00:05Z"^^xsd:dateTime .

ll1:NavigationFunction      assr:hasAssuranceScore ll1:NavCyberAssuranceScore .
ll1:NavigationFunction      assr:hasAssuranceScore ll1:SensorAssuranceScore .
ll1:VoyageRecordingFunction assr:hasAssuranceScore ll1:VDRAssuranceScore .
ll1:CommunicationFunction   assr:hasAssuranceScore ll1:CommAssuranceScore .
ll1:ElectricalAlarmFunction assr:hasAssuranceScore ll1:AMSAssuranceScore .

ll1:NavigationCyberDegradation   assr:updatesAssuranceScore ll1:NavCyberAssuranceScore .
ll1:PositionSensorDegradation    assr:updatesAssuranceScore ll1:SensorAssuranceScore .
ll1:VDRIntegrityDegradation      assr:updatesAssuranceScore ll1:VDRAssuranceScore .
ll1:CommAvailabilityDegradation  assr:updatesAssuranceScore ll1:CommAssuranceScore .
ll1:AMSReliabilityDegradation    assr:updatesAssuranceScore ll1:AMSAssuranceScore .


# ═══════════════════════════════════════════════════════════════════════════════
# DEPENDABILITY INDEX (DI) — per function + composite vessel DI
# ═══════════════════════════════════════════════════════════════════════════════

ll1:DI_Method_LL1 a di:DICalculationMethod ;
    warrant:hasName "Risk-Propagation DI for LL1 Navigation/Comms OT" .

ll1:DI_Navigation a di:DependabilityIndex ;
    di:hasDIValue            "0.18"^^xsd:decimal ;
    di:hasBetaWeight         "0.40"^^xsd:decimal ;
    di:calculatedAt          "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:UnsafeState .

ll1:DI_VDR a di:DependabilityIndex ;
    di:hasDIValue            "0.28"^^xsd:decimal ;
    di:hasBetaWeight         "0.15"^^xsd:decimal ;
    di:calculatedAt          "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:CriticalState .

ll1:DI_Communication a di:DependabilityIndex ;
    di:hasDIValue            "0.55"^^xsd:decimal ;
    di:hasBetaWeight         "0.20"^^xsd:decimal ;
    di:calculatedAt          "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:DegradedState .

ll1:DI_ElectricalAlarm a di:DependabilityIndex ;
    di:hasDIValue            "0.12"^^xsd:decimal ;
    di:hasBetaWeight         "0.25"^^xsd:decimal ;
    di:calculatedAt          "2026-06-01T07:00:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:UnsafeState .

# The vessel-level index is the system DI, not another node index: it is the
# recursive aggregation of the four function indices that contribute to it.
# The aggregation weights (di:DIWeight) are not yet modelled for LL1, so the
# stated value is the analyst's figure rather than a derived one; modelling
# them is part of the outstanding LL1 alignment work.
ll1:DI_LL1_Composite a di:SystemDependabilityIndex ;
    di:hasSystemDIValue      "0.25"^^xsd:decimal ;
    di:calculatedAt          "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:UnsafeState .

ll1:NavCyberAssuranceScore di:contributesTo ll1:DI_Navigation .
ll1:SensorAssuranceScore   di:contributesTo ll1:DI_Navigation .
ll1:VDRAssuranceScore      di:contributesTo ll1:DI_VDR .
ll1:CommAssuranceScore     di:contributesTo ll1:DI_Communication .
ll1:AMSAssuranceScore      di:contributesTo ll1:DI_ElectricalAlarm .

ll1:DI_Navigation      di:contributesToSystem ll1:DI_LL1_Composite .
ll1:DI_VDR             di:contributesToSystem ll1:DI_LL1_Composite .
ll1:DI_Communication   di:contributesToSystem ll1:DI_LL1_Composite .
ll1:DI_ElectricalAlarm di:contributesToSystem ll1:DI_LL1_Composite .

ll1:DI_Navigation      di:appliesTo ll1:NavigationFunction .
ll1:DI_VDR             di:appliesTo ll1:VoyageRecordingFunction .
ll1:DI_Communication   di:appliesTo ll1:CommunicationFunction .
ll1:DI_ElectricalAlarm di:appliesTo ll1:ElectricalAlarmFunction .
ll1:DI_LL1_Composite   di:appliesTo ll1:ContainerVessel_LL1 .


# ═══════════════════════════════════════════════════════════════════════════════
# MITIGATION
# (Controls from FMEA "Current Controls" and "Recommended Controls" columns)
# ═══════════════════════════════════════════════════════════════════════════════

# — Rules
ll1:RuleAISSpoofing a mit:MitigationRule ;
    warrant:hasName "AIS Spoofing Mitigation Rule" ;
    warrant:hasDescription "FMEA: Log monitoring / equipment inspection / bridge restricted area. Recommended: cross-check AIS with RADAR and GPS; alert Master and VSOC if discrepancy confirmed." .

ll1:RuleGPSJamming a mit:MitigationRule ;
    warrant:hasName "GPS Jamming Mitigation Rule" ;
    warrant:hasDescription "FMEA recommended: user awareness/training. Fallback: celestial/visual navigation, dead reckoning, dual GPS cross-check." .

ll1:RuleECDISSecurity a mit:MitigationRule ;
    warrant:hasName "ECDIS Settings Security Rule" ;
    warrant:hasDescription "FMEA: procedures available / paper charts. Recommended: USB locker, access restricted to service engineer, authorization codes, focused audit area." .

ll1:RuleVDRIntegrity a mit:MitigationRule ;
    warrant:hasName "VDR Data Integrity Rule" ;
    warrant:hasDescription "FMEA (RPN=180): procedures + log monitoring. Recommended: USB locker where applicable / job orders on maker's representatives. Hash-based integrity monitoring." .

ll1:RuleAMSSecurity a mit:MitigationRule ;
    warrant:hasName "AMS Security Rule (FMEA Highest RPN)" ;
    warrant:hasDescription "FMEA (RPN=315): back-up USB/CD + log monitoring. Recommended: user awareness/training/USB locker. Chief Engineer responsible." .

ll1:RuleCommSecurity a mit:MitigationRule ;
    warrant:hasName "Communication System Security Rule" ;
    warrant:hasDescription "FMEA: procedures / redundant systems (second VHF/Inmarsat). Recommended: restrict access, authorization codes, focused area during audit." .

ll1:DevSpoofedAIS            mit:matchesRule ll1:RuleAISSpoofing .
ll1:DevGPSJammed             mit:matchesRule ll1:RuleGPSJamming .
ll1:DevGPSSpoofed            mit:matchesRule ll1:RuleGPSJamming .
ll1:DevECDISSettingsModified mit:matchesRule ll1:RuleECDISSecurity .
ll1:DevECDISInterfaceModified mit:matchesRule ll1:RuleECDISSecurity .
ll1:DevVDRDataModified       mit:matchesRule ll1:RuleVDRIntegrity .
ll1:DevVDRDataNotStored      mit:matchesRule ll1:RuleVDRIntegrity .
ll1:DevAMSDataCorrupted      mit:matchesRule ll1:RuleAMSSecurity .
ll1:DevVHFSettingsModified   mit:matchesRule ll1:RuleCommSecurity .
ll1:DevSatCommUnavailable    mit:matchesRule ll1:RuleCommSecurity .

# — Actions
ll1:ActionCrossCheckRADARGPS a mit:AdvisoryAction ;
    warrant:hasName "Cross-Check AIS Position with RADAR and GPS" ;
    warrant:hasDescription "Advisory: immediately compare AIS-reported position with RADAR echo returns and dual GPS fix. Do not act on AIS alone when discrepancy detected." .

ll1:ActionAlertMasterVSOC a mit:AdvisoryAction ;
    warrant:hasName "Alert Master and Vessel Security Officer (VSOC)" ;
    warrant:hasDescription "Advisory: notify Ship Master and VSOC of suspected AIS spoofing or navigation cyber-attack. Initiate cyber incident log per ISM Code." .

ll1:ActionDeadReckoningFallback a mit:FailoverProcedure ;
    warrant:hasName "Dead Reckoning / Celestial Navigation Fallback" ;
    warrant:hasDescription "Switch to dead reckoning using last known position + gyrocompass + speedlog. Use celestial navigation or visual bearings. FMEA recommended fallback for GPS jamming." .

ll1:ActionDualGPSCrossCheck a mit:AdvisoryAction ;
    warrant:hasName "Dual GPS Cross-Check (GPS No1 vs GPS No2)" ;
    warrant:hasDescription "Advisory: compare positions from GPS No1 (GP-170, SW 2051542-02.04) and GPS No2. Any divergence >50m triggers investigation. Satellite compass heading serves as additional reference." .

ll1:ActionPaperChartsBackup a mit:FailoverProcedure ;
    warrant:hasName "Paper Chart Backup Navigation" ;
    warrant:hasDescription "Fallback to paper charts if both ECDIS units are unavailable or compromised. FMEA existing control for ECDIS failure. Bridge restricted area enforces access control." .

ll1:ActionVDRHashMonitoring a mit:AdvisoryAction ;
    warrant:hasName "VDR Hash-Based Integrity Monitoring" ;
    warrant:hasDescription "Recommended: periodically verify stored VDR data using cryptographic hash. Detect erasure or modification before evidence is lost. Supplement FMEA recommended USB locker." .

ll1:ActionUSBLocker a mit:AdvisoryAction ;
    warrant:hasName "USB Port Locking on Navigation OT Equipment" ;
    warrant:hasDescription "FMEA recommended control across RADAR, ECDIS, GPS, AIS, VDR, BNWAS. Physical USB port blockers prevent unauthorised media insertion. Applied by Navigation Officer." .

ll1:ActionBridgeAccessRestriction a mit:AdvisoryAction ;
    warrant:hasName "Bridge Restricted Area Access Control" ;
    warrant:hasDescription "FMEA detective control across all navigation OT. Bridge treated as restricted area; log entry of all non-crew personnel. Monitored during audits / superintendence inspections." .

ll1:ActionAMSBackupRestore a mit:FailoverProcedure ;
    warrant:hasName "AMS Data Backup and Restore (USB/CD)" ;
    warrant:hasDescription "FMEA existing control (RPN=315): back-up USB/CD of AMS monitoring data. Chief Engineer responsible. Post-incident restore from backup if data corruption detected." .

ll1:ActionRedundantVHF a mit:FailoverProcedure ;
    warrant:hasName "Switch to Redundant VHF (No2 or No3)" ;
    warrant:hasDescription "FMEA existing control: second VHF available. Immediately switch to VHF No2 or No3 (FM-8900S) if VHF No1 settings are compromised." .

ll1:RuleAISSpoofing  mit:recommends ll1:ActionCrossCheckRADARGPS .
ll1:RuleAISSpoofing  mit:recommends ll1:ActionAlertMasterVSOC .
ll1:RuleGPSJamming   mit:recommends ll1:ActionDeadReckoningFallback .
ll1:RuleGPSJamming   mit:recommends ll1:ActionDualGPSCrossCheck .
ll1:RuleECDISSecurity mit:recommends ll1:ActionPaperChartsBackup .
ll1:RuleECDISSecurity mit:recommends ll1:ActionUSBLocker .
ll1:RuleECDISSecurity mit:recommends ll1:ActionBridgeAccessRestriction .
ll1:RuleVDRIntegrity mit:recommends ll1:ActionVDRHashMonitoring .
ll1:RuleVDRIntegrity mit:recommends ll1:ActionUSBLocker .
ll1:RuleAMSSecurity  mit:recommends ll1:ActionAMSBackupRestore .
ll1:RuleAMSSecurity  mit:recommends ll1:ActionUSBLocker .
ll1:RuleCommSecurity mit:recommends ll1:ActionRedundantVHF .
ll1:RuleCommSecurity mit:recommends ll1:ActionBridgeAccessRestriction .

ll1:ActionCrossCheckRADARGPS    mit:addresses ll1:Link_AIS_NavBus .
ll1:ActionDeadReckoningFallback mit:addresses ll1:NavigationFunction .
ll1:ActionPaperChartsBackup     mit:addresses ll1:NavigationFunction .
ll1:ActionVDRHashMonitoring     mit:addresses ll1:VDR .
ll1:ActionRedundantVHF          mit:addresses ll1:CommunicationFunction .
ll1:ActionAMSBackupRestore      mit:addresses ll1:AlarmMonitoringSystem .


# ═══════════════════════════════════════════════════════════════════════════════
# DIGITAL TWIN
# ═══════════════════════════════════════════════════════════════════════════════

ll1:ContainerVessel_DigitalTwin a dt:DigitalTwin ;
    warrant:hasName "LL1 Containership Digital Twin (Danaos / CATHERINE C)" .

ll1:ContainerVessel_DigitalTwin dt:representsStateOf ll1:ContainerVessel_LL1 .

ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_LL1_Composite .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_Navigation .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_VDR .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_Communication .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_ElectricalAlarm .

ll1:ContainerVessel_DigitalTwin dt:visualises ll1:HazHazardousAreaApproach .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:HazLossOfNavigationPicture .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:HazLossOfVDREvidence .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:HazLossOfDistressComms .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:HazUnmonitoredEngineRoom .

ll1:ContainerVessel_DigitalTwin dt:visualises ll1:RiskCollisionGrounding .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:RiskEngineRoomUnmonitored .

ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DevSpoofedAIS .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DevAMSDataCorrupted .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DevVDRDataModified .

ll1:ContainerVessel_DigitalTwin dt:visualises ll1:ActionCrossCheckRADARGPS .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:ActionAlertMasterVSOC .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:ActionAMSBackupRestore .

ll1:ContainerVessel_DigitalTwin dt:receivesUpdateFrom ll1:IDSAnalyticalService .
ll1:ContainerVessel_DigitalTwin dt:receivesUpdateFrom ll1:NavigationIntegrityService .
ll1:ContainerVessel_DigitalTwin dt:receivesUpdateFrom ll1:VDRHealthService .

