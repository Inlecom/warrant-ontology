# ═══════════════════════════════════════════════════════════════════════════════
# BRIDGE NETWORK — Communication Links (from Diagram 2)
# Interface type encoded in description (FLAG-03: no davom:hasInterfaceType)
# ═══════════════════════════════════════════════════════════════════════════════

# — LAN segment (Radar ↔ ECDIS backbone — primary navigation data bus)
ll1:Link_RadarECDIS_LAN a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-RAD-ECDIS-LAN" ;
    warrant:hasName "Radar–ECDIS LAN Link" ;
    davom:hasInterfaceType davom:LAN ;
    warrant:hasDescription "Carries X-band Radar ↔ S-band Radar ↔ No1/No2 ECDIS target and overlay data. Highest-bandwidth navigation data bus. LAN exposure: shared with other bridge systems — potential lateral movement path." .

# — GPS serial bus (GPS → many receivers)
ll1:Link_GPS_NavBus a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-GPS-NAVBUS" ;
    warrant:hasName "GPS Serial Navigation Bus" ;
    davom:hasInterfaceType davom:SERIAL ;
    warrant:hasDescription "IEC-61162 / NMEA 0183. GPS No1/No2 position data distributed to X/S Radars, ECDIS, Gyrocompass, Autopilot, Speedlog, VDR, VHF, MF/HF, INM-C, Navtex. Single point of spoofing/jamming impacts all receivers." .

# — Gyrocompass serial bus
ll1:Link_Gyro_NavBus a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-GYR-NAVBUS" ;
    warrant:hasName "Gyrocompass Serial Distribution Bus" ;
    davom:hasInterfaceType davom:SERIAL ;
    warrant:hasDescription "IEC-61162. Gyrocompass heading distributed to X/S Radars, ECDIS, Autopilot, AIS, Course recorder, Speedlog, VDR, Inmarsat GX, CX-100. Compromise propagates to all heading-dependent subsystems." .

# — AIS serial link (bidirectional with ECDIS and Radars)
ll1:Link_AIS_NavBus a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-AIS-NAVBUS" ;
    warrant:hasName "AIS–Navigation Serial Link" ;
    davom:hasInterfaceType davom:SERIAL ;
    warrant:hasDescription "IEC-61162. AIS data (own-ship identity, target positions) distributed to X/S Radars, ECDIS No1, VDR. AIS transponder also receives GPS, Gyrocompass, Speedlog. VHF-based open protocol — no authentication — primary spoofing vector." .

# — VDR data collection links
ll1:Link_VDR_Serial a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-VDR-SERIAL" ;
    warrant:hasName "VDR Serial/Contact Collection Link" ;
    davom:hasInterfaceType davom:SERIAL_CONTACT ;
    warrant:hasDescription "VDR collects from GPS, Gyrocompass, AIS, Speedlog, Autopilot, Echosounder, Anemometer (SERIAL), and Engine control system, Watertight door, Hull door, Hull stress monitoring, AMS (SERIAL+CONTACT)." .

ll1:Link_VDR_AudioVideo a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-VDR-AV" ;
    warrant:hasName "VDR Audio-Video Collection Link" ;
    davom:hasInterfaceType davom:VIDEO ;
    warrant:hasDescription "S-band Radar image (VIDEO) and VHF channels and bridge microphones (AUDIO) captured by VDR. Tampering with VDR audio/video input blocks accident investigation evidence." .

# — Satellite/shore communications LAN
ll1:Link_SatComm_LAN a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-SAT-LAN" ;
    warrant:hasName "Satellite Communication LAN (IT/OT Boundary)" ;
    davom:hasInterfaceType davom:LAN ;
    warrant:hasDescription "Inmarsat GX and FBB-500 connect to Communications PC via LAN. Key IT/OT boundary: shore-based internet traffic reaches this LAN. Both GX and FBB run Linux with no antivirus/firewall (per makers' inventory). Principal external attack ingress path." .

# — BNWAS → AMS link
ll1:Link_BNWAS_AMS a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-BNWAS-AMS" ;
    warrant:hasName "BNWAS–AMS Serial Link" ;
    davom:hasInterfaceType davom:SERIAL ;
    warrant:hasDescription "BNWAS bridge watch alarm status reported to AMS. Failure of this link can mask watch alarm suppression." .

# — Function ↔ link associations
ll1:NavigationFunction      davom:usesCommunicationLink ll1:Link_RadarECDIS_LAN .
ll1:NavigationFunction      davom:usesCommunicationLink ll1:Link_GPS_NavBus .
ll1:NavigationFunction      davom:usesCommunicationLink ll1:Link_Gyro_NavBus .
ll1:NavigationFunction      davom:usesCommunicationLink ll1:Link_AIS_NavBus .
ll1:VoyageRecordingFunction davom:usesCommunicationLink ll1:Link_VDR_Serial .
ll1:VoyageRecordingFunction davom:usesCommunicationLink ll1:Link_VDR_AudioVideo .
ll1:CommunicationFunction   davom:usesCommunicationLink ll1:Link_SatComm_LAN .
ll1:ElectricalAlarmFunction davom:usesCommunicationLink ll1:Link_BNWAS_AMS .


# ═══════════════════════════════════════════════════════════════════════════════
# HUMAN OPERATOR ROLES
# ═══════════════════════════════════════════════════════════════════════════════

ll1:NavigationOfficerRole a davom:HumanOperatorRole ;
    warrant:hasName "Navigation Officer" ;
    warrant:hasDescription "Officer responsible for safe navigation using ECDIS, RADAR, and chart systems. Responsible authority for navigation OT FMEA controls." .

ll1:ChiefEngineerRole a davom:HumanOperatorRole ;
    warrant:hasName "Chief Engineer" ;
    warrant:hasDescription "Responsible for AMS, M/E remote control, power management, and electrical OT. Responsible authority for electrical/automation OT FMEA controls." .

ll1:ElectricalDeptRole a davom:HumanOperatorRole ;
    warrant:hasName "Electrical Department Officer" ;
    warrant:hasDescription "Responsible for fire detection, general alarm, MF/HF, and Inmarsat-C maintenance." .

ll1:NavigationFunction      davom:requiresOperatorRole ll1:NavigationOfficerRole .
ll1:CommunicationFunction   davom:requiresOperatorRole ll1:NavigationOfficerRole .
ll1:VoyageRecordingFunction davom:requiresOperatorRole ll1:NavigationOfficerRole .
ll1:ElectricalAlarmFunction davom:requiresOperatorRole ll1:ChiefEngineerRole .
ll1:ElectricalAlarmFunction davom:requiresOperatorRole ll1:ElectricalDeptRole .


# ═══════════════════════════════════════════════════════════════════════════════
# METRICS
# ═══════════════════════════════════════════════════════════════════════════════

# — Navigation integrity metrics
ll1:AISPositionIntegrityMetric a obs:CybersecurityMetric ;
    warrant:hasName "AIS Position Data Integrity" ;
    obs:hasUnit "integrity_score" ;
    obs:hasExternalTimeSeriesId "timeseries.ais.position_integrity.LL1" .

ll1:AISMessageIntegrityMetric a obs:CybersecurityMetric ;
    warrant:hasName "AIS Message Integrity" ;
    obs:hasUnit "integrity_score" ;
    obs:hasExternalTimeSeriesId "timeseries.ais.message_integrity.LL1" .

ll1:GPSPositionConsistencyMetric a obs:SafetyMetric ;
    warrant:hasName "GPS Position Cross-Check Consistency (GPS1 vs GPS2 vs RADAR)" ;
    obs:hasUnit "m" ;
    obs:hasExternalTimeSeriesId "timeseries.gps.position_consistency.LL1" .

ll1:GyroHeadingConsistencyMetric a obs:SafetyMetric ;
    warrant:hasName "Gyrocompass–Sat-Compass Heading Consistency" ;
    obs:hasUnit "deg" ;
    obs:hasExternalTimeSeriesId "timeseries.gyro.heading_consistency.LL1" .

ll1:ECDISAvailabilityMetric a obs:AvailabilityMetric ;
    warrant:hasName "ECDIS System Availability (No1 + No2)" ;
    obs:hasUnit "ratio" ;
    obs:hasExternalTimeSeriesId "timeseries.ecdis.availability.LL1" .

# — VDR recording health metrics
ll1:VDRRecordingStatusMetric a obs:AvailabilityMetric ;
    warrant:hasName "VDR Recording Status" ;
    obs:hasUnit "boolean" ;
    obs:hasExternalTimeSeriesId "timeseries.vdr.recording_status.LL1" .

ll1:VDRDataIntegrityMetric a obs:CybersecurityMetric ;
    warrant:hasName "VDR Data Integrity Hash" ;
    obs:hasUnit "hash_match_score" ;
    obs:hasExternalTimeSeriesId "timeseries.vdr.data_integrity.LL1" .

# — Communication health metrics
ll1:SatCommAvailabilityMetric a obs:AvailabilityMetric ;
    warrant:hasName "Satellite Communication Link Availability (GX + FBB)" ;
    obs:hasUnit "ratio" ;
    obs:hasExternalTimeSeriesId "timeseries.satcomm.availability.LL1" .

# — AMS health
ll1:AMSDataIntegrityMetric a obs:CybersecurityMetric ;
    warrant:hasName "AMS Monitoring Data Integrity" ;
    obs:hasUnit "integrity_score" ;
    obs:hasExternalTimeSeriesId "timeseries.ams.data_integrity.LL1" .

# — Metric assignments
ll1:AIS_Transponder obs:hasDependabilityMetric ll1:AISPositionIntegrityMetric .
ll1:Link_AIS_NavBus obs:hasDependabilityMetric ll1:AISMessageIntegrityMetric .
ll1:GPS_1           obs:hasDependabilityMetric ll1:GPSPositionConsistencyMetric .
ll1:Gyrocompass     obs:hasDependabilityMetric ll1:GyroHeadingConsistencyMetric .
ll1:ECDIS_1         obs:hasDependabilityMetric ll1:ECDISAvailabilityMetric .
ll1:VDR             obs:hasDependabilityMetric ll1:VDRRecordingStatusMetric .
ll1:VDR             obs:hasDependabilityMetric ll1:VDRDataIntegrityMetric .
ll1:Link_SatComm_LAN obs:hasDependabilityMetric ll1:SatCommAvailabilityMetric .
ll1:AlarmMonitoringSystem obs:hasDependabilityMetric ll1:AMSDataIntegrityMetric .


# ═══════════════════════════════════════════════════════════════════════════════
# ANALYTICAL SERVICES
# ═══════════════════════════════════════════════════════════════════════════════

ll1:IDSAnalyticalService a obs:AnalyticalService ;
    warrant:hasName "IDS Analytical Service — Navigation Cyber Monitoring" ;
    warrant:hasDescription "Intrusion Detection System monitoring AIS/GPS data integrity, RADAR-AIS position divergence, and ECDIS/VDR log anomalies. Primary detection capability for cyber-attack scenarios in LL1." .

ll1:NavigationIntegrityService a obs:AnalyticalService ;
    warrant:hasName "Navigation Sensor Integrity Cross-Check Service" ;
    warrant:hasDescription "Cross-validates GPS1 vs GPS2 vs RADAR-derived position, gyrocompass vs satellite compass heading. Detects sensor failure, jamming, or spoofing by multi-source comparison." .

ll1:VDRHealthService a obs:AnalyticalService ;
    warrant:hasName "VDR Recording Health Monitoring Service" ;
    warrant:hasDescription "Monitors VDR recording status, data write health, and hash-based integrity of stored records. Detects tampering, data loss, or storage failure." .

ll1:IDSAnalyticalService obs:consumes ll1:AISPositionIntegrityMetric .
ll1:IDSAnalyticalService obs:consumes ll1:AISMessageIntegrityMetric .
ll1:IDSAnalyticalService obs:consumes ll1:ECDISAvailabilityMetric .
ll1:IDSAnalyticalService obs:consumes ll1:AMSDataIntegrityMetric .
ll1:NavigationIntegrityService obs:consumes ll1:GPSPositionConsistencyMetric .
ll1:NavigationIntegrityService obs:consumes ll1:GyroHeadingConsistencyMetric .
ll1:VDRHealthService obs:consumes ll1:VDRRecordingStatusMetric .
ll1:VDRHealthService obs:consumes ll1:VDRDataIntegrityMetric .


# ═══════════════════════════════════════════════════════════════════════════════
# DETECTION EVENTS
# ═══════════════════════════════════════════════════════════════════════════════

ll1:AISSpoofingDetectionEvent a obs:DetectionEvent ;
    warrant:hasName "AIS Spoofing Detection Event" ;
    warrant:hasDescription "IDS detected significant divergence between AIS-reported target positions and the correlated radar returns for the same contacts; delta exceeds the 0.5 NM threshold, and one reported contact has no radar return at all. This correlation is the detection that AIS spoofing admits; own-ship position is cross-checked separately by the navigation integrity service." ;
    obs:hasTimestamp "2026-06-01T09:45:00Z"^^xsd:dateTime .

ll1:GPSJammingDetectionEvent a obs:DetectionEvent ;
    warrant:hasName "GPS Jamming Detection Event" ;
    warrant:hasDescription "Navigation integrity service detected simultaneous loss of GPS No1 and No2 position fix, characteristic of broadband jamming. Vessel fell back to dead reckoning." ;
    obs:hasTimestamp "2026-06-01T11:10:00Z"^^xsd:dateTime .

ll1:ECDISSettingsModifiedEvent a obs:DetectionEvent ;
    warrant:hasName "ECDIS Settings Modification Event" ;
    warrant:hasDescription "IDS log analysis detected unauthorised write to ECDIS No1 configuration file. Access was not from authorised service engineer session." ;
    obs:hasTimestamp "2026-06-01T08:30:00Z"^^xsd:dateTime .

ll1:VDRDataTamperEvent a obs:DetectionEvent ;
    warrant:hasName "VDR Data Tampering Detection Event" ;
    warrant:hasDescription "VDR health service detected hash mismatch in stored voyage record block — possible erasure or overwrite of recorded data." ;
    obs:hasTimestamp "2026-06-01T13:00:00Z"^^xsd:dateTime .

ll1:AMSDataCorruptionEvent a obs:DetectionEvent ;
    warrant:hasName "AMS Data Corruption Detection Event" ;
    warrant:hasDescription "IDS detected anomalous data in AMS monitoring feed — sensor values outside physical range, consistent with unauthorised data change. FMEA worst-case entry: RPN=315." ;
    obs:hasTimestamp "2026-06-01T07:00:00Z"^^xsd:dateTime .

ll1:GyroHeadingDivergenceEvent a obs:DetectionEvent ;
    warrant:hasName "Gyrocompass–Satellite Compass Heading Divergence Event" ;
    warrant:hasDescription "Heading divergence between Gyrocompass (CMZ-900) and Satellite Compass exceeded 3° — possible gyrocompass settings modification or hardware fault." ;
    obs:hasTimestamp "2026-06-01T10:15:00Z"^^xsd:dateTime .

ll1:IDSAnalyticalService     obs:producesDetectionEvent ll1:AISSpoofingDetectionEvent .
ll1:IDSAnalyticalService     obs:producesDetectionEvent ll1:ECDISSettingsModifiedEvent .
ll1:IDSAnalyticalService     obs:producesDetectionEvent ll1:VDRDataTamperEvent .
ll1:IDSAnalyticalService     obs:producesDetectionEvent ll1:AMSDataCorruptionEvent .
ll1:NavigationIntegrityService obs:producesDetectionEvent ll1:GPSJammingDetectionEvent .
ll1:NavigationIntegrityService obs:producesDetectionEvent ll1:GyroHeadingDivergenceEvent .

# Every Deviation must be grounded in a DetectionEvent (Critical Design
# Constraint 1). The eight deviations below were asserted directly in the 0.9
# version of this file; each now carries the detection that would actually
# raise it, attributed to the service that performs that check.

ll1:GPSSpoofingDetectionEvent a obs:DetectionEvent ;
    warrant:hasName "GPS Position Spoofing Detection Event" ;
    warrant:hasDescription "Navigation integrity service detected a position jump inconsistent with vessel dynamics and a growing offset between the GPS fix and the radar-derived position from charted features, while carrier-to-noise density remained normal. Signal strength cannot distinguish a spoofed fix; the consistency residual can." ;
    obs:hasTimestamp "2026-06-01T09:44:30Z"^^xsd:dateTime .

ll1:ECDISSensorFeedLossEvent a obs:DetectionEvent ;
    warrant:hasName "ECDIS Sensor Feed Loss Detection Event" ;
    warrant:hasDescription "ECDIS No1 reported loss of one or more IEC 61162 sensor inputs (GPS, gyro, speed log, echo sounder, anemometer); the integrated display fell back to manual entry for the affected values." ;
    obs:hasTimestamp "2026-06-01T08:35:00Z"^^xsd:dateTime .

ll1:SpeedlogInconsistencyEvent a obs:DetectionEvent ;
    warrant:hasName "Speedlog Inconsistency Detection Event" ;
    warrant:hasDescription "Speed through water from the speed log diverged from GPS speed over ground beyond the value explicable by set and drift on this leg, indicating invalid speed-log output rather than current." ;
    obs:hasTimestamp "2026-06-01T10:05:00Z"^^xsd:dateTime .

ll1:GyroFeedLossEvent a obs:DetectionEvent ;
    warrant:hasName "Gyrocompass Feed Loss Detection Event" ;
    warrant:hasDescription "Loss of the gyrocompass heading telegram on the serial distribution bus; radars, ECDIS, autopilot and AIS lost their heading reference simultaneously, which distinguishes a bus or interface failure from a single-consumer fault." ;
    obs:hasTimestamp "2026-06-01T10:20:00Z"^^xsd:dateTime .

ll1:RadarConfigurationChangeEvent a obs:DetectionEvent ;
    warrant:hasName "Radar Configuration Change Detection Event" ;
    warrant:hasDescription "IDS log analysis detected a change to X-band radar display and target-tracking settings outside an authorised service-engineer session." ;
    obs:hasTimestamp "2026-06-01T08:50:00Z"^^xsd:dateTime .

ll1:VDRRecordingStoppedEvent a obs:DetectionEvent ;
    warrant:hasName "VDR Recording Stopped Detection Event" ;
    warrant:hasDescription "VDR health service detected that no new voyage data blocks had been written for longer than the configured interval: recording has stopped rather than been altered." ;
    obs:hasTimestamp "2026-06-01T12:40:00Z"^^xsd:dateTime .

ll1:VHFConfigurationChangeEvent a obs:DetectionEvent ;
    warrant:hasName "VHF Configuration Change Detection Event" ;
    warrant:hasDescription "IDS detected a change to VHF No1 channel and DSC configuration; distress alerting capability could no longer be assumed available on that set." ;
    obs:hasTimestamp "2026-06-01T11:30:00Z"^^xsd:dateTime .

ll1:SatCommLinkLossEvent a obs:DetectionEvent ;
    warrant:hasName "Satellite Communication Link Loss Detection Event" ;
    warrant:hasDescription "Loss of both Inmarsat GX and FBB-500 connectivity at the Communications PC LAN boundary, beyond the duration explicable by ordinary beam handover or rain fade." ;
    obs:hasTimestamp "2026-06-01T11:45:00Z"^^xsd:dateTime .

ll1:NavigationIntegrityService obs:producesDetectionEvent ll1:GPSSpoofingDetectionEvent .
ll1:NavigationIntegrityService obs:producesDetectionEvent ll1:SpeedlogInconsistencyEvent .
ll1:NavigationIntegrityService obs:producesDetectionEvent ll1:GyroFeedLossEvent .
ll1:IDSAnalyticalService       obs:producesDetectionEvent ll1:ECDISSensorFeedLossEvent .
ll1:IDSAnalyticalService       obs:producesDetectionEvent ll1:RadarConfigurationChangeEvent .
ll1:IDSAnalyticalService       obs:producesDetectionEvent ll1:VHFConfigurationChangeEvent .
ll1:IDSAnalyticalService       obs:producesDetectionEvent ll1:SatCommLinkLossEvent .
ll1:VDRHealthService           obs:producesDetectionEvent ll1:VDRRecordingStoppedEvent .


# ═══════════════════════════════════════════════════════════════════════════════
# DEVIATIONS
# (FMEA failure modes mapped to HAZOP guidewords; RPN documented in description)
# ═══════════════════════════════════════════════════════════════════════════════

# — AIS/ECDIS cyber attack
ll1:DevSpoofedAIS a cdm:Deviation ;
    warrant:hasName "Spoofed AIS Target Data" ;
    warrant:hasDescription "Counterfeit AIS messages injected by an adversary over the open VHF AIS channels (87B/88B), which carry no authentication. The effect is on the TARGET picture: phantom, displaced or suppressed contacts appear in the ECDIS AIS overlay and in the radar-AIS correlation. It is NOT an own-ship position error: ECDIS takes own-ship position from the GNSS receiver over the IEC 61162 bus (ll1:Link_GPS_NavBus), not from AIS. The attacks that move own ship on the chart are GNSS spoofing (ll1:DevGPSSpoofed) and ECDIS compromise (ll1:DevECDISSettingsModified). FMEA: AIS transponder, interfaces modified / SW infected." ;
    cdm:hasDeviationType cdm:SPOOFED .

ll1:DevECDISSettingsModified a cdm:Deviation ;
    warrant:hasName "ECDIS Settings Modified (Unauthorised)" ;
    warrant:hasDescription "ECDIS display parameters or chart datum modified by unauthorised access. FMEA Asset 2: settings modified Sev=6 Prob=6 Det=3 RPN=108. Storage: CF/SD card, DVD update interface." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:DevECDISInterfaceModified a cdm:Deviation ;
    warrant:hasName "ECDIS Sensor Interface Disconnected/Modified" ;
    warrant:hasDescription "Loss of sensor feeds (GPS, Gyro, Speedlog, Anemometer, Echosounder) to ECDIS due to SERIAL interface manipulation. FMEA RPN=90." ;
    cdm:hasDeviationType cdm:UNAVAILABLE .

# — GPS failure modes
ll1:DevGPSJammed a cdm:Deviation ;
    warrant:hasName "GPS Signal Jammed (External)" ;
    warrant:hasDescription "External GPS jamming causes loss of position fix on both GPS units. FMEA Asset 8: signal jammed Sev=7 Prob=3 Det=3 RPN=63. Fallback: celestial/visual navigation, dead reckoning." ;
    cdm:hasDeviationType cdm:NO .

ll1:DevGPSSpoofed a cdm:Deviation ;
    warrant:hasName "GPS Position Data Spoofed" ;
    warrant:hasDescription "GPS receiver outputs manipulated position data; all downstream systems (ECDIS, Radars, AIS, Autopilot, Speedlog, VDR, VHF, MF/HF, INM-C) receive false position. FMEA: settings modified RPN=108." ;
    cdm:hasDeviationType cdm:SPOOFED .

# — Gyrocompass failure modes
ll1:DevGyroSettingsModified a cdm:Deviation ;
    warrant:hasName "Gyrocompass Settings Modified" ;
    warrant:hasDescription "Invalid heading data distributed to X/S Radars, ECDIS, Autopilot, AIS, Course recorder, Speedlog, VDR. FMEA Asset 4: Sev=7 Prob=3 Det=3 RPN=63. Fallback: Satellite Compass and Magnetic Compass." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:DevGyroInterfaceDisconnected a cdm:Deviation ;
    warrant:hasName "Gyrocompass Interface Disconnected" ;
    warrant:hasDescription "Loss of gyro heading feed to all interconnected equipment. FMEA Asset 4: interface disconnected Sev=7 Prob=3 Det=3 RPN=63." ;
    cdm:hasDeviationType cdm:UNAVAILABLE .

# — Speedlog failure modes
ll1:DevSpeedlogModified a cdm:Deviation ;
    warrant:hasName "Speedlog Data Invalid" ;
    warrant:hasDescription "False speed-through-water data distributed to RADAR, ECDIS, Gyrocompass, Autopilot, AIS, VDR. FMEA Asset 6: settings modified Sev=7 Prob=5 Det=3 RPN=105. Fallback: GPS SOG." ;
    cdm:hasDeviationType cdm:WRONG .

# — RADAR failure modes
ll1:DevRADARSettingsModified a cdm:Deviation ;
    warrant:hasName "RADAR Settings Modified" ;
    warrant:hasDescription "Loss of RADAR display settings or user controls. FMEA Asset 1: settings modified Sev=6 Prob=6 Det=3 RPN=108. Fallback: second RADAR available." ;
    cdm:hasDeviationType cdm:WRONG .

# — VDR failure modes
ll1:DevVDRDataModified a cdm:Deviation ;
    warrant:hasName "VDR Data Modified or Erased" ;
    warrant:hasDescription "Voyage record data erased or overwritten; accident investigation evidence destroyed. FMEA Asset 11: data modified/erased Sev=6 Prob=6 Det=5 RPN=180 — highest RPN in navigation OT." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:DevVDRDataNotStored a cdm:Deviation ;
    warrant:hasName "VDR Data Not Stored" ;
    warrant:hasDescription "VDR fails to record incoming data streams. FMEA Asset 11: data not stored Sev=7 Prob=5 Det=5 RPN=175. Cause: procedures not followed or system failure." ;
    cdm:hasDeviationType cdm:NO .

# — AMS failure modes (electrical OT — highest RPN overall)
ll1:DevAMSDataCorrupted a cdm:Deviation ;
    warrant:hasName "AMS Monitoring Data Corrupted" ;
    warrant:hasDescription "Engine room and vessel alarm data changed or falsified; crew unable to monitor engine room state. FMEA Asset 18 (Electrical OT): change data Sev=7 Prob=9 Det=5 RPN=315 — highest RPN in entire FMEA. Responsibility: Chief Engineer." ;
    cdm:hasDeviationType cdm:WRONG .

# — Communication failure modes
ll1:DevVHFSettingsModified a cdm:Deviation ;
    warrant:hasName "VHF Communication Disrupted (Settings Modified)" ;
    warrant:hasDescription "VHF settings modified, disrupting short-range comms and potentially disabling DSC distress functionality. FMEA Asset 12: Sev=6 Prob=5 Det=3 RPN=90." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:DevSatCommUnavailable a cdm:Deviation ;
    warrant:hasName "Satellite Communication Link Unavailable" ;
    warrant:hasDescription "Inmarsat GX or FBB settings modified or Linux system compromised via Communications PC LAN boundary. Both systems run Linux with no antivirus/firewall. FMEA Asset 16/17: RPN=72 each." ;
    cdm:hasDeviationType cdm:UNAVAILABLE .

# — Detection event ↔ deviation
ll1:AISSpoofingDetectionEvent   obs:detectionEventDetects ll1:DevSpoofedAIS .
ll1:GPSJammingDetectionEvent    obs:detectionEventDetects ll1:DevGPSJammed .
ll1:ECDISSettingsModifiedEvent  obs:detectionEventDetects ll1:DevECDISSettingsModified .
ll1:VDRDataTamperEvent          obs:detectionEventDetects ll1:DevVDRDataModified .
ll1:AMSDataCorruptionEvent      obs:detectionEventDetects ll1:DevAMSDataCorrupted .
ll1:GyroHeadingDivergenceEvent  obs:detectionEventDetects ll1:DevGyroSettingsModified .
ll1:GPSSpoofingDetectionEvent     obs:detectionEventDetects ll1:DevGPSSpoofed .
ll1:ECDISSensorFeedLossEvent      obs:detectionEventDetects ll1:DevECDISInterfaceModified .
ll1:SpeedlogInconsistencyEvent    obs:detectionEventDetects ll1:DevSpeedlogModified .
ll1:GyroFeedLossEvent             obs:detectionEventDetects ll1:DevGyroInterfaceDisconnected .
ll1:RadarConfigurationChangeEvent obs:detectionEventDetects ll1:DevRADARSettingsModified .
ll1:VDRRecordingStoppedEvent      obs:detectionEventDetects ll1:DevVDRDataNotStored .
ll1:VHFConfigurationChangeEvent   obs:detectionEventDetects ll1:DevVHFSettingsModified .
ll1:SatCommLinkLossEvent          obs:detectionEventDetects ll1:DevSatCommUnavailable .


# ═══════════════════════════════════════════════════════════════════════════════
# STPA — CONTROL STRUCTURE, PROCESS MODEL FLAW, UCA
# (Primary AIS spoofing scenario — LL1 cyber-attack focus)
# ═══════════════════════════════════════════════════════════════════════════════

ll1:BridgeControlStructure a cdm:ControlStructure ;
    warrant:hasName "Bridge Navigation Control Structure" ;
    warrant:hasDescription "Controller: Navigation Officer. Controlled process: Vessel course and speed. Feedback: ECDIS position, RADAR targets, GPS. Control actions: course/speed commands to Autopilot." .

ll1:NavigationOfficerController a cdm:Controller ;
    warrant:hasName "Navigation Officer (STPA Controller)" .

ll1:VesselCourseControlledProcess a cdm:ControlledProcess ;
    warrant:hasName "Vessel Course and Speed (Controlled Process)" .

ll1:ECDISFeedback a cdm:Feedback ;
    warrant:hasName "ECDIS Position and Chart Feedback" ;
    warrant:hasDescription "Navigation officer receives vessel position from ECDIS, which integrates GPS, AIS traffic, and RADAR overlay." .

ll1:CourseAlterationControlAction a davom:ControlAction ;
    warrant:hasName "Course Alteration Command" ;
    warrant:hasDescription "Course or speed order issued by the navigation officer to the autopilot or the helm on the basis of the ECDIS and radar picture." .

ll1:NavigationOfficerRole davom:authorizes ll1:CourseAlterationControlAction .
ll1:NavigationOfficerController cdm:issues ll1:CourseAlterationControlAction .
ll1:CourseAlterationControlAction cdm:actsOn ll1:VesselCourseControlledProcess .
ll1:VesselCourseControlledProcess cdm:providesFeedback ll1:ECDISFeedback .
ll1:ECDISFeedback cdm:updates ll1:NavigationOfficerProcessModel .

ll1:NavigationOfficerProcessModel a cdm:ProcessModel ;
    warrant:hasName "Navigation Officer Process Model" ;
    warrant:hasDescription "The officer's working picture of where the vessel is and what the surrounding traffic is doing, built from ECDIS own-ship position, the radar picture and the AIS target overlay." .

ll1:WrongPositionProcessModelFlaw a cdm:ProcessModelFlaw ;
    warrant:hasName "Wrong Own-Ship Position in Officer Process Model" ;
    warrant:hasDescription "The officer's ECDIS shows an incorrect own-ship position, so the officer believes the vessel is on a safe track while it is standing into danger. Reached by GNSS spoofing, by an ECDIS compromise that alters the display parameters or chart datum, or by loss of the sensor feeds that ECDIS integrates. Not reachable from AIS spoofing." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:WrongTrafficPictureProcessModelFlaw a cdm:ProcessModelFlaw ;
    warrant:hasName "Wrong Traffic Picture in Officer Process Model" ;
    warrant:hasDescription "The officer's AIS overlay shows contacts that do not exist, are displaced from their true position, or are missing. Own-ship position remains correct. The divergence between an AIS contact and the radar return for the same target is what makes this detectable, and is what the IDS cross-check monitors." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:WrongCollisionAvoidanceUCA a cdm:UnsafeControlAction ;
    warrant:hasName "Wrong or Unnecessary Collision-Avoidance Manoeuvre" ;
    warrant:hasDescription "The officer alters course or speed to give way to a phantom or displaced AIS contact, or fails to give way to a real contact that the spoofed overlay has suppressed. STPA: control action provided when not required, or not provided when required, because the process model of the traffic situation is wrong. In confined or heavily trafficked water the avoiding action can itself set the vessel toward a hazard or into conflict with a genuine target." .

ll1:WrongCourseAlterationUCA a cdm:UnsafeControlAction ;
    warrant:hasName "Wrong Course Alteration (Based on Spoofed Position)" ;
    warrant:hasDescription "Navigation officer issues course alteration command based on false ECDIS position, manoeuvring vessel toward shallow water, reef, or TSS zone. STPA: control action wrong — wrong direction/amount given spoofed process model." .

# Two distinct attack paths that the 0.9 version of this file conflated.
# Own-ship position error (GNSS spoofing, ECDIS compromise, loss of the
# integrated sensor feeds) leads to a wrong course alteration. Target picture
# error (AIS spoofing) leads to a wrong collision-avoidance manoeuvre. Both
# can put the vessel into a hazardous area, by different mechanisms and with
# different detections.
ll1:DevGPSSpoofed             cdm:mayCause ll1:WrongPositionProcessModelFlaw .
ll1:DevECDISSettingsModified  cdm:mayCause ll1:WrongPositionProcessModelFlaw .
ll1:DevECDISInterfaceModified cdm:mayCause ll1:WrongPositionProcessModelFlaw .
ll1:WrongPositionProcessModelFlaw cdm:mayCause ll1:WrongCourseAlterationUCA .

ll1:DevSpoofedAIS cdm:mayCause ll1:WrongTrafficPictureProcessModelFlaw .
ll1:WrongTrafficPictureProcessModelFlaw cdm:mayCause ll1:WrongCollisionAvoidanceUCA .
ll1:WrongCollisionAvoidanceUCA cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:WrongCollisionAvoidanceUCA assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .


# ═══════════════════════════════════════════════════════════════════════════════
# CYBER-ATTACK SCENARIO
# ═══════════════════════════════════════════════════════════════════════════════

ll1:AISECDISSpoofingScenario a scen:CyberattackScenario ;
    warrant:hasName "AIS-ECDIS Spoofing Cyber-Attack Scenario (LL1)" ;
    warrant:hasDescription "Adversary injects counterfeit AIS messages over the unauthenticated VHF AIS channels (87B/88B). Phantom and displaced contacts appear in the ECDIS AIS overlay; own-ship position, which ECDIS takes from the GNSS receiver, is unaffected. The officer manoeuvres to avoid a contact that is not there and stands the vessel into a hazardous area. Where the adversary also spoofs GNSS, the own-ship position is falsified as well and the officer instead makes a wrong course alteration against a correct-looking chart. Concurrent VDR data erasure conceals the attack timeline in either variant." .

ll1:AISECDISSpoofingScenario scen:hasTrigger ll1:DevSpoofedAIS .
ll1:AISECDISSpoofingScenario scen:hasTrigger ll1:DevVDRDataModified .


# ═══════════════════════════════════════════════════════════════════════════════
# HAZARDS
# ═══════════════════════════════════════════════════════════════════════════════

ll1:HazHazardousAreaApproach a cdm:Hazard ;
    warrant:hasName "Hazardous Area Approach" ;
    warrant:hasDescription "Vessel manoeuvres toward shallow water, reef, traffic separation zone, or collision course with another vessel based on false position or heading data." .

ll1:HazLossOfNavigationPicture a cdm:Hazard ;
    warrant:hasName "Loss of Navigation Picture" ;
    warrant:hasDescription "Simultaneous failure or compromise of GPS, Gyrocompass, and/or ECDIS leaves officer with no reliable position or heading reference." .

ll1:HazLossOfVDREvidence a cdm:Hazard ;
    warrant:hasName "Loss of Voyage Data Record Evidence" ;
    warrant:hasDescription "VDR data erased or not stored — post-incident investigation, P&I Club claims, and flag-state requirements cannot be met." .

ll1:HazLossOfDistressComms a cdm:Hazard ;
    warrant:hasName "Loss of Distress Communication Capability" ;
    warrant:hasDescription "VHF DSC, MF/HF, and/or Inmarsat-C unavailable or misconfigured — vessel cannot transmit MAYDAY or receive SAR coordination." .

ll1:HazUnmonitoredEngineRoom a cdm:Hazard ;
    warrant:hasName "Unmonitored Engine Room State" ;
    warrant:hasDescription "AMS data corrupted — crew cannot detect engine room alarms, fire, flooding, or mechanical failure. Highest-probability hazard in FMEA (Prob=9)." .

# — Deviation → Hazard
ll1:DevSpoofedAIS             cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevGPSJammed              cdm:mayCause ll1:HazLossOfNavigationPicture .
ll1:DevGPSSpoofed             cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevECDISSettingsModified  cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevECDISInterfaceModified cdm:mayCause ll1:HazLossOfNavigationPicture .
ll1:DevGyroSettingsModified   cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevGyroInterfaceDisconnected cdm:mayCause ll1:HazLossOfNavigationPicture .
ll1:DevSpeedlogModified       cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevRADARSettingsModified  cdm:mayCause ll1:HazLossOfNavigationPicture .
ll1:WrongCourseAlterationUCA  cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevVDRDataModified        cdm:mayCause ll1:HazLossOfVDREvidence .
ll1:DevVDRDataNotStored       cdm:mayCause ll1:HazLossOfVDREvidence .
ll1:DevVHFSettingsModified    cdm:mayCause ll1:HazLossOfDistressComms .
ll1:DevSatCommUnavailable     cdm:mayCause ll1:HazLossOfDistressComms .
ll1:DevAMSDataCorrupted       cdm:mayCause ll1:HazUnmonitoredEngineRoom .


# ═══════════════════════════════════════════════════════════════════════════════
# RISKS
# (FMEA scores in description — FLAG-04: no typed cdm:hasRPN property)
# ═══════════════════════════════════════════════════════════════════════════════

ll1:RiskCollisionGrounding a cdm:Risk ;
    warrant:hasName "Collision or Grounding Risk" ;
    warrant:hasDescription "FMEA basis: ECDIS/GPS/RADAR settings modified or interface manipulated, leading to compromised safety of navigation. ECDIS RPN=108 (Sev=6,Prob=6,Det=3)." ;
    cdm:hasLikelihood    "0.50"^^xsd:decimal ;
    cdm:hasImpact        "0.95"^^xsd:decimal ;
    cdm:hasSeverity      "0.90"^^xsd:decimal ;
    cdm:hasRiskLevel     "Critical" ;
    cdm:hasAcceptability "Unacceptable" .

ll1:RiskNavigationPictureLoss a cdm:Risk ;
    warrant:hasName "Loss of Navigation Picture Risk" ;
    warrant:hasDescription "FMEA basis: GPS jamming (RPN=63) + gyrocompass interface failure (RPN=63) occurring simultaneously. Dead reckoning fallback for limited time only." ;
    cdm:hasLikelihood    "0.25"^^xsd:decimal ;
    cdm:hasImpact        "0.85"^^xsd:decimal ;
    cdm:hasSeverity      "0.80"^^xsd:decimal ;
    cdm:hasRiskLevel     "High" ;
    cdm:hasAcceptability "Unacceptable" .

ll1:RiskVDREvidenceLoss a cdm:Risk ;
    warrant:hasName "Voyage Record Evidence Loss Risk" ;
    warrant:hasDescription "FMEA basis: VDR data modified/erased RPN=180 (Sev=6,Prob=6,Det=5) — highest RPN in navigation OT. Consequences: P&I Club liability, flag-state implications, inability to reconstruct accident." ;
    cdm:hasLikelihood    "0.40"^^xsd:decimal ;
    cdm:hasImpact        "0.70"^^xsd:decimal ;
    cdm:hasSeverity      "0.65"^^xsd:decimal ;
    cdm:hasRiskLevel     "High" ;
    cdm:hasAcceptability "ALARP" .

ll1:RiskDistressCommsLoss a cdm:Risk ;
    warrant:hasName "Loss of Distress Communication Risk" ;
    warrant:hasDescription "FMEA basis: VHF settings modified RPN=90; Inmarsat-C interface modified RPN=72. Combined loss of VHF + Inmarsat-C leaves vessel unable to transmit MAYDAY." ;
    cdm:hasLikelihood    "0.20"^^xsd:decimal ;
    cdm:hasImpact        "0.90"^^xsd:decimal ;
    cdm:hasSeverity      "0.85"^^xsd:decimal ;
    cdm:hasRiskLevel     "Critical" ;
    cdm:hasAcceptability "Unacceptable" .

ll1:RiskEngineRoomUnmonitored a cdm:Risk ;
    warrant:hasName "Engine Room Unmonitored Risk" ;
    warrant:hasDescription "FMEA basis: AMS data change RPN=315 (Sev=7,Prob=9,Det=5) — highest RPN in entire FMEA. Crew cannot detect engine/fire/flooding events. Chief Engineer responsible." ;
    cdm:hasLikelihood    "0.60"^^xsd:decimal ;
    cdm:hasImpact        "0.85"^^xsd:decimal ;
    cdm:hasSeverity      "0.80"^^xsd:decimal ;
    cdm:hasRiskLevel     "Critical" ;
    cdm:hasAcceptability "Unacceptable" .

ll1:HazHazardousAreaApproach   cdm:isEvaluatedAs ll1:RiskCollisionGrounding .
ll1:HazLossOfNavigationPicture cdm:isEvaluatedAs ll1:RiskNavigationPictureLoss .
ll1:HazLossOfVDREvidence       cdm:isEvaluatedAs ll1:RiskVDREvidenceLoss .
ll1:HazLossOfDistressComms     cdm:isEvaluatedAs ll1:RiskDistressCommsLoss .
ll1:HazUnmonitoredEngineRoom   cdm:isEvaluatedAs ll1:RiskEngineRoomUnmonitored .


# ═══════════════════════════════════════════════════════════════════════════════
# HAZARD CLASSES AND THE IMPACT TRIPLE
#
# A hazard class governs which dependency types a class of risk can propagate
# over. Impact is assessed separately against safety, environmental and
# financial consequence; the governing value already recorded in cdm:hasImpact
# is the most severe of the three.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:HazHazardousAreaApproach   cdm:hasHazardClass cdm:CYBER_THREAT , cdm:DATA_LOSS .
ll1:HazLossOfNavigationPicture cdm:hasHazardClass cdm:DATA_LOSS .
ll1:HazLossOfVDREvidence       cdm:hasHazardClass cdm:CYBER_THREAT .
ll1:HazLossOfDistressComms     cdm:hasHazardClass cdm:CYBER_THREAT , cdm:DATA_LOSS .
ll1:HazUnmonitoredEngineRoom   cdm:hasHazardClass cdm:CYBER_THREAT .

ll1:RiskCollisionGrounding
    cdm:hasHazardClass         cdm:CYBER_THREAT ;
    cdm:hasSafetyImpact        "0.95"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.70"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.85"^^xsd:decimal .

ll1:RiskNavigationPictureLoss
    cdm:hasHazardClass         cdm:DATA_LOSS ;
    cdm:hasSafetyImpact        "0.85"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.55"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.60"^^xsd:decimal .

ll1:RiskVDREvidenceLoss
    cdm:hasHazardClass         cdm:CYBER_THREAT ;
    cdm:hasSafetyImpact        "0.20"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.10"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.70"^^xsd:decimal .

ll1:RiskDistressCommsLoss
    cdm:hasHazardClass         cdm:CYBER_THREAT , cdm:DATA_LOSS ;
    cdm:hasSafetyImpact        "0.90"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.40"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.50"^^xsd:decimal .

ll1:RiskEngineRoomUnmonitored
    cdm:hasHazardClass         cdm:CYBER_THREAT ;
    cdm:hasSafetyImpact        "0.85"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.75"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.70"^^xsd:decimal .


# ═══════════════════════════════════════════════════════════════════════════════
# OPERATIONAL CONTEXT
#
# The 0.9 version of this file carried no context at all, so its hazards and
# risks were stated as if they applied uniformly. For an ocean-going
# containership the navigation hazards below are landfall, coastal and traffic
# separation hazards rather than mid-ocean ones, and GNSS interference is
# concentrated in known areas rather than spread along a route.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:CoastalApproachSegment a warrant:VoyageSegment ;
    warrant:hasName "Coastal approach and traffic separation scheme transit" ;
    warrant:hasDescription "The phase in which the navigation hazards modelled here are live: charted dangers within manoeuvring distance, dense traffic, and a requirement to keep to a scheme. In the open-ocean phase the same deviations are far less consequential because sea room and time to act are measured in hours." .

ll1:HighTrafficDensityCondition a warrant:TrafficCondition ;
    warrant:hasName "High traffic density" ;
    warrant:hasDescription "Traffic density at which an avoidance manoeuvre must be taken on the AIS and radar picture rather than on visual assessment alone, which is what makes a falsified target picture consequential." .

ll1:GNSSInterferenceAreaCondition a warrant:EnvironmentalCondition ;
    warrant:hasName "Known GNSS interference area" ;
    warrant:hasDescription "A sea area with reported jamming or spoofing activity. Interference is regionally concentrated in practice, so the likelihood attached to the GNSS threat scenarios is a function of where the vessel is, not a constant of the equipment." .

ll1:HazHazardousAreaApproach   cdm:hasOperationalContext ll1:CoastalApproachSegment .
ll1:HazLossOfNavigationPicture cdm:hasOperationalContext ll1:CoastalApproachSegment .
ll1:HazLossOfDistressComms     cdm:hasOperationalContext ll1:CoastalApproachSegment .

ll1:HazHazardousAreaApproach cdm:isCriticalUnder ll1:HighTrafficDensityCondition , ll1:GNSSInterferenceAreaCondition .
ll1:HazLossOfNavigationPicture cdm:isCriticalUnder ll1:GNSSInterferenceAreaCondition .

ll1:GNSSInterferenceAreaCondition cdm:modifiesLikelihoodOf ll1:RiskCollisionGrounding , ll1:RiskNavigationPictureLoss .
ll1:HighTrafficDensityCondition   cdm:modifiesImpactOf     ll1:RiskCollisionGrounding .

ll1:RiskCollisionGrounding    cdm:hasEnvironmentalCondition ll1:HighTrafficDensityCondition , ll1:GNSSInterferenceAreaCondition .
ll1:RiskNavigationPictureLoss cdm:hasEnvironmentalCondition ll1:GNSSInterferenceAreaCondition .

# The bridge team conns the vessel directly; there is no remote operation on a
# deep-sea containership, and the operator-authority model reflects that.
ll1:CourseAlterationControlAction cdm:isPerformedUnder warrant:ManualOperationMode .
ll1:DevSpoofedAIS   cdm:wasObservedUnder warrant:ManualOperationMode .
ll1:DevGPSSpoofed   cdm:wasObservedUnder warrant:ManualOperationMode .


# ═══════════════════════════════════════════════════════════════════════════════
# ASSET ROLES AND CRITICAL NODES
#
# Primary assets are the information and services of value; supporting assets
# are the equipment and roles that store, process, transmit or execute them.
# Every primary asset should be reachable from at least one supporting asset,
# which is the graph-completeness check of the cybersecurity methodology.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:NavigationFunction      davom:hasAssetRole davom:PRIMARY_ASSET ; davom:isCriticalNode true .
ll1:CommunicationFunction   davom:hasAssetRole davom:PRIMARY_ASSET ; davom:isCriticalNode true .
ll1:VoyageRecordingFunction davom:hasAssetRole davom:PRIMARY_ASSET ; davom:isCriticalNode false .
ll1:ElectricalAlarmFunction davom:hasAssetRole davom:PRIMARY_ASSET ; davom:isCriticalNode true .

ll1:GPS_1           davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction ; davom:isCriticalNode true .
ll1:GPS_2           davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:Gyrocompass     davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction ; davom:isCriticalNode true .
ll1:ECDIS_1         davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction ; davom:isCriticalNode true .
ll1:ECDIS_2         davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:RadarXBand      davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction ; davom:isCriticalNode true .
ll1:RadarSBand      davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:AIS_Transponder davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:Autopilot       davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:Speedlog        davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:VDR             davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:VoyageRecordingFunction ; davom:isCriticalNode true .
ll1:VHF_1           davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:CommunicationFunction ; davom:isCriticalNode true .
ll1:InmarsatC_1     davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:CommunicationFunction .
ll1:InmarsatGX      davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:CommunicationFunction .
ll1:CommunicationsPC davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:CommunicationFunction .
ll1:BNWAS           davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:ElectricalAlarmFunction .

ll1:NavigationOfficerRole davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:ChiefEngineerRole     davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:ElectricalAlarmFunction .
ll1:ElectricalDeptRole    davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:ElectricalAlarmFunction .

ll1:AlarmMonitoringSystem davom:isCriticalNode true .


# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY ZONES AND CONDUITS (IEC 62443-3-2)
#
# The 0.9 version described the IT/OT boundary in prose. Partitioning it makes
# the reach of a compromise a typed graph query: a cyber effect crosses a
# conduit and travels over data, control and cyber dependencies, and does not
# travel over physical ones.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:Zone_BridgeNavigationOT a davom:SecurityZone ;
    warrant:hasName "Bridge Navigation OT Zone" ;
    warrant:hasDescription "Radars, ECDIS, GPS, gyrocompass, satellite compass, autopilot, speed log, echo sounder, anemometer, AIS, BNWAS and the VDR, connected by the IEC 61162 serial buses and the radar-ECDIS LAN. Access restricted to service engineers with authorisation codes." .

ll1:Zone_ElectricalAutomationOT a davom:SecurityZone ;
    warrant:hasName "Electrical and Automation OT Zone" ;
    warrant:hasDescription "Alarm monitoring system, fire detection, general alarm and public address, navigation light panel. Carries the highest-RPN entry in the FMEA." .

ll1:Zone_ShipBusinessIT a davom:SecurityZone ;
    warrant:hasName "Ship Business IT Zone" ;
    warrant:hasDescription "The Communications PC and the satellite terminals it is connected to over the LAN. The principal ingress path: shore internet traffic reaches this zone, and both satellite terminals run without endpoint protection per the equipment inventory." .

ll1:Zone_ShoreExternal a davom:SecurityZone ;
    warrant:hasName "Shore and External Zone" ;
    warrant:hasDescription "Everything outside the vessel: shore offices, service providers, and the open radio environment in which AIS and GNSS signals are received without authentication." .

ll1:RadarXBand davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:RadarSBand davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:ECDIS_1 davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:ECDIS_2 davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:GPS_1 davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:GPS_2 davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Gyrocompass davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:SatelliteCompass davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Autopilot davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Speedlog davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Echosounder davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Anemometer davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:AIS_Transponder davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:BNWAS davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:VDR davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:CourseRecorder davom:belongsToZone ll1:Zone_BridgeNavigationOT .

ll1:AlarmMonitoringSystem davom:belongsToZone ll1:Zone_ElectricalAutomationOT .
ll1:FireDetectionSystem davom:belongsToZone ll1:Zone_ElectricalAutomationOT .
ll1:GeneralAlarmPA davom:belongsToZone ll1:Zone_ElectricalAutomationOT .
ll1:NavLightPanel davom:belongsToZone ll1:Zone_ElectricalAutomationOT .

ll1:CommunicationsPC davom:belongsToZone ll1:Zone_ShipBusinessIT .
ll1:InmarsatGX davom:belongsToZone ll1:Zone_ShipBusinessIT .
ll1:InmarsatFBB davom:belongsToZone ll1:Zone_ShipBusinessIT .

# The satellite LAN is the conduit between ship IT and the shore; the BNWAS to
# AMS serial line is the conduit between the two OT zones.
ll1:Link_SatComm_LAN a davom:Conduit ;
    davom:connectsZone ll1:Zone_ShipBusinessIT , ll1:Zone_ShoreExternal .

ll1:Link_BNWAS_AMS a davom:Conduit ;
    davom:connectsZone ll1:Zone_BridgeNavigationOT , ll1:Zone_ElectricalAutomationOT .


# ═══════════════════════════════════════════════════════════════════════════════
# TYPED DEPENDENCIES
#
# The bridge network was described in the link descriptions but never modelled
# as dependencies, so nothing could propagate. Direction convention: source is
# the upstream provider, target the downstream consumer.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:Dep_GPS_to_ECDIS a davom:DataDependency ;
    warrant:hasName "GPS position → ECDIS own-ship position" ;
    davom:dependencySource ll1:GPS_1 ; davom:dependencyTarget ll1:ECDIS_1 ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.6"^^xsd:decimal ;
    davom:hasCriticality "Critical" ; davom:hasRedundancyLevel 1 ;
    warrant:hasDescription "The path that makes GNSS spoofing an own-ship position error. AIS has no equivalent path into own-ship position." .

ll1:Dep_GPS_to_Radar a davom:DataDependency ;
    warrant:hasName "GPS position → radar" ;
    davom:dependencySource ll1:GPS_1 ; davom:dependencyTarget ll1:RadarXBand ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.4"^^xsd:decimal ; davom:hasCriticality "High" .

ll1:Dep_Gyro_to_ECDIS a davom:DataDependency ;
    warrant:hasName "Gyrocompass heading → ECDIS" ;
    davom:dependencySource ll1:Gyrocompass ; davom:dependencyTarget ll1:ECDIS_1 ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.5"^^xsd:decimal ; davom:hasCriticality "Critical" .

ll1:Dep_Gyro_to_Autopilot a davom:ControlDependency ;
    warrant:hasName "Gyrocompass heading → autopilot" ;
    davom:dependencySource ll1:Gyrocompass ; davom:dependencyTarget ll1:Autopilot ;
    davom:hasDependencyType davom:CONTROL , davom:DATA ;
    davom:hasDependencyWeight "0.7"^^xsd:decimal ; davom:hasCriticality "Critical" ;
    warrant:hasDescription "Loss or falsification of heading removes automatic steering; fallback is local or manual steering." .

ll1:Dep_AIS_to_ECDIS a davom:DataDependency ;
    warrant:hasName "AIS target data → ECDIS overlay" ;
    davom:dependencySource ll1:AIS_Transponder ; davom:dependencyTarget ll1:ECDIS_1 ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.3"^^xsd:decimal ; davom:hasCriticality "High" ;
    warrant:hasDescription "Carries the traffic picture, not own-ship position. This is the dependency that AIS spoofing acts over." .

ll1:Dep_Radar_to_ECDIS a davom:DataDependency ;
    warrant:hasName "Radar targets → ECDIS overlay (LAN)" ;
    davom:dependencySource ll1:RadarXBand ; davom:dependencyTarget ll1:ECDIS_1 ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.4"^^xsd:decimal ; davom:hasCriticality "High" ;
    warrant:hasDescription "The independent leg of the target cross-check: a contact reported by AIS with no radar return is the spoofing signature." .

ll1:Dep_Sensors_to_VDR a davom:DataDependency ;
    warrant:hasName "Bridge sensor feeds → VDR" ;
    davom:dependencySource ll1:GPS_1 ; davom:dependencyTarget ll1:VDR ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.3"^^xsd:decimal ; davom:hasCriticality "Medium" .

ll1:Dep_CommsPC_to_SatTerminals a davom:CyberDependency ;
    warrant:hasName "Communications PC ↔ satellite terminals (IT/OT ingress)" ;
    davom:dependencySource ll1:CommunicationsPC ; davom:dependencyTarget ll1:InmarsatGX ;
    davom:hasDependencyType davom:CYBER , davom:DATA ;
    davom:hasDependencyWeight "0.6"^^xsd:decimal ; davom:hasCriticality "High" ;
    davom:isBidirectional true ;
    warrant:hasDescription "Bidirectional because the conduit permits reverse access: shore traffic reaches the terminals and the terminals reach the PC. Neither terminal runs endpoint protection per the equipment inventory." .

ll1:Dep_BNWAS_to_AMS a davom:DataDependency ;
    warrant:hasName "BNWAS watch alarm status → AMS" ;
    davom:dependencySource ll1:BNWAS ; davom:dependencyTarget ll1:AlarmMonitoringSystem ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.4"^^xsd:decimal ; davom:hasCriticality "High" .


