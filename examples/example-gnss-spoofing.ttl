# Threshold sets (normal minimum / critical / failed / unsafe):
# safety 0.70/0.40/0.20/0.10, cybersecurity 0.70/0.45/0.25/0.10,
# availability 0.75/0.35/0.15/0.05, reliability 0.60/0.30/0.15/0.05.
# State: ≥ normal minimum Normal; ≥ critical Degraded; ≥ failed Critical;
# ≥ unsafe Failed; below unsafe Unsafe.
ll1:T_NavSafety a di:DIThreshold ; di:thresholdAppliesToAttribute ll1:NavSafetyAttribute ; di:thresholdAppliesToNode ll1:NavigationFunction ;
    di:hasNormalMinimum "0.70"^^xsd:decimal ; di:hasCriticalThreshold "0.40"^^xsd:decimal ; di:hasFailedThreshold "0.20"^^xsd:decimal ; di:hasUnsafeThreshold "0.10"^^xsd:decimal ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .
