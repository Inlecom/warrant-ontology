# ── Typed risk propagation (CYBER_THREAT over DATA and CYBER dependencies) ─
# Primary edge: the spoofed position data product into the navigation function.
# Background edge: the IT to OT lateral path from the communication function.
# The background edge is structural and contributes 0.03 to R_nav; it is not
# part of the GNSS attack chain, which arrives over radio.

ll1:Dep_CommsIT_to_BridgeNav a davom:CyberDependency ;
    warrant:hasName "Ship IT zone → bridge navigation OT (lateral path)" ;
    davom:dependencySource ll1:CommunicationFunction ; davom:dependencyTarget ll1:NavigationFunction ;
    davom:hasDependencyType davom:CYBER ;
    davom:hasDependencyWeight "0.6"^^xsd:decimal ;
    davom:hasCriticality "High" ; davom:isBidirectional false .

ll1:CyberPropagationParameter a di:RiskPropagationParameter ;
    warrant:hasName "Propagation parameters — CYBER_THREAT" ;
    di:forHazardClass cdm:CYBER_THREAT ;
    di:hasDampingFactor "0.50"^^xsd:decimal ;
    di:hasConvergenceTolerance "0.001"^^xsd:decimal ;
    di:configurationAppliesTo ll1:ContainerVessel_LL1 ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .

ll1:PositionDataCyberRisk a di:PropagatedRisk ;
    warrant:hasName "Propagated CYBER_THREAT risk at the own-ship position data" ;
    warrant:hasDescription "Local risk of the realised GNSS spoofing threat on the position data product; no inbound edge." ;
    di:forHazardClass cdm:CYBER_THREAT ;
    di:hasLocalRiskValue "0.60"^^xsd:decimal ; di:hasPropagatedRiskValue "0.60"^^xsd:decimal ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ; di:calculatedAt "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:CommCyberRisk a di:PropagatedRisk ;
    warrant:hasName "Propagated CYBER_THREAT risk at the communication function" ;
    di:forHazardClass cdm:CYBER_THREAT ;
    di:hasLocalRiskValue "0.10"^^xsd:decimal ; di:hasPropagatedRiskValue "0.10"^^xsd:decimal ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ; di:calculatedAt "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:NavDataLossAndCyberRisk a di:PropagatedRisk ;
    warrant:hasName "Propagated CYBER_THREAT risk at the navigation function" ;
    warrant:hasDescription "Local term 0.09 on the node itself, plus 0.50·0.60·0.60 = 0.18 from the spoofed position data and 0.50·0.60·0.10 = 0.03 over the IT to OT path." ;
    di:forHazardClass cdm:CYBER_THREAT ;
    di:hasLocalRiskValue "0.09"^^xsd:decimal ; di:hasPropagatedRiskValue "0.30"^^xsd:decimal ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ; di:calculatedAt "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:VDRCyberRisk a di:PropagatedRisk ;
    warrant:hasName "Propagated CYBER_THREAT risk at the voyage recording function" ;
    di:forHazardClass cdm:CYBER_THREAT ;
    di:hasLocalRiskValue "0.10"^^xsd:decimal ; di:hasPropagatedRiskValue "0.10"^^xsd:decimal ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ; di:calculatedAt "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:ElectricalCyberRisk a di:PropagatedRisk ;
    warrant:hasName "Propagated CYBER_THREAT risk at the electrical and alarm function" ;
    di:forHazardClass cdm:CYBER_THREAT ;
    di:hasLocalRiskValue "0.10"^^xsd:decimal ; di:hasPropagatedRiskValue "0.10"^^xsd:decimal ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ; di:calculatedAt "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:PositionToNavPropEdge a di:RiskPropagationEdge ;
    di:propagationSource ll1:DI_OwnShipPosition ; di:propagationTarget ll1:DI_Navigation ;
    di:forHazardClass cdm:CYBER_THREAT ;
    di:mirrorsDependency ll1:Dep_PositionData_to_NavigationFunction ;
    di:hasRiskPropagationWeight "0.6"^^xsd:decimal .

ll1:CommToNavPropEdge a di:RiskPropagationEdge ;
    di:propagationSource ll1:DI_Communication ; di:propagationTarget ll1:DI_Navigation ;
    di:forHazardClass cdm:CYBER_THREAT ;
    di:mirrorsDependency ll1:Dep_CommsIT_to_BridgeNav ;
    di:hasRiskPropagationWeight "0.6"^^xsd:decimal .

# ── Hierarchical aggregation weights ──────────────────────────────────────

ll1:GammaNav  a di:DIWeight ; di:weightParent ll1:DI_LL1_Composite ; di:weightChild ll1:DI_Navigation ;      di:hasAggregationWeightValue "0.4"^^xsd:decimal ; warrant:appliesUnder warrant:ManualOperationMode ; warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .
ll1:GammaVDR  a di:DIWeight ; di:weightParent ll1:DI_LL1_Composite ; di:weightChild ll1:DI_VDR ;             di:hasAggregationWeightValue "0.1"^^xsd:decimal ; warrant:appliesUnder warrant:ManualOperationMode ; warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .
ll1:GammaComm a di:DIWeight ; di:weightParent ll1:DI_LL1_Composite ; di:weightChild ll1:DI_Communication ;   di:hasAggregationWeightValue "0.2"^^xsd:decimal ; warrant:appliesUnder warrant:ManualOperationMode ; warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .
ll1:GammaElec a di:DIWeight ; di:weightParent ll1:DI_LL1_Composite ; di:weightChild ll1:DI_ElectricalAlarm ; di:hasAggregationWeightValue "0.3"^^xsd:decimal ; warrant:appliesUnder warrant:ManualOperationMode ; warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .

# ── Supervision configuration, DI update audit and resilience triggers ────

ll1:LL1_SupervisionConfig a di:SupervisionConfiguration ;
    warrant:hasName "LL1 supervision configuration" ;
    di:hasTrendWindow "PT6H"^^xsd:duration ;
    di:hasTrendSlopeThreshold "0.05"^^xsd:decimal ;
    di:hasPredictionHorizon "PT2H"^^xsd:duration ;
    di:hasManagementFloor "0.55"^^xsd:decimal ;
    di:configurationAppliesTo ll1:ContainerVessel_LL1 ;
    warrant:appliesUnder warrant:ManualOperationMode ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .

ll1:NavDIUpdate_T1 a di:DIUpdateEvent ;
    di:updatesIndex ll1:DI_Navigation ;
    di:hasPreviousValue "0.74"^^xsd:decimal ; di:hasNewValue "0.20"^^xsd:decimal ;
    di:updateTriggeredBy ll1:GPSSpoofingDetectionEvent , ll1:SurroundingTrafficGNSSCorruptionEvent ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:performedBy ll1:LL1_DependabilitySupervisor ;
    di:calculatedAt "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:isRecordedIn ll1:LL1_LDC .

ll1:Trigger_NavCyberBreach a di:ResilienceTrigger ;
    warrant:hasName "Navigation information-integrity attribute below its Unsafe threshold" ;
    di:hasTriggerType di:ATTRIBUTE_BREACH ;
    di:triggeredAt "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:triggeredByAttributeValue ll1:V_NavCyber ;
    di:usesConfiguration ll1:LL1_SupervisionConfig ;
    di:raisedBy ll1:LL1_DependabilitySupervisor ;
    di:isRecordedIn ll1:LL1_LDC ;
    mit:matchesRule ll1:RuleGNSSSpoofing .

ll1:Trigger_PredictedFloorCrossing a di:ResilienceTrigger ;
    warrant:hasName "System DI forecast to cross the management floor within the prediction horizon" ;
    warrant:hasDescription "DI_sys is 0.56, just above the 0.55 floor, but the Digital Twin forecasts 0.50 within two hours if nothing is done: with the autopilot in track control on the spoofed position, the vessel keeps closing the traffic separation scheme boundary and the shoal." ;
    di:hasTriggerType di:PREDICTED_FLOOR_CROSSING ;
    di:triggeredAt "2026-06-01T09:46:00Z"^^xsd:dateTime ;
    di:triggeredByForecast ll1:SysDIForecast_Unmitigated ;
    di:usesConfiguration ll1:LL1_SupervisionConfig ;
    di:raisedBy ll1:LL1_DependabilitySupervisor ;
    di:isRecordedIn ll1:LL1_LDC ;
    mit:matchesRule ll1:RuleGNSSSpoofing .

# ── REDS: ranked alternatives, objective E[DI_sys|u] − 0.3·C − 0.2·V ──────
# Admissible only if the expected DI_sys is at or above the management floor.

ll1:LL1_DecisionConfig a mit:DecisionConfiguration ;
    warrant:hasName "LL1 REDS weights" ;
    mit:hasCostWeight "0.3"^^xsd:decimal ; mit:hasPenaltyWeight "0.2"^^xsd:decimal ;
    warrant:appliesUnder warrant:ManualOperationMode ; warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .

ll1:RevertToIndependentNavigationAction a mit:AdvisoryAction ;
    warrant:hasName "Revert to independent position fixing and radar-based collision avoidance" ;
    warrant:hasDescription "Advisory: treat GNSS-derived position as unreliable. Fix position by radar ranges and bearings to charted features, visual bearings and depth; run ECDIS No1 and No2 on dead reckoning with manual fixes; take the autopilot out of track control into heading control; mark AIS targets as unverified and take collision avoidance on radar range and bearing; call the Master; report the interference to VTS. The GNSS equipment stays on and monitored so that recovery of the signal can be recognised." ;
    mit:hasStrategyType mit:SAFE_DEGRADED_MODE ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL ;
    mit:requiresAuthorisationFrom ll1:NavigationOfficerRole ;
    mit:addresses ll1:NavigationFunction , ll1:OwnShipPositionData , ll1:Autopilot , ll1:SurroundingTrafficAISReports ;
    mit:implementsControl ll1:CTRL_RadarGPSCrossCheck , ll1:CTRL_PaperChartBackup ;
    mit:isTriggeredBy ll1:Trigger_NavCyberBreach .

ll1:SwitchToRedundantGNSSChainAction a mit:AdvisoryAction ;
    warrant:hasName "Switch to GPS No2 and ECDIS No2" ;
    warrant:hasDescription "Advisory: select GPS No2 as the position source and ECDIS No2 as the primary display. Cheap and fast, and useless against spoofing: GPS No2 receives the same counterfeit signal, and ECDIS No2 displays the same wrong position." ;
    mit:hasStrategyType mit:REDUNDANCY_ACTIVATION ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL ;
    mit:requiresAuthorisationFrom ll1:NavigationOfficerRole ;
    mit:addresses ll1:GPS_2 , ll1:ECDIS_2 .

ll1:ReduceSpeedIncreaseCPAAction a mit:AdvisoryAction ;
    warrant:hasName "Reduce speed and increase closest point of approach" ;
    warrant:hasDescription "Advisory: reduce to manoeuvring speed and open the passing distances, buying time for the picture to be resolved at the cost of schedule." ;
    mit:hasStrategyType mit:SAFE_DEGRADED_MODE ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL ;
    mit:requiresAuthorisationFrom ll1:NavigationOfficerRole ;
    mit:addresses ll1:NavigationFunction .

ll1:IsolateAISOverlayAction a mit:AdvisoryAction ;
    warrant:hasName "Suspend the AIS target overlay and navigate on radar" ;
    warrant:hasDescription "Secondary scenario (direct AIS spoofing). Advisory: stop displaying AIS targets on ECDIS and take collision avoidance on radar alone until the traffic picture can be trusted again. Removes counterfeit contacts rather than reasoning around them." ;
    mit:hasStrategyType mit:LOGICAL_ISOLATION ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL ;
    mit:requiresAuthorisationFrom ll1:NavigationOfficerRole ;
    mit:addresses ll1:NavigationFunction , ll1:Link_AIS_NavBus .

ll1:SysDIForecast_Unmitigated a di:DIForecast ;
    warrant:hasName "Forecast DI_sys — no response" ;
    warrant:hasDescription "DI_nav falls to 0.05 as the vessel stands into danger: 0.4·0.05 + 0.48 = 0.50." ;
    di:forecastsIndex ll1:DI_LL1_Composite ; di:hasForecastValue "0.50"^^xsd:decimal ;
    di:hasForecastHorizon "PT2H"^^xsd:duration ; di:forecastIssuedAt "2026-06-01T09:46:00Z"^^xsd:dateTime ;
    di:hasForecastConfidence "0.70"^^xsd:decimal ; di:forecastProducedBy ll1:ContainerVessel_DigitalTwin .

ll1:SysDIForecast_RevertIndependent a di:DIForecast ;
    warrant:hasName "Forecast DI_sys — revert to independent navigation" ;
    warrant:hasDescription "DI_nav recovers to 0.45: 0.4·0.45 + 0.48 = 0.66." ;
    di:forecastsIndex ll1:DI_LL1_Composite ; di:hasForecastValue "0.66"^^xsd:decimal ;
    di:hasForecastHorizon "PT2H"^^xsd:duration ; di:forecastIssuedAt "2026-06-01T09:46:00Z"^^xsd:dateTime ;
    di:hasForecastConfidence "0.75"^^xsd:decimal ; di:forecastProducedBy ll1:ContainerVessel_DigitalTwin .

ll1:SysDIForecast_ReduceSpeed a di:DIForecast ;
    warrant:hasName "Forecast DI_sys — reduce speed and open CPA" ;
    warrant:hasDescription "DI_nav 0.25: 0.4·0.25 + 0.48 = 0.58. More time, but the picture is still wrong." ;
    di:forecastsIndex ll1:DI_LL1_Composite ; di:hasForecastValue "0.58"^^xsd:decimal ;
    di:hasForecastHorizon "PT2H"^^xsd:duration ; di:forecastIssuedAt "2026-06-01T09:46:00Z"^^xsd:dateTime ;
    di:hasForecastConfidence "0.80"^^xsd:decimal ; di:forecastProducedBy ll1:ContainerVessel_DigitalTwin .

ll1:SysDIForecast_RedundantGNSS a di:DIForecast ;
    warrant:hasName "Forecast DI_sys — switch to GPS No2 and ECDIS No2" ;
    warrant:hasDescription "DI_nav 0.10: 0.4·0.10 + 0.48 = 0.52. Almost no improvement, because the redundant chain is exposed to the same signal." ;
    di:forecastsIndex ll1:DI_LL1_Composite ; di:hasForecastValue "0.52"^^xsd:decimal ;
    di:hasForecastHorizon "PT2H"^^xsd:duration ; di:forecastIssuedAt "2026-06-01T09:46:00Z"^^xsd:dateTime ;
    di:hasForecastConfidence "0.80"^^xsd:decimal ; di:forecastProducedBy ll1:ContainerVessel_DigitalTwin .

ll1:Eval_RevertToIndependentNavigation a mit:ResponseEvaluation ;
    mit:evaluatesAction ll1:RevertToIndependentNavigationAction ;
    mit:respondsToTrigger ll1:Trigger_NavCyberBreach , ll1:Trigger_PredictedFloorCrossing ;
    mit:hasExpectedIndex ll1:SysDIForecast_RevertIndependent ;
    mit:hasImplementationCost "0.25"^^xsd:decimal ; mit:hasResidualExposurePenalty "0.10"^^xsd:decimal ;
    mit:hasObjectiveValue "0.565"^^xsd:decimal ;
    mit:isAdmissible true ; mit:hasRank 1 ; mit:isRecommended true ;
    mit:hasExplanation "0.66 − 0.3·0.25 − 0.2·0.10 = 0.565. Takes the corrupted own-ship position and traffic positions out of the conning loop and replaces them with evidence the spoofer cannot reach. Cost is bridge workload and the loss of automatic track keeping; residual exposure remains where no charted features are within radar range." ;
    mit:usesDecisionConfiguration ll1:LL1_DecisionConfig ;
    mit:evaluatedBy ll1:LL1_REDS ; mit:evaluatedAt "2026-06-01T09:46:30Z"^^xsd:dateTime ;
    mit:isRecordedIn ll1:LL1_LDC .

ll1:Eval_ReduceSpeed a mit:ResponseEvaluation ;
    mit:evaluatesAction ll1:ReduceSpeedIncreaseCPAAction ;
    mit:respondsToTrigger ll1:Trigger_NavCyberBreach , ll1:Trigger_PredictedFloorCrossing ;
    mit:hasExpectedIndex ll1:SysDIForecast_ReduceSpeed ;
    mit:hasImplementationCost "0.40"^^xsd:decimal ; mit:hasResidualExposurePenalty "0.15"^^xsd:decimal ;
    mit:hasObjectiveValue "0.43"^^xsd:decimal ;
    mit:isAdmissible true ; mit:hasRank 2 ; mit:isRecommended false ;
    mit:hasExplanation "0.58 − 0.3·0.40 − 0.2·0.15 = 0.43. Buys time and reduces the consequence of a wrong decision, but does not restore a trustworthy picture. Retained as a complement to the recommended response." ;
    mit:usesDecisionConfiguration ll1:LL1_DecisionConfig ;
    mit:evaluatedBy ll1:LL1_REDS ; mit:evaluatedAt "2026-06-01T09:46:30Z"^^xsd:dateTime ;
    mit:isRecordedIn ll1:LL1_LDC .

ll1:Eval_SwitchToRedundantGNSSChain a mit:ResponseEvaluation ;
    mit:evaluatesAction ll1:SwitchToRedundantGNSSChainAction ;
    mit:respondsToTrigger ll1:Trigger_NavCyberBreach , ll1:Trigger_PredictedFloorCrossing ;
    mit:hasExpectedIndex ll1:SysDIForecast_RedundantGNSS ;
    mit:hasImplementationCost "0.05"^^xsd:decimal ; mit:hasResidualExposurePenalty "0.40"^^xsd:decimal ;
    mit:hasObjectiveValue "0.425"^^xsd:decimal ;
    mit:isAdmissible false ; mit:hasRank 3 ; mit:isRecommended false ;
    mit:hasExplanation "0.52 − 0.3·0.05 − 0.2·0.40 = 0.425, and inadmissible: the forecast stays below the 0.55 floor. Redundancy is not independence; the second receiver and display see the same counterfeit signal." ;
    mit:usesDecisionConfiguration ll1:LL1_DecisionConfig ;
    mit:evaluatedBy ll1:LL1_REDS ; mit:evaluatedAt "2026-06-01T09:46:30Z"^^xsd:dateTime ;
    mit:isRecordedIn ll1:LL1_LDC .

# ── IRDS: the authorised response and its outcome ─────────────────────────

ll1:NavigationOfficerApproval a obs:OperatorInput ;
    warrant:hasName "Navigation officer authorises reversion to independent navigation" ;
    obs:hasTimestamp "2026-06-01T09:48:00Z"^^xsd:dateTime ;
    obs:hasSource ll1:NavigationOfficerRole .

ll1:RevertToIndependentNavigationExecution a mit:ResponseExecution ;
    warrant:hasName "Reversion to independent position fixing and radar-based collision avoidance" ;
    mit:executesAction ll1:RevertToIndependentNavigationAction ;
    mit:selectedFrom ll1:Eval_RevertToIndependentNavigation ;
    mit:hasAuthorisationStatus mit:AUTHORISED ;
    mit:authorisedBy ll1:NavigationOfficerRole ;
    mit:authorisedAt "2026-06-01T09:48:00Z"^^xsd:dateTime ;
    mit:startedAt    "2026-06-01T09:48:30Z"^^xsd:dateTime ;
    mit:completedAt  "2026-06-01T09:55:00Z"^^xsd:dateTime ;
    mit:hasResiliencePosture mit:FAIL_OPERATIONAL ;
    mit:hasOutcome "SUCCESSFUL: position fixed by radar on charted features, 1.2 NM from the GNSS position; both ECDIS on dead reckoning with manual fixes; autopilot in heading control; AIS targets marked unverified and collision avoidance taken on radar; Master on the bridge; VTS informed and the interference reported. GNSS receivers remain available and remain untrusted: the spoofing itself is outside the vessel's control." ;
    mit:hasOutcomeIndex ll1:DI_Navigation_T2 ;
    mit:recordedOperatorInput ll1:NavigationOfficerApproval ;
    mit:coordinatedBy ll1:LL1_IRDS ;
    mit:isRecordedIn ll1:LL1_LDC .

# Post-response at T2 = 09:55:00:
#   ND = 0.4·0.45 + 0.2·0.35 + 0.2·0.80 + 0.2·0.55 = 0.52
#   R  = 0.04 + 0.50·(0.60·0.60 + 0.60·0.10) = 0.25 (the local term falls with
#        the control in force; the position data is still spoofed, so the
#        propagated term is unchanged)
#   DI = 0.52 − 0.40·0.25 = 0.42; state Critical (cybersecurity 0.35 < 0.45)
#   DI_sys = 0.4·0.42 + 0.48 = 0.648, back above the floor.
ll1:V_NavSafety_T2 a assr:AssuranceAttributeValue ; assr:hasAttributeValueNumber "0.45"^^xsd:decimal ; assr:hasSourceConfidence "0.85"^^xsd:decimal ; assr:hasValueSource ll1:NavigationNodeHealthMonitor ; assr:assessedAt "2026-06-01T09:55:00Z"^^xsd:dateTime ; di:hasAttributeState di:DegradedState .
ll1:V_NavCyber_T2 a assr:AssuranceAttributeValue ; assr:hasAttributeValueNumber "0.35"^^xsd:decimal ; assr:hasSourceConfidence "0.80"^^xsd:decimal ; assr:hasValueSource ll1:NavigationIntegrityService ; assr:assessedAt "2026-06-01T09:55:00Z"^^xsd:dateTime ; di:hasAttributeState di:CriticalState .
ll1:V_NavAvail_T2 a assr:AssuranceAttributeValue ; assr:hasAttributeValueNumber "0.80"^^xsd:decimal ; assr:hasSourceConfidence "0.95"^^xsd:decimal ; assr:hasValueSource ll1:NavigationNodeHealthMonitor ; assr:assessedAt "2026-06-01T09:55:00Z"^^xsd:dateTime ; di:hasAttributeState di:NormalState .
ll1:V_NavRel_T2 a assr:AssuranceAttributeValue ; assr:hasAttributeValueNumber "0.55"^^xsd:decimal ; assr:hasSourceConfidence "0.80"^^xsd:decimal ; assr:hasValueSource ll1:NavigationNodeHealthMonitor ; assr:assessedAt "2026-06-01T09:55:00Z"^^xsd:dateTime ; di:hasAttributeState di:DegradedState .

ll1:NavSafetyAttribute assr:hasAttributeValue ll1:V_NavSafety_T2 . ll1:NavCyberAttribute assr:hasAttributeValue ll1:V_NavCyber_T2 .
ll1:NavAvailAttribute  assr:hasAttributeValue ll1:V_NavAvail_T2 .  ll1:NavRelAttribute   assr:hasAttributeValue ll1:V_NavRel_T2 .

ll1:NavigationNodeScore_T2 a assr:AssuranceScore ;
    warrant:hasName "Navigation function node dependability score after the response" ;
    assr:hasScoreValue "0.52"^^xsd:decimal ;
    assr:usesCalculationMethod ll1:NodeScoreMethod_LL1 ;
    di:calculatedAt "2026-06-01T09:55:00Z"^^xsd:dateTime .

ll1:NavCyberRisk_T2 a di:PropagatedRisk ;
    warrant:hasName "Propagated CYBER_THREAT risk at the navigation function after the response" ;
    di:forHazardClass cdm:CYBER_THREAT ;
    di:hasLocalRiskValue "0.04"^^xsd:decimal ; di:hasPropagatedRiskValue "0.25"^^xsd:decimal ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ; di:calculatedAt "2026-06-01T09:55:00Z"^^xsd:dateTime .

ll1:DI_Navigation_T2 a di:DependabilityIndex ;
    di:hasDIValue             "0.42"^^xsd:decimal ;
    di:hasBetaWeight          "0.40"^^xsd:decimal ;
    di:hasAggregatedRiskValue "0.25"^^xsd:decimal ;
    di:hasPropagatedRisk      ll1:NavCyberRisk_T2 ;
    di:calculatedAt           "2026-06-01T09:55:00Z"^^xsd:dateTime ;
    di:usesCalculationMethod  ll1:DI_Method_LL1 ;
    di:hasDIState             di:CriticalState ;
    di:appliesTo              ll1:NavigationFunction ;
    di:performedBy            ll1:LL1_DependabilitySupervisor ;
    di:isRecordedIn           ll1:LL1_LDC .

ll1:NavigationNodeScore_T2 di:contributesTo ll1:DI_Navigation_T2 .
ll1:NavigationFunction assr:hasAssuranceScore ll1:NavigationNodeScore_T2 .


# ═══════════════════════════════════════════════════════════════════════════════
# LIVING DEPENDABILITY CASE
#
# The regulatory requirements are real instruments. The company requirement
# wording, the claim wording, the evidence obligations and their validity
# periods and the Assurance Level weights are the approved WARRaNT LL1 baseline.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:ExtRef_SOLAS_V19 a warrant:ExternalReference ;
    warrant:hasName "SOLAS Chapter V Regulation 19 — Carriage requirements for shipborne navigational systems and equipment" .

ll1:ExtRef_SOLAS_V20 a warrant:ExternalReference ;
    warrant:hasName "SOLAS Chapter V Regulation 20 — Voyage data recorders" .

ll1:ExtRef_IACS_E26 a warrant:ExternalReference ;
    warrant:hasName "IACS UR E26 Rev.1 — Cyber resilience of ships" .

ll1:REQ_ECDISBackup a assr:Requirement ;
    warrant:hasIdentifier "REQ-NAV-001" ;
    warrant:hasName "A backup arrangement for electronic chart display is available at all times" ;
    assr:hasRequirementCategory "REGULATORY" ;
    assr:declaredBy "Flag Administration via SOLAS V/19" ;
    assr:hasRequirementSource ll1:ExtRef_SOLAS_V19 ;
    assr:expectsEvidence ll1:OBL_ECDISBackupAvailable .

ll1:REQ_VDRMaintained a assr:Requirement ;
    warrant:hasIdentifier "REQ-VDR-001" ;
    warrant:hasName "The voyage data recorder records and preserves voyage data" ;
    assr:hasRequirementCategory "REGULATORY" ;
    assr:declaredBy "Flag Administration via SOLAS V/20" ;
    assr:hasRequirementSource ll1:ExtRef_SOLAS_V20 ;
    assr:expectsEvidence ll1:OBL_VDRRecordIntact .

ll1:REQ_CyberResilience a assr:Requirement ;
    warrant:hasIdentifier "REQ-CYB-001" ;
    warrant:hasName "Onboard systems and equipment are cyber resilient" ;
    assr:hasRequirementCategory "REGULATORY" ;
    assr:declaredBy "Classification society via IACS UR E26" ;
    assr:hasRequirementSource ll1:ExtRef_IACS_E26 ;
    assr:expectsEvidence ll1:OBL_NavIntegrityMonitoringCoverage .

ll1:REQ_PositionCrossCheck a assr:Requirement ;
    warrant:hasIdentifier "REQ-NAV-002" ;
    warrant:hasName "Own-ship position is verified by an independent fix at the required interval" ;
    warrant:hasDescription "An independent fix (radar ranges and bearings to charted features, visual bearings or celestial observation) at least hourly in coastal waters and immediately whenever GNSS integrity is in doubt. Comparing GPS No1 with GPS No2, or own-ship GNSS with own-ship AIS, does not count as independent." ;
    assr:hasRequirementCategory "STAKEHOLDER" ;
    assr:declaredBy "WARRaNT LL1 baseline (company navigation procedure)" ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" ;
    assr:expectsEvidence ll1:OBL_PositionCrossCheckLog .

ll1:CLM_NavigationIntegrity a assr:AssuranceClaim ;
    warrant:hasIdentifier "CLM-NAV-001" ;
    warrant:hasName "Own-ship position and the traffic picture used for conning decisions are trustworthy" ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" ;
    assr:addressesRequirement ll1:REQ_ECDISBackup , ll1:REQ_PositionCrossCheck , ll1:REQ_CyberResilience ;
    assr:claimAppliesTo ll1:NavigationFunction , ll1:OwnShipPositionData , ll1:SurroundingTrafficAISReports , ll1:CTRL_RadarGPSCrossCheck ;
    assr:expectsEvidence ll1:OBL_PositionCrossCheckLog ;
    assr:hasClaimStatus assr:CLAIM_CHALLENGED ;
    assr:claimStatusUpdatedAt "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:CLM_VoyageRecordIntegrity a assr:AssuranceClaim ;
    warrant:hasIdentifier "CLM-VDR-001" ;
    warrant:hasName "The voyage record is complete and unaltered for the current voyage" ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" ;
    assr:addressesRequirement ll1:REQ_VDRMaintained ;
    assr:claimAppliesTo ll1:VoyageRecordingFunction , ll1:CTRL_VDRIntegrityMonitoring ;
    assr:expectsEvidence ll1:OBL_VDRRecordIntact ;
    assr:hasClaimStatus assr:CLAIM_SUPPORTED ;
    assr:claimStatusUpdatedAt "2026-06-01T06:00:05Z"^^xsd:dateTime .

ll1:CLM_EngineRoomMonitored a assr:AssuranceClaim ;
    warrant:hasIdentifier "CLM-ELE-001" ;
    warrant:hasName "Engine room and vessel-wide alarm conditions reach the crew" ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" ;
    assr:addressesRequirement ll1:REQ_CyberResilience ;
    assr:claimAppliesTo ll1:ElectricalAlarmFunction , ll1:CTRL_AMSBackupAndLogMonitoring ;
    assr:hasClaimStatus assr:CLAIM_SUPPORTED ;
    assr:claimStatusUpdatedAt "2026-06-01T06:00:05Z"^^xsd:dateTime .

ll1:ASM_AISTrafficPictureTrustworthy a assr:Assumption ;
    warrant:hasName "AIS target positions are a trustworthy input to collision avoidance" ;
    warrant:hasDescription "A design-time assumption of the navigation analysis. This scenario invalidates it without any AIS spoofing: the reports are genuine, but the positions in them come from GNSS receivers that are themselves spoofed." ;
    assr:assumptionAppliesTo ll1:NavigationFunction , ll1:CLM_NavigationIntegrity ;
    assr:hasValidityStatus "INVALIDATED" ;
    assr:isChallengedBy ll1:SurroundingTrafficGNSSCorruptionEvent ;
    assr:challengesClaim ll1:CLM_NavigationIntegrity .

ll1:ASM_IndependentFixFeaturesInRange a assr:Assumption ;
    warrant:hasName "Charted radar-conspicuous features are within radar range throughout the coastal approach" ;
    warrant:hasDescription "The independent own-ship fix, and therefore both the detection of GNSS spoofing and the recommended response, rely on it. It holds for this approach; it would not hold in open water." ;
    assr:assumptionAppliesTo ll1:CTRL_RadarGPSCrossCheck , ll1:CLM_NavigationIntegrity , ll1:CoastalApproachSegment ;
    assr:hasValidityStatus "VALID" .

ll1:ASM_BridgeAccessControlled a assr:Assumption ;
    warrant:hasName "Configuration access to bridge OT is limited to authorised service engineers" ;
    assr:assumptionAppliesTo ll1:CTRL_ServiceEngineerAccessControl , ll1:CLM_NavigationIntegrity ;
    assr:hasValidityStatus "UNDER_REVIEW" ;
    assr:isChallengedBy ll1:ECDISSettingsModifiedEvent .

ll1:OBL_PositionCrossCheckLog a assr:EvidenceObligation ;
    warrant:hasName "Independent position fix performed and logged within the required interval" ;
    assr:declaredBy "WARRaNT LL1 baseline (company navigation procedure)" ;
    assr:hasValidityPeriod "PT1H"^^xsd:duration ;
    assr:hasObligationStatus assr:STALE ;
    assr:isFulfilledBy ll1:EV_PositionCrossCheckLog ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .

ll1:OBL_VDRRecordIntact a assr:EvidenceObligation ;
    warrant:hasName "VDR integrity verification for the current voyage" ;
    assr:declaredBy "Flag Administration via SOLAS V/20" ;
    assr:hasValidityPeriod "P1D"^^xsd:duration ;
    assr:hasObligationStatus assr:PRESENT ;
    assr:isFulfilledBy ll1:EV_VDRIntegrityCheckPassed ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .

ll1:OBL_ECDISBackupAvailable a assr:EvidenceObligation ;
    warrant:hasName "Second ECDIS or corrected paper charts confirmed available" ;
    assr:declaredBy "Flag Administration via SOLAS V/19" ;
    assr:hasValidityPeriod "P1D"^^xsd:duration ;
    assr:hasObligationStatus assr:PRESENT ;
    assr:isFulfilledBy ll1:EV_ECDISBackupConfirmed ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .

ll1:OBL_NavIntegrityMonitoringCoverage a assr:EvidenceObligation ;
    warrant:hasName "Integrity monitoring covers every consumer of GNSS-derived position" ;
    warrant:hasDescription "The navigation integrity service checks the position ECDIS displays and the AIS targets, but not the autopilot track-control input or the radar geo-referencing input, so coverage of those consumers cannot be evidenced." ;
    assr:declaredBy "Classification society via IACS UR E26" ;
    assr:hasValidityPeriod "P30D"^^xsd:duration ;
    assr:hasObligationStatus assr:UNTRACEABLE ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .

ll1:EV_GNSSIntegrityBreach a assr:Evidence ;
    warrant:hasName "Own-ship GNSS fix inconsistent with radar fix, depth and dead reckoning" ;
    assr:hasEvidenceSource ll1:GPSSpoofingDetectionEvent ;
    assr:challengesClaim ll1:CLM_NavigationIntegrity ;
    assr:evidenceCollectedAt "2026-06-01T09:44:30Z"^^xsd:dateTime ;
    warrant:validTo "2026-06-01T21:44:30Z"^^xsd:dateTime ;
    assr:hasEvidenceQuality "0.80"^^xsd:decimal .

ll1:EV_TrafficAISCoherentDivergence a assr:Evidence ;
    warrant:hasName "Coherent AIS-to-radar divergence across surrounding traffic" ;
    assr:hasEvidenceSource ll1:SurroundingTrafficGNSSCorruptionEvent ;
    assr:challengesClaim ll1:CLM_NavigationIntegrity ;
    assr:evidenceCollectedAt "2026-06-01T09:45:00Z"^^xsd:dateTime ;
    warrant:validTo "2026-06-01T21:45:00Z"^^xsd:dateTime ;
    assr:hasEvidenceQuality "0.80"^^xsd:decimal .

ll1:EV_PositionCrossCheckLog a assr:Evidence ;
    warrant:hasName "Last logged independent position fix by radar" ;
    warrant:hasDescription "Performed before the spoofing began; outside the one-hour validity period at the time of assessment, which is why the obligation is stale rather than present." ;
    assr:hasEvidenceSource ll1:NavigationIntegrityService ;
    assr:supportsClaim ll1:CLM_NavigationIntegrity ;
    assr:evidenceCollectedAt "2026-06-01T08:10:00Z"^^xsd:dateTime ;
    warrant:validTo "2026-06-01T09:10:00Z"^^xsd:dateTime ;
    assr:hasEvidenceQuality "0.75"^^xsd:decimal .

ll1:EV_ECDISBackupConfirmed a assr:Evidence ;
    warrant:hasName "Second ECDIS and corrected paper charts confirmed available" ;
    warrant:hasDescription "Evidence that a display backup exists. It says nothing about position integrity: ECDIS No2 takes the same GNSS feed." ;
    assr:hasEvidenceSource ll1:NavigationOfficerRole ;
    assr:supportsClaim ll1:CLM_NavigationIntegrity ;
    assr:evidenceCollectedAt "2026-06-01T06:00:00Z"^^xsd:dateTime ;
    warrant:validTo "2026-06-02T06:00:00Z"^^xsd:dateTime ;
    assr:hasEvidenceQuality "0.90"^^xsd:decimal .

ll1:EV_IndependentNavigationConfirmed a assr:Evidence ;
    warrant:hasName "Radar fix, dead-reckoning ECDIS and radar-based collision avoidance confirmed by the officer" ;
    assr:hasEvidenceSource ll1:NavigationOfficerApproval ;
    assr:supportsClaim ll1:CLM_NavigationIntegrity ;
    assr:evidenceCollectedAt "2026-06-01T09:55:00Z"^^xsd:dateTime ;
    warrant:validTo "2026-06-01T21:55:00Z"^^xsd:dateTime ;
    assr:hasEvidenceQuality "0.85"^^xsd:decimal ;
    warrant:derivedFrom ll1:RevertToIndependentNavigationExecution .

ll1:EV_VDRIntegrityCheckPassed a assr:Evidence ;
    warrant:hasName "Daily VDR stored-record hash verification passed" ;
    assr:hasEvidenceSource ll1:VDRHealthService ;
    assr:supportsClaim ll1:CLM_VoyageRecordIntegrity ;
    assr:evidenceCollectedAt "2026-06-01T06:00:00Z"^^xsd:dateTime ;
    warrant:validTo "2026-06-02T06:00:00Z"^^xsd:dateTime ;
    assr:hasEvidenceQuality "0.90"^^xsd:decimal .

ll1:EV_VDRHashMismatch a assr:Evidence ;
    warrant:hasName "VDR stored-record hash mismatch (29 May, earlier leg)" ;
    assr:hasEvidenceSource ll1:VDRDataTamperEvent ;
    assr:challengesClaim ll1:CLM_VoyageRecordIntegrity ;
    assr:evidenceCollectedAt "2026-05-29T13:00:00Z"^^xsd:dateTime ;
    warrant:validTo "2026-05-30T13:00:00Z"^^xsd:dateTime ;
    assr:hasEvidenceQuality "0.90"^^xsd:decimal .

ll1:EV_AMSDataAnomaly a assr:Evidence ;
    warrant:hasName "AMS monitoring values outside physical range (7 May, earlier leg)" ;
    assr:hasEvidenceSource ll1:AMSDataCorruptionEvent ;
    assr:challengesClaim ll1:CLM_EngineRoomMonitored ;
    assr:evidenceCollectedAt "2026-05-07T07:00:00Z"^^xsd:dateTime ;
    warrant:validTo "2026-05-07T19:00:00Z"^^xsd:dateTime ;
    assr:hasEvidenceQuality "0.70"^^xsd:decimal .

ll1:EV_AMSLogReviewClean a assr:Evidence ;
    warrant:hasName "Daily AMS log review shows no anomaly" ;
    assr:hasEvidenceSource ll1:IDSAnalyticalService ;
    assr:supportsClaim ll1:CLM_EngineRoomMonitored ;
    assr:evidenceCollectedAt "2026-06-01T06:00:00Z"^^xsd:dateTime ;
    warrant:validTo "2026-06-02T06:00:00Z"^^xsd:dateTime ;
    assr:hasEvidenceQuality "0.80"^^xsd:decimal .

ll1:NC_VDRIntegrityUnverified a assr:Nonconformity ;
    warrant:hasName "VDR integrity could not be verified for the period affected on 29 May" ;
    warrant:hasDescription "Closed: the affected period is recorded as unverifiable and integrity has been verified daily since." ;
    assr:relatesToRequirement ll1:REQ_VDRMaintained ;
    assr:hasNonconformitySeverity "MAJOR" ; assr:isResolved true .

ll1:NC_PositionCrossCheckOverdue a assr:Nonconformity ;
    warrant:hasName "Independent position fix overdue when the spoofing began" ;
    assr:relatesToRequirement ll1:REQ_PositionCrossCheck ;
    assr:hasNonconformitySeverity "MINOR" ; assr:isResolved false .

ll1:NC_NavIntegrityMonitoringCoverageGap a assr:Nonconformity ;
    warrant:hasName "Integrity monitoring does not cover the autopilot track-control and radar geo-referencing inputs" ;
    assr:relatesToRequirement ll1:REQ_CyberResilience ;
    assr:hasNonconformitySeverity "MAJOR" ; assr:isResolved false .

ll1:LL1_ALWeights a assr:AssuranceLevelWeightSet ;
    warrant:hasName "LL1 Assurance Level weights" ;
    assr:hasCompletenessWeight "0.30"^^xsd:decimal ; assr:hasFreshnessWeight "0.20"^^xsd:decimal ;
    assr:hasQualityWeight "0.20"^^xsd:decimal ; assr:hasMonitoringWeight "0.15"^^xsd:decimal ;
    assr:hasTraceabilityWeight "0.15"^^xsd:decimal ;
    assr:declaredBy "WARRaNT LL1 baseline" ;
    warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .

ll1:LL1_AL_T1 a assr:AssuranceLevel ;
    warrant:hasName "LL1 Assurance Level at 09:45" ;
    warrant:hasDescription "Completeness is 0.50 because two of the four declared obligations are present, one is stale and one is untraceable. Monitoring coverage reflects the uncovered GNSS consumers." ;
    assr:hasEvidenceCompleteness "0.50"^^xsd:decimal ;
    assr:hasEvidenceFreshness    "0.70"^^xsd:decimal ;
    assr:hasEvidenceQualityValue "0.80"^^xsd:decimal ;
    assr:hasMonitoringCoverage   "0.60"^^xsd:decimal ;
    assr:hasTraceabilityCoverage "0.80"^^xsd:decimal ;
    assr:hasAssuranceLevelValue  "0.66"^^xsd:decimal ;
    assr:usesAssuranceLevelWeights ll1:LL1_ALWeights ;
    assr:usesCalculationMethod ll1:AssuranceLevelMethod_LL1 ;
    di:calculatedAt "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:LL1_CR_T1 a assr:CertificationReadiness ;
    warrant:hasName "LL1 certification readiness at 09:45" ;
    warrant:hasDescription "RC = 2/4 requirements with all obligations present; NSI = (0.8 + 0.4)/4 = 0.30; readiness = (0.66 + 0.50)/2 − 0.5·0.30 = 0.43." ;
    assr:derivesFromAssuranceLevel ll1:LL1_AL_T1 ;
    assr:hasRequirementCoverage "0.50"^^xsd:decimal ;
    assr:hasUnresolvedNonconformityCount 2 ;
    assr:hasNonconformitySeverityIndex "0.30"^^xsd:decimal ;
    assr:hasReadinessValue "0.43"^^xsd:decimal ;
    assr:usesCalculationMethod ll1:ReadinessMethod_LL1 ;
    di:calculatedAt "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:LL1_LDC a assr:LivingDependabilityCase ;
    warrant:hasName "CATHERINE C Living Dependability Case" ;
    assr:caseAppliesTo ll1:ContainerVessel_LL1 ;
    assr:hasBaselineVersion "DC-LL1-V145-2026.1" ;
    assr:includesRequirement ll1:REQ_ECDISBackup , ll1:REQ_VDRMaintained , ll1:REQ_CyberResilience , ll1:REQ_PositionCrossCheck ;
    assr:includesClaim ll1:CLM_NavigationIntegrity , ll1:CLM_VoyageRecordIntegrity , ll1:CLM_EngineRoomMonitored ;
    assr:includesAssumption ll1:ASM_AISTrafficPictureTrustworthy , ll1:ASM_IndependentFixFeaturesInRange , ll1:ASM_BridgeAccessControlled ;
    assr:includesEvidence ll1:EV_GNSSIntegrityBreach , ll1:EV_TrafficAISCoherentDivergence , ll1:EV_PositionCrossCheckLog ,
                          ll1:EV_ECDISBackupConfirmed , ll1:EV_IndependentNavigationConfirmed , ll1:EV_VDRIntegrityCheckPassed ,
                          ll1:EV_VDRHashMismatch , ll1:EV_AMSDataAnomaly , ll1:EV_AMSLogReviewClean ;
    assr:includesNonconformity ll1:NC_VDRIntegrityUnverified , ll1:NC_PositionCrossCheckOverdue , ll1:NC_NavIntegrityMonitoringCoverageGap ;
    assr:hasAssuranceLevel ll1:LL1_AL_T1 ;
    assr:hasCertificationReadiness ll1:LL1_CR_T1 .


# ═══════════════════════════════════════════════════════════════════════════════
# DIGITAL TWIN
#
# Presents the degraded navigation state with its supporting evidence: the
# indices and states, the deviations on both propagation paths, the hazard, and
# the recommended and executed response.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:ContainerVessel_DigitalTwin a dt:DigitalTwin ;
    warrant:hasName "LL1 Containership Digital Twin (Danaos / CATHERINE C)" .

ll1:ContainerVessel_DigitalTwin dt:representsStateOf ll1:ContainerVessel_LL1 .

ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_LL1_Composite .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_Navigation .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_OwnShipPosition .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_VDR .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_Communication .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DI_ElectricalAlarm .

ll1:ContainerVessel_DigitalTwin dt:visualises ll1:HazHazardousAreaApproach .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:RiskCollisionGrounding .

ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DevGPSSpoofed .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DevOwnShipAISBroadcastWrong .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:DevSurroundingTrafficAISPositionsWrong .

ll1:ContainerVessel_DigitalTwin dt:visualises ll1:RevertToIndependentNavigationAction .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:ReduceSpeedIncreaseCPAAction .
ll1:ContainerVessel_DigitalTwin dt:visualises ll1:ActionAlertMasterVSOC .

ll1:ContainerVessel_DigitalTwin dt:receivesUpdateFrom ll1:NavigationIntegrityService .
ll1:ContainerVessel_DigitalTwin dt:receivesUpdateFrom ll1:IDSAnalyticalService .
ll1:ContainerVessel_DigitalTwin dt:receivesUpdateFrom ll1:VDRHealthService .

