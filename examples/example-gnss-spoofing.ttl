# ═══════════════════════════════════════════════════════════════════════════════
# VULNERABILITIES AND THREAT SCENARIOS
#
# Representing the threat scenarios explicitly lets a compromise be traced from
# the weakness it exploits to the assets it degrades and the risk it is
# evaluated as.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:Vul_UnauthenticatedAISBroadcast a cdm:Vulnerability ;
    warrant:hasName "AIS messages are broadcast without authentication" ;
    warrant:hasDescription "AIS operates as an open broadcast on the VHF AIS channels (87B/88B). A receiver cannot distinguish a genuine transmission from a counterfeit one, so any transmitter within VHF range can insert, displace or suppress contacts in the traffic picture. Authentication would not address the primary scenario: there the messages are genuine and the positions in them are wrong at source." ;
    cdm:affectsComponent ll1:AIS_Transponder .

ll1:Vul_UnauthenticatedGNSSSignal a cdm:Vulnerability ;
    warrant:hasName "Civil GNSS signals carry no authentication" ;
    warrant:hasDescription "The receiver cannot distinguish a genuine satellite signal from a counterfeit one. Signal-strength monitoring does not help: a spoofed signal normally arrives at normal or elevated carrier-to-noise density. Both receivers, and every other GNSS receiver in the area including those of surrounding vessels, share the exposure." ;
    cdm:affectsComponent ll1:GPS_1 , ll1:GPS_2 .

ll1:Vul_RemovableMediaUpdatePath a cdm:Vulnerability ;
    warrant:hasName "Removable-media update and storage paths on bridge OT" ;
    warrant:hasDescription "ECDIS carries CF and SD storage with a DVD update interface, the VDR a CF card, and Inmarsat-C a legacy floppy update path, per the equipment inventory. Each is an unmediated route for code or configuration onto a bridge OT device." ;
    cdm:affectsComponent ll1:ECDIS_1 , ll1:VDR , ll1:InmarsatC_1 .

ll1:Vul_SatTerminalNoEndpointProtection a cdm:Vulnerability ;
    warrant:hasName "Satellite terminals without endpoint protection" ;
    warrant:hasDescription "Both Inmarsat GX and FBB-500 run Linux with no antivirus or firewall configured, per the equipment inventory, on the LAN that also carries shore internet traffic to the Communications PC." ;
    cdm:affectsComponent ll1:InmarsatGX , ll1:InmarsatFBB .

ll1:Vul_FlatBridgeLANSegment a cdm:Vulnerability ;
    warrant:hasName "Shared bridge LAN segment" ;
    warrant:hasDescription "The radar to ECDIS LAN is shared with other bridge systems, so a foothold on one device has a path to the others without crossing a conduit." ;
    cdm:affectsComponent ll1:ECDIS_1 .

ll1:Threat_AISSpoofing a cdm:ThreatScenario ;
    warrant:hasName "AIS target spoofing" ;
    warrant:hasDescription "Secondary scenario. An adversary within VHF range transmits counterfeit AIS messages, inserting phantom contacts, displacing real ones or suppressing them. Detected by contacts without a radar echo and by isolated divergence from radar, not by signal quality. Own-ship position is unaffected." ;
    cdm:exploits ll1:Vul_UnauthenticatedAISBroadcast ;
    cdm:degrades ll1:AIS_Transponder , ll1:Link_AIS_NavBus , ll1:NavigationFunction ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskCollisionGrounding .

ll1:Threat_GNSSSpoofing a cdm:ThreatScenario ;
    warrant:hasName "Area-wide GNSS spoofing" ;
    warrant:hasDescription "Primary scenario. A counterfeit GNSS signal covering a sea area makes every receiver in range output a plausible but wrong position. On this vessel it propagates over the GPS bus to every consumer, including the ECDIS own-ship position and the AIS position broadcast about own ship; on surrounding vessels it corrupts the positions their AIS broadcasts, which this vessel then displays as the traffic picture. Detected by inconsistency against independent evidence: radar ranges and bearings to charted features, echo-sounder depth against charted depth, dead reckoning, and a coherent AIS-to-radar divergence pattern across targets. Not detected by carrier-to-noise density, by comparing GPS No1 with No2, or by comparing own-ship GNSS with own-ship AIS; receiver autonomous integrity monitoring does not reject a self-consistent counterfeit signal set. The Danaos FMEA has no spoofing entry." ;
    cdm:exploits ll1:Vul_UnauthenticatedGNSSSignal ;
    cdm:degrades ll1:GPS_1 , ll1:GPS_2 , ll1:OwnShipPositionData , ll1:SurroundingVesselGNSSPositionData , ll1:SurroundingTrafficAISReports , ll1:OwnShipAISBroadcast , ll1:NavigationFunction ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskCollisionGrounding .

ll1:Threat_ECDISCompromise a cdm:ThreatScenario ;
    warrant:hasName "ECDIS compromise through removable media or the shared LAN" ;
    warrant:hasDescription "Unauthorised change to ECDIS display parameters, antenna offsets, chart datum or software, introduced through the storage and update paths or laterally across the bridge LAN. An alternative, separately detected cause of a wrong own-ship position on the chart; not part of the GNSS spoofing scenario." ;
    cdm:exploits ll1:Vul_RemovableMediaUpdatePath , ll1:Vul_FlatBridgeLANSegment ;
    cdm:degrades ll1:ECDIS_1 , ll1:NavigationFunction ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskCollisionGrounding .

ll1:Threat_VDRTampering a cdm:ThreatScenario ;
    warrant:hasName "VDR tampering to conceal an incident timeline" ;
    warrant:hasDescription "Erasure or overwriting of stored voyage data, so that the voyage record is unavailable to an investigation. The highest-RPN entry in the navigation OT worksheet. A separate FMEA risk: the GNSS spoofing scenario does not assume the attacker also reaches the VDR." ;
    cdm:exploits ll1:Vul_RemovableMediaUpdatePath ;
    cdm:degrades ll1:VDR , ll1:VoyageRecordingFunction ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskVDREvidenceLoss .

ll1:Threat_AMSCompromise a cdm:ThreatScenario ;
    warrant:hasName "Alarm monitoring system data compromise" ;
    warrant:hasDescription "Falsification of engine room and vessel-wide alarm data so that the crew cannot detect fire, flooding or machinery failure. Highest RPN in the whole worksheet at 315." ;
    cdm:degrades ll1:AlarmMonitoringSystem , ll1:ElectricalAlarmFunction ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskEngineRoomUnmonitored .

ll1:Threat_SatCommCompromise a cdm:ThreatScenario ;
    warrant:hasName "Satellite terminal compromise at the IT/OT boundary" ;
    warrant:hasDescription "Compromise of an unprotected satellite terminal from the shore side, removing long-range communications and providing a foothold on the LAN shared with the Communications PC." ;
    cdm:exploits ll1:Vul_SatTerminalNoEndpointProtection ;
    cdm:degrades ll1:InmarsatGX , ll1:InmarsatFBB , ll1:CommunicationFunction , ll1:Zone_ShipBusinessIT ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:isEvaluatedAs ll1:RiskDistressCommsLoss .


# ═══════════════════════════════════════════════════════════════════════════════
# DESIGN-TIME CONTROLS AND RESIDUAL RISK
#
# These are the controls recorded in the FMEA "current" and "recommended"
# columns. Modelling them explicitly lets a runtime action point back at the
# approved control it relies on, and lets a claim be made about the control
# rather than about the action.
#
# Residual risk is quantified for the two controls whose worksheet records a
# before-and-after judgement; the worksheet quantifies no residual risk for the
# others.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:CTRL_RadarGPSCrossCheck a cdm:Control ;
    warrant:hasIdentifier "CTRL-NAV-001" ;
    warrant:hasName "Cross-check of GNSS position and AIS targets against independent evidence" ;
    warrant:hasDescription "Standing bridge practice, automated by the navigation integrity service: the GNSS fix is checked against radar ranges and bearings to charted features, echo-sounder depth and dead reckoning, and AIS targets against radar echoes in range and bearing. The independent legs are radar range and bearing, depth and dead reckoning. Not independent: GPS No1 against GPS No2, own-ship GNSS against own-ship AIS, radar-derived latitude and longitude." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_AISSpoofing , ll1:Threat_GNSSSpoofing , ll1:HazHazardousAreaApproach ;
    cdm:hasResidualRisk ll1:ResidualRisk_SpoofingWithCrossCheck .

ll1:ResidualRisk_SpoofingWithCrossCheck a cdm:Risk ;
    warrant:hasName "Residual collision or grounding risk with the radar cross-check in force" ;
    warrant:hasDescription "The cross-check does not eliminate the exposure: it depends on the officer or the service performing it, on charted radar-conspicuous features being in range, and on the radar itself not being compromised. In open water with no features in range, only dead reckoning and the traffic divergence pattern remain." ;
    cdm:hasLikelihood          "0.15"^^xsd:decimal ;
    cdm:hasSafetyImpact        "0.95"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.70"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.85"^^xsd:decimal ;
    cdm:hasImpact              "0.95"^^xsd:decimal ;
    cdm:hasRiskLevel           "Medium" ;
    cdm:hasAcceptability       "ALARP" ;
    cdm:hasHazardClass         cdm:CYBER_THREAT .

ll1:CTRL_USBPortLocking a cdm:Control ;
    warrant:hasIdentifier "CTRL-CYB-002" ;
    warrant:hasName "USB port locking on navigation and automation OT" ;
    warrant:hasDescription "Physical port blockers on radar, ECDIS, GPS, AIS, VDR and BNWAS, recorded as a recommended control across the worksheet. Addresses the removable-media path but not the LAN path." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_ECDISCompromise , ll1:Threat_VDRTampering , ll1:Threat_AMSCompromise .

ll1:CTRL_BridgeRestrictedArea a cdm:Control ;
    warrant:hasIdentifier "CTRL-CYB-003" ;
    warrant:hasName "Bridge restricted area and visitor logging" ;
    warrant:hasDescription "The bridge is a restricted area with log entry for all non-crew personnel, monitored during audits and superintendence inspections. A detective control across all navigation OT." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_ECDISCompromise , ll1:Threat_VDRTampering .

ll1:CTRL_ServiceEngineerAccessControl a cdm:Control ;
    warrant:hasIdentifier "CTRL-CYB-004" ;
    warrant:hasName "Service-engineer-only access with authorisation codes" ;
    warrant:hasDescription "Configuration access to radar, ECDIS, gyrocompass, autopilot, speed log, AIS, BNWAS and VDR is restricted to the maker's service engineer and gated by authorisation codes, per the equipment inventory." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_ECDISCompromise .

ll1:CTRL_VDRIntegrityMonitoring a cdm:Control ;
    warrant:hasIdentifier "CTRL-VDR-005" ;
    warrant:hasName "Hash-based VDR record integrity monitoring" ;
    warrant:hasDescription "Periodic cryptographic verification of stored voyage data, so that erasure or modification is detected while the evidence may still be recoverable rather than at the point of investigation." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_VDRTampering ;
    cdm:hasResidualRisk ll1:ResidualRisk_VDRWithHashMonitoring .

ll1:ResidualRisk_VDRWithHashMonitoring a cdm:Risk ;
    warrant:hasName "Residual voyage-record evidence loss with integrity monitoring in force" ;
    cdm:hasLikelihood          "0.15"^^xsd:decimal ;
    cdm:hasSafetyImpact        "0.20"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.10"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.70"^^xsd:decimal ;
    cdm:hasImpact              "0.70"^^xsd:decimal ;
    cdm:hasRiskLevel           "Medium" ;
    cdm:hasAcceptability       "ALARP" ;
    cdm:hasHazardClass         cdm:CYBER_THREAT .

ll1:CTRL_PaperChartBackup a cdm:Control ;
    warrant:hasIdentifier "CTRL-NAV-006" ;
    warrant:hasName "Paper chart and celestial navigation backup" ;
    warrant:hasDescription "The SOLAS backup arrangement: a second ECDIS and paper charts, with celestial navigation and dead reckoning available when GNSS is lost. Adequate in open ocean for extended periods; the constraint is the coastal phase." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:HazLossOfNavigationPicture .

ll1:CTRL_RedundantCommunications a cdm:Control ;
    warrant:hasIdentifier "CTRL-COM-007" ;
    warrant:hasName "Redundant distress communication paths" ;
    warrant:hasDescription "Three VHF DSC sets, MF/HF, two Inmarsat-C terminals and FBB, so that no single compromised or misconfigured set removes distress alerting." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos marine superintendence" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_SatCommCompromise , ll1:HazLossOfDistressComms .

ll1:CTRL_AMSBackupAndLogMonitoring a cdm:Control ;
    warrant:hasIdentifier "CTRL-ELE-008" ;
    warrant:hasName "AMS data backup and log monitoring" ;
    warrant:hasDescription "Backup of alarm monitoring data to removable media with log monitoring, the existing control against the highest-RPN entry in the worksheet. The Chief Engineer is the responsible authority." ;
    warrant:hasVersion "1.0" ; warrant:approvedBy "Danaos technical department" ; warrant:hasApprovalStatus "APPROVED" ;
    cdm:mitigates ll1:Threat_AMSCompromise .

# The runtime advisories and procedures already in this file implement these
# approved controls; this is the link that lets a claim about a control be
# supported by evidence that the corresponding action was actually taken.
ll1:ActionCrossCheckRADARGPS    mit:implementsControl ll1:CTRL_RadarGPSCrossCheck .
ll1:ActionUSBLocker             mit:implementsControl ll1:CTRL_USBPortLocking .
ll1:ActionBridgeAccessRestriction mit:implementsControl ll1:CTRL_BridgeRestrictedArea .
ll1:ActionVDRHashMonitoring     mit:implementsControl ll1:CTRL_VDRIntegrityMonitoring .
ll1:ActionPaperChartsBackup     mit:implementsControl ll1:CTRL_PaperChartBackup .
ll1:ActionDeadReckoningFallback mit:implementsControl ll1:CTRL_PaperChartBackup .
ll1:ActionRedundantVHF          mit:implementsControl ll1:CTRL_RedundantCommunications .
ll1:ActionAMSBackupRestore      mit:implementsControl ll1:CTRL_AMSBackupAndLogMonitoring .

# Response strategy typing and default posture for the existing actions.
ll1:ActionCrossCheckRADARGPS      mit:hasStrategyType mit:ENHANCED_MONITORING ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionDualGPSCrossCheck       mit:hasStrategyType mit:ENHANCED_MONITORING ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionAlertMasterVSOC         mit:hasStrategyType mit:OPERATOR_ESCALATION ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionDeadReckoningFallback   mit:hasStrategyType mit:SAFE_DEGRADED_MODE ;  mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionPaperChartsBackup       mit:hasStrategyType mit:RECONFIGURATION ;     mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionVDRHashMonitoring       mit:hasStrategyType mit:ENHANCED_MONITORING ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionUSBLocker               mit:hasStrategyType mit:LOGICAL_ISOLATION ;   mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionBridgeAccessRestriction mit:hasStrategyType mit:LOGICAL_ISOLATION ;   mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionAMSBackupRestore        mit:hasStrategyType mit:RECOVERY ;            mit:hasDefaultPosture mit:FAIL_OPERATIONAL .
ll1:ActionRedundantVHF            mit:hasStrategyType mit:REDUNDANCY_ACTIVATION ; mit:hasDefaultPosture mit:FAIL_OPERATIONAL .

ll1:ActionAlertMasterVSOC   mit:requiresAuthorisationFrom ll1:NavigationOfficerRole .
ll1:ActionAMSBackupRestore  mit:requiresAuthorisationFrom ll1:ChiefEngineerRole .


# ═══════════════════════════════════════════════════════════════════════════════
# ASSURANCE DEGRADATION & SCORES
# ═══════════════════════════════════════════════════════════════════════════════

ll1:NavigationCyberDegradation a assr:AssuranceDegradation ;
    warrant:hasName "Navigation Information Integrity Degradation" ;
    warrant:hasDescription "Loss of trust in the information the navigation function runs on, own-ship position and traffic picture, while the equipment delivering it stays available." .

ll1:PositionDataIntegrityDegradation a assr:AssuranceDegradation ;
    warrant:hasName "Own-Ship Position Data Integrity Degradation" .

ll1:PositionSensorDegradation a assr:AssuranceDegradation ;
    warrant:hasName "Position and Heading Sensor Degradation" .

ll1:VDRIntegrityDegradation a assr:AssuranceDegradation ;
    warrant:hasName "VDR Data Integrity Degradation" .

ll1:CommAvailabilityDegradation a assr:AssuranceDegradation ;
    warrant:hasName "Communication Availability Degradation" .

ll1:AMSReliabilityDegradation a assr:AssuranceDegradation ;
    warrant:hasName "AMS Monitoring Reliability Degradation" .

ll1:DevGPSSpoofed                          assr:causesAssuranceDegradation ll1:PositionDataIntegrityDegradation , ll1:NavigationCyberDegradation .
ll1:DevOwnShipAISBroadcastWrong            assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .
ll1:DevSurroundingTrafficAISPositionsWrong assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .
ll1:DevSpoofedAIS            assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .
ll1:DevECDISSettingsModified assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .
ll1:DevGPSJammed             assr:causesAssuranceDegradation ll1:PositionSensorDegradation .
ll1:DevGyroSettingsModified  assr:causesAssuranceDegradation ll1:PositionSensorDegradation .
ll1:DevGyroInterfaceDisconnected assr:causesAssuranceDegradation ll1:PositionSensorDegradation .
ll1:DevSpeedlogModified      assr:causesAssuranceDegradation ll1:PositionSensorDegradation .
ll1:DevVDRDataModified       assr:causesAssuranceDegradation ll1:VDRIntegrityDegradation .
ll1:DevVDRDataNotStored      assr:causesAssuranceDegradation ll1:VDRIntegrityDegradation .
ll1:DevVHFSettingsModified   assr:causesAssuranceDegradation ll1:CommAvailabilityDegradation .
ll1:DevSatCommUnavailable    assr:causesAssuranceDegradation ll1:CommAvailabilityDegradation .
ll1:DevAMSDataCorrupted      assr:causesAssuranceDegradation ll1:AMSReliabilityDegradation .

# — Node dependability scores at 09:45:05
ll1:NavigationNodeScore a assr:AssuranceScore ;
    warrant:hasName "Navigation function node dependability score ND(t)" ;
    assr:hasScoreValue "0.32"^^xsd:decimal ;
    assr:usesCalculationMethod ll1:NodeScoreMethod_LL1 ;
    di:calculatedAt    "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:PositionDataNodeScore a assr:AssuranceScore ;
    warrant:hasName "Own-ship position data node dependability score ND(t)" ;
    assr:hasScoreValue "0.41"^^xsd:decimal ;
    assr:usesCalculationMethod ll1:NodeScoreMethod_LL1 ;
    di:calculatedAt    "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:VDRAssuranceScore a assr:AssuranceScore ;
    warrant:hasName "Voyage recording function node dependability score ND(t)" ;
    assr:hasScoreValue "0.82"^^xsd:decimal ;
    assr:usesCalculationMethod ll1:NodeScoreMethod_LL1 ;
    di:calculatedAt    "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:CommAssuranceScore a assr:AssuranceScore ;
    warrant:hasName "Communication function node dependability score ND(t)" ;
    assr:hasScoreValue "0.82"^^xsd:decimal ;
    assr:usesCalculationMethod ll1:NodeScoreMethod_LL1 ;
    di:calculatedAt    "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:AMSAssuranceScore a assr:AssuranceScore ;
    warrant:hasName "Electrical and alarm function node dependability score ND(t)" ;
    assr:hasScoreValue "0.82"^^xsd:decimal ;
    assr:usesCalculationMethod ll1:NodeScoreMethod_LL1 ;
    di:calculatedAt    "2026-06-01T09:45:05Z"^^xsd:dateTime .

ll1:NavigationFunction      assr:hasAssuranceScore ll1:NavigationNodeScore .
ll1:OwnShipPositionData     assr:hasAssuranceScore ll1:PositionDataNodeScore .
ll1:VoyageRecordingFunction assr:hasAssuranceScore ll1:VDRAssuranceScore .
ll1:CommunicationFunction   assr:hasAssuranceScore ll1:CommAssuranceScore .
ll1:ElectricalAlarmFunction assr:hasAssuranceScore ll1:AMSAssuranceScore .

ll1:NavigationCyberDegradation       assr:updatesAssuranceScore ll1:NavigationNodeScore .
ll1:PositionDataIntegrityDegradation assr:updatesAssuranceScore ll1:PositionDataNodeScore .
ll1:PositionSensorDegradation        assr:updatesAssuranceScore ll1:NavigationNodeScore .
ll1:VDRIntegrityDegradation          assr:updatesAssuranceScore ll1:VDRAssuranceScore .
ll1:CommAvailabilityDegradation      assr:updatesAssuranceScore ll1:CommAssuranceScore .
ll1:AMSReliabilityDegradation        assr:updatesAssuranceScore ll1:AMSAssuranceScore .


# ═══════════════════════════════════════════════════════════════════════════════
# DEPENDABILITY INDEX (DI) — per node + system DI
#
# Five node indices: the four functions and the own-ship position data product.
# The position-data index takes part in propagation only; it is not aggregated
# into the system index, which would count the navigation exposure twice.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:DI_Method_LL1 a di:DICalculationMethod ;
    warrant:hasName "Risk-Propagation DI for LL1 Navigation/Comms OT" ;
    warrant:hasDescription "ND = Σ α·d over the node's attribute values; R = R0 + ρ·Σ w·R_source over admissible inbound edges (CYBER_THREAT, ρ = 0.50); DI = ND − β·R; DI_sys = Σ γ·DI over the function indices; node state = most severe attribute state; system state = most severe attribute state across critical nodes." ;
    warrant:hasVersion "1.0" .

ll1:DI_OwnShipPosition a di:DependabilityIndex ;
    di:hasDIValue            "0.29"^^xsd:decimal ;
    di:hasBetaWeight         "0.20"^^xsd:decimal ;
    di:hasAggregatedRiskValue "0.60"^^xsd:decimal ;
    di:hasPropagatedRisk     ll1:PositionDataCyberRisk ;
    di:performedBy           ll1:LL1_DependabilitySupervisor ;
    di:isRecordedIn          ll1:LL1_LDC ;
    di:calculatedAt          "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:UnsafeState .

ll1:DI_Navigation a di:DependabilityIndex ;
    di:hasDIValue            "0.20"^^xsd:decimal ;
    di:hasBetaWeight         "0.40"^^xsd:decimal ;
    di:hasAggregatedRiskValue "0.30"^^xsd:decimal ;
    di:hasPropagatedRisk     ll1:NavDataLossAndCyberRisk ;
    di:performedBy           ll1:LL1_DependabilitySupervisor ;
    di:isRecordedIn          ll1:LL1_LDC ;
    di:calculatedAt          "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:UnsafeState .

ll1:DI_VDR a di:DependabilityIndex ;
    di:hasDIValue            "0.80"^^xsd:decimal ;
    di:hasBetaWeight         "0.20"^^xsd:decimal ;
    di:hasAggregatedRiskValue "0.10"^^xsd:decimal ;
    di:hasPropagatedRisk     ll1:VDRCyberRisk ;
    di:performedBy           ll1:LL1_DependabilitySupervisor ;
    di:isRecordedIn          ll1:LL1_LDC ;
    di:calculatedAt          "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:NormalState .

ll1:DI_Communication a di:DependabilityIndex ;
    di:hasDIValue            "0.80"^^xsd:decimal ;
    di:hasBetaWeight         "0.20"^^xsd:decimal ;
    di:hasAggregatedRiskValue "0.10"^^xsd:decimal ;
    di:hasPropagatedRisk     ll1:CommCyberRisk ;
    di:performedBy           ll1:LL1_DependabilitySupervisor ;
    di:isRecordedIn          ll1:LL1_LDC ;
    di:calculatedAt          "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:NormalState .

ll1:DI_ElectricalAlarm a di:DependabilityIndex ;
    di:hasDIValue            "0.80"^^xsd:decimal ;
    di:hasBetaWeight         "0.20"^^xsd:decimal ;
    di:hasAggregatedRiskValue "0.10"^^xsd:decimal ;
    di:hasPropagatedRisk     ll1:ElectricalCyberRisk ;
    di:performedBy           ll1:LL1_DependabilitySupervisor ;
    di:isRecordedIn          ll1:LL1_LDC ;
    di:calculatedAt          "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:NormalState .

# The vessel-level index is the system DI: the weighted aggregation of the four
# function indices (weights ll1:GammaNav … ll1:GammaElec below).
ll1:DI_LL1_Composite a di:SystemDependabilityIndex ;
    di:hasSystemDIValue      "0.56"^^xsd:decimal ;
    di:hasTrendSlope         "-0.036"^^xsd:decimal ;
    di:hasResilienceMargin   "0.01"^^xsd:decimal ;
    di:usesConfiguration     ll1:LL1_SupervisionConfig ;
    di:performedBy           ll1:LL1_DependabilitySupervisor ;
    di:isReportedWith        ll1:LL1_AL_T1 ;
    di:isRecordedIn          ll1:LL1_LDC ;
    di:calculatedAt          "2026-06-01T09:45:05Z"^^xsd:dateTime ;
    di:usesCalculationMethod ll1:DI_Method_LL1 ;
    di:hasDIState            di:UnsafeState .

ll1:NavigationNodeScore    di:contributesTo ll1:DI_Navigation .
ll1:PositionDataNodeScore  di:contributesTo ll1:DI_OwnShipPosition .
ll1:VDRAssuranceScore      di:contributesTo ll1:DI_VDR .
ll1:CommAssuranceScore     di:contributesTo ll1:DI_Communication .
ll1:AMSAssuranceScore      di:contributesTo ll1:DI_ElectricalAlarm .

ll1:DI_Navigation      di:contributesToSystem ll1:DI_LL1_Composite .
ll1:DI_VDR             di:contributesToSystem ll1:DI_LL1_Composite .
ll1:DI_Communication   di:contributesToSystem ll1:DI_LL1_Composite .
ll1:DI_ElectricalAlarm di:contributesToSystem ll1:DI_LL1_Composite .

ll1:DI_OwnShipPosition di:appliesTo ll1:OwnShipPositionData .
ll1:DI_Navigation      di:appliesTo ll1:NavigationFunction .
ll1:DI_VDR             di:appliesTo ll1:VoyageRecordingFunction .
ll1:DI_Communication   di:appliesTo ll1:CommunicationFunction .
ll1:DI_ElectricalAlarm di:appliesTo ll1:ElectricalAlarmFunction .
ll1:DI_LL1_Composite   di:appliesTo ll1:ContainerVessel_LL1 .


# ═══════════════════════════════════════════════════════════════════════════════
# MITIGATION
# (Controls from FMEA "Current Controls" and "Recommended Controls" columns,
#  plus the WARRaNT LL1 GNSS spoofing rule, which the FMEA does not cover)
# ═══════════════════════════════════════════════════════════════════════════════

# — Rules
ll1:RuleGNSSSpoofing a mit:MitigationRule ;
    warrant:hasName "GNSS Spoofing Response Rule" ;
    warrant:hasDescription "WARRaNT LL1 baseline rule; the FMEA has no spoofing entry. Treat GNSS-derived position as unreliable while the equipment remains available: fix position by independent means (radar ranges and bearings to charted features, visual bearings, depth, dead reckoning); take the autopilot out of track control; treat AIS target positions as unverified and take collision avoidance on radar range and bearing; call the Master; report the interference to VTS or the coastal authority. Switching to GPS No2 or ECDIS No2 does not help, because both receive the same counterfeit signal." .

ll1:RuleAISSpoofing a mit:MitigationRule ;
    warrant:hasName "Direct AIS Spoofing Mitigation Rule" ;
    warrant:hasDescription "Secondary scenario. FMEA: Log monitoring / equipment inspection / bridge restricted area. Recommended: cross-check AIS with RADAR and GPS; alert Master and VSOC if discrepancy confirmed." .

ll1:RuleGPSJamming a mit:MitigationRule ;
    warrant:hasName "GPS Jamming Mitigation Rule" ;
    warrant:hasDescription "FMEA recommended: user awareness/training. Fallback: celestial/visual navigation, dead reckoning, dual GPS cross-check (which confirms a receiver fault, not the absence of interference)." .

ll1:RuleECDISSecurity a mit:MitigationRule ;
    warrant:hasName "ECDIS Settings Security Rule" ;
    warrant:hasDescription "FMEA: procedures available / paper charts. Recommended: USB locker, access restricted to service engineer, authorization codes, focused audit area." .

ll1:RuleVDRIntegrity a mit:MitigationRule ;
    warrant:hasName "VDR Data Integrity Rule" ;
    warrant:hasDescription "FMEA (RPN=180): procedures + log monitoring. Recommended: USB locker where applicable / job orders on maker's representatives. Hash-based integrity monitoring." .

ll1:RuleAMSSecurity a mit:MitigationRule ;
    warrant:hasName "AMS Security Rule (FMEA Highest RPN)" ;
    warrant:hasDescription "FMEA (RPN=315): back-up USB/CD + log monitoring. Recommended: user awareness/training/USB locker. Chief Engineer responsible." .

ll1:RuleCommSecurity a mit:MitigationRule ;
    warrant:hasName "Communication System Security Rule" ;
    warrant:hasDescription "FMEA: procedures / redundant systems (second VHF/Inmarsat). Recommended: restrict access, authorization codes, focused area during audit." .

ll1:DevGPSSpoofed                          mit:matchesRule ll1:RuleGNSSSpoofing .
ll1:DevOwnShipAISBroadcastWrong            mit:matchesRule ll1:RuleGNSSSpoofing .
ll1:DevSurroundingTrafficAISPositionsWrong mit:matchesRule ll1:RuleGNSSSpoofing .
ll1:DevSpoofedAIS            mit:matchesRule ll1:RuleAISSpoofing .
ll1:DevGPSJammed             mit:matchesRule ll1:RuleGPSJamming .
ll1:DevECDISSettingsModified mit:matchesRule ll1:RuleECDISSecurity .
ll1:DevECDISInterfaceModified mit:matchesRule ll1:RuleECDISSecurity .
ll1:DevVDRDataModified       mit:matchesRule ll1:RuleVDRIntegrity .
ll1:DevVDRDataNotStored      mit:matchesRule ll1:RuleVDRIntegrity .
ll1:DevAMSDataCorrupted      mit:matchesRule ll1:RuleAMSSecurity .
ll1:DevVHFSettingsModified   mit:matchesRule ll1:RuleCommSecurity .
ll1:DevSatCommUnavailable    mit:matchesRule ll1:RuleCommSecurity .

# — Actions
ll1:ActionCrossCheckRADARGPS a mit:AdvisoryAction ;
    warrant:hasName "Cross-Check AIS Targets and GNSS Position Against Radar" ;
    warrant:hasDescription "Advisory: compare AIS targets with radar echoes in range and bearing, and the GNSS fix with a radar fix on charted features. Do not act on AIS alone when a discrepancy is detected." .

ll1:ActionAlertMasterVSOC a mit:AdvisoryAction ;
    warrant:hasName "Alert Master and Vessel Security Officer (VSOC)" ;
    warrant:hasDescription "Advisory: notify the Master and the VSOC of suspected GNSS spoofing, AIS spoofing or another navigation cyber-attack; report GNSS interference to VTS or the coastal authority; open a cyber incident log per ISM Code." .

ll1:ActionDeadReckoningFallback a mit:FailoverProcedure ;
    warrant:hasName "Dead Reckoning / Celestial Navigation Fallback" ;
    warrant:hasDescription "Navigate by dead reckoning from the last verified fix with gyrocompass heading and speed-log speed, confirmed by visual or radar bearings or celestial observation. FMEA recommended fallback for GPS jamming; equally the fallback when GNSS is available but spoofed." .

ll1:ActionDualGPSCrossCheck a mit:AdvisoryAction ;
    warrant:hasName "Dual GPS Cross-Check (GPS No1 vs GPS No2)" ;
    warrant:hasDescription "Advisory: compare positions from GPS No1 (GP-170, SW 2051542-02.04) and GPS No2; divergence above 50 m indicates a fault in one receiver. Agreement is not evidence of a correct position: jamming and spoofing affect both receivers alike." .

ll1:ActionPaperChartsBackup a mit:FailoverProcedure ;
    warrant:hasName "Paper Chart Backup Navigation" ;
    warrant:hasDescription "Fallback to paper charts if both ECDIS units are unavailable or compromised. FMEA existing control for ECDIS failure. Bridge restricted area enforces access control." .

ll1:ActionVDRHashMonitoring a mit:AdvisoryAction ;
    warrant:hasName "VDR Hash-Based Integrity Monitoring" ;
    warrant:hasDescription "Recommended: periodically verify stored VDR data using cryptographic hash. Detect erasure or modification before evidence is lost. Supplement FMEA recommended USB locker." .

ll1:ActionUSBLocker a mit:AdvisoryAction ;
    warrant:hasName "USB Port Locking on Navigation OT Equipment" ;
    warrant:hasDescription "FMEA recommended control across RADAR, ECDIS, GPS, AIS, VDR, BNWAS. Physical USB port blockers prevent unauthorised media insertion. Applied by Navigation Officer." .

ll1:ActionBridgeAccessRestriction a mit:AdvisoryAction ;
    warrant:hasName "Bridge Restricted Area Access Control" ;
    warrant:hasDescription "FMEA detective control across all navigation OT. Bridge treated as restricted area; log entry of all non-crew personnel. Monitored during audits / superintendence inspections." .

ll1:ActionAMSBackupRestore a mit:FailoverProcedure ;
    warrant:hasName "AMS Data Backup and Restore (USB/CD)" ;
    warrant:hasDescription "FMEA existing control (RPN=315): back-up USB/CD of AMS monitoring data. Chief Engineer responsible. Post-incident restore from backup if data corruption detected." .

ll1:ActionRedundantVHF a mit:FailoverProcedure ;
    warrant:hasName "Switch to Redundant VHF (No2 or No3)" ;
    warrant:hasDescription "FMEA existing control: second VHF available. Immediately switch to VHF No2 or No3 (FM-8900S) if VHF No1 settings are compromised." .

ll1:RuleGNSSSpoofing mit:recommends ll1:RevertToIndependentNavigationAction , ll1:ActionDeadReckoningFallback ,
                                    ll1:ReduceSpeedIncreaseCPAAction , ll1:ActionAlertMasterVSOC .
ll1:RuleAISSpoofing  mit:recommends ll1:ActionCrossCheckRADARGPS , ll1:ActionAlertMasterVSOC ,
                                    ll1:IsolateAISOverlayAction , ll1:ReduceSpeedIncreaseCPAAction .
ll1:RuleGPSJamming   mit:recommends ll1:ActionDeadReckoningFallback .
ll1:RuleGPSJamming   mit:recommends ll1:ActionDualGPSCrossCheck .
ll1:RuleECDISSecurity mit:recommends ll1:ActionPaperChartsBackup .
ll1:RuleECDISSecurity mit:recommends ll1:ActionUSBLocker .
ll1:RuleECDISSecurity mit:recommends ll1:ActionBridgeAccessRestriction .
ll1:RuleVDRIntegrity mit:recommends ll1:ActionVDRHashMonitoring .
ll1:RuleVDRIntegrity mit:recommends ll1:ActionUSBLocker .
ll1:RuleAMSSecurity  mit:recommends ll1:ActionAMSBackupRestore .
ll1:RuleAMSSecurity  mit:recommends ll1:ActionUSBLocker .
ll1:RuleCommSecurity mit:recommends ll1:ActionRedundantVHF .
ll1:RuleCommSecurity mit:recommends ll1:ActionBridgeAccessRestriction .

ll1:ActionCrossCheckRADARGPS    mit:addresses ll1:Link_AIS_NavBus , ll1:OwnShipPositionData .
ll1:ActionDeadReckoningFallback mit:addresses ll1:NavigationFunction .
ll1:ActionPaperChartsBackup     mit:addresses ll1:NavigationFunction .
ll1:ActionVDRHashMonitoring     mit:addresses ll1:VDR .
ll1:ActionRedundantVHF          mit:addresses ll1:CommunicationFunction .
ll1:ActionAMSBackupRestore      mit:addresses ll1:AlarmMonitoringSystem .


# ═══════════════════════════════════════════════════════════════════════════════
# RUNTIME SUPERVISION LAYER — WARRaNT LL1 BASELINE
#
# The attribute values, weights, thresholds, management floor, trend window,
# damping factor, decision weights and assurance weights below are defined by
# WARRaNT for the LL1 demonstrator, not taken from Danaos documents, and are
# approved as the LL1 baseline (warrant:hasApprovalStatus "APPROVED",
# warrant:approvedBy "WARRaNT LL1 use-case team").
#
# Availability and integrity are kept apart. The Availability attribute is
# assessed from equipment and data-feed delivery; the integrity of what is
# delivered is carried by the Cybersecurity attribute (adversarial
# falsification), the Reliability attribute (continuity of a correct position
# solution) and the Safety attribute (consequence). Under spoofing,
# availability stays Normal while the others collapse.
#
# Derivation at T1 = 09:45:05 (formulas in ll1:DI_Method_LL1):
#   ND_pos  = 0.6·0.05 + 0.4·0.95                      = 0.41
#   ND_nav  = 0.4·0.20 + 0.2·0.05 + 0.2·0.90 + 0.2·0.25 = 0.32
#   ND_vdr  = 0.2·0.80 + 0.4·0.80 + 0.2·0.85 + 0.2·0.85 = 0.82
#   ND_comm = 0.2·0.80 + 0.3·0.80 + 0.4·0.85 + 0.1·0.80 = 0.82
#   ND_elec = 0.4·0.80 + 0.4·0.80 + 0.1·0.90 + 0.1·0.90 = 0.82
#   R_pos   = 0.60 (local; no inbound edge)   R_comm = R_vdr = R_elec = 0.10
#   R_nav   = 0.09 + 0.50·(0.60·0.60 + 0.60·0.10)      = 0.30
#   DI_pos  = 0.41 − 0.20·0.60 = 0.29    DI_nav  = 0.32 − 0.40·0.30 = 0.20
#   DI_vdr  = DI_comm = DI_elec = 0.82 − 0.20·0.10     = 0.80
#   DI_sys  = 0.4·0.20 + 0.1·0.80 + 0.2·0.80 + 0.3·0.80 = 0.56
#   margin  = 0.56 − 0.55 = +0.01
#   slope   = (0.56 − 0.776) / 6 h = −0.036 per hour; DI_sys at 03:45 was
#             0.4·0.74 + 0.48 = 0.776. Below the 0.05 per hour threshold: a
#             sudden integrity loss is not a sustained decline, so no
#             sustained-decline trigger. The attribute breach and the
#             predicted floor crossing raise it instead.
#   state   = Unsafe (navigation cybersecurity attribute 0.05 < 0.10), while
#             DI_sys is still above the floor: state and index are separate.
#   AL      = 0.3·0.50 + 0.2·0.70 + 0.2·0.80 + 0.15·0.60 + 0.15·0.80 = 0.66
#   CR      = (0.66 + 0.50)/2 − 0.5·0.30 = 0.43
# ═══════════════════════════════════════════════════════════════════════════════

# ── Calculation methods and the supervising agents ────────────────────────

ll1:NodeScoreMethod_LL1 a warrant:CalculationMethod ;
    warrant:hasName "Mode-weighted node dependability score" ; warrant:hasVersion "1.0" .

ll1:AssuranceLevelMethod_LL1 a warrant:CalculationMethod ;
    warrant:hasName "Weighted evidence-confidence index (EC, EF, EQ, MC, TC)" ;
    warrant:hasDescription "AL = Σ ω·(EC, EF, EQ, MC, TC). EC is the share of declared evidence obligations that are PRESENT." ;
    warrant:hasVersion "1.0" .

ll1:ReadinessMethod_LL1 a warrant:CalculationMethod ;
    warrant:hasName "Certification readiness mapping g(AL, RC, NSI)" ;
    warrant:hasDescription "Readiness = (AL + RC)/2 − 0.5·NSI. RC is the share of requirements whose expected evidence obligations are all PRESENT. NSI is the sum of unresolved nonconformity severities (MAJOR 0.8, MINOR 0.4) divided by the number of requirements in the case." ;
    warrant:hasVersion "1.0" ; warrant:hasApprovalStatus "APPROVED" ; warrant:approvedBy "WARRaNT LL1 use-case team" .

ll1:LL1_DependabilitySupervisor a di:DependabilitySupervisor ;
    warrant:hasName "LL1 Dependability Supervisor" ;
    di:usesConfiguration ll1:LL1_SupervisionConfig .

ll1:LL1_REDS a mit:DecisionSupportService ;
    warrant:hasName "LL1 Risk Evaluation and Decision Support" .

ll1:LL1_IRDS a mit:ResilienceSupervisor ;
    warrant:hasName "LL1 Intelligent Resilience and Dependability Supervisor" .

# ── Node health monitors ──────────────────────────────────────────────────

ll1:NavigationNodeHealthMonitor a obs:NodeHealthMonitor ;
    warrant:hasName "Navigation Function Node Health Monitor" ;
    warrant:hasDescription "Function-level monitor: fuses the navigation integrity cross-checks and the bridge equipment status into the navigation function's attribute vector, keeping equipment availability apart from information integrity." ;
    obs:monitorsNode ll1:NavigationFunction ; obs:hasMonitoringLevel obs:FUNCTION_LEVEL .

ll1:GPSNodeHealthMonitor a obs:NodeHealthMonitor ;
    warrant:hasName "GPS Receiver and Position Data Node Health Monitor" ;
    warrant:hasDescription "Component-level monitor of GPS No1 and the position data it produces: fix status, sentence rate and receiver alarms. It reports the position data as available throughout the spoofing; integrity comes from the navigation integrity service." ;
    obs:monitorsNode ll1:GPS_1 , ll1:OwnShipPositionData ; obs:hasMonitoringLevel obs:COMPONENT_LEVEL ;
    obs:exchangesHealthEventWith ll1:NavigationNodeHealthMonitor .

ll1:VDRNodeHealthMonitor a obs:NodeHealthMonitor ;
    warrant:hasName "Voyage Recording Node Health Monitor" ;
    obs:monitorsNode ll1:VoyageRecordingFunction ; obs:hasMonitoringLevel obs:FUNCTION_LEVEL .

ll1:CommunicationNodeHealthMonitor a obs:NodeHealthMonitor ;
    warrant:hasName "Communication Function Node Health Monitor" ;
    obs:monitorsNode ll1:CommunicationFunction ; obs:hasMonitoringLevel obs:FUNCTION_LEVEL ;
    obs:exchangesHealthEventWith ll1:NavigationNodeHealthMonitor .

ll1:ElectricalNodeHealthMonitor a obs:NodeHealthMonitor ;
    warrant:hasName "Electrical and Alarm Node Health Monitor" ;
    obs:monitorsNode ll1:ElectricalAlarmFunction ; obs:hasMonitoringLevel obs:FUNCTION_LEVEL .

ll1:VesselNodeHealthMonitor a obs:NodeHealthMonitor ;
    warrant:hasName "Vessel System-Level Node Health Monitor" ;
    obs:monitorsNode ll1:ContainerVessel_LL1 ; obs:hasMonitoringLevel obs:SYSTEM_LEVEL ;
    obs:exchangesHealthEventWith ll1:NavigationNodeHealthMonitor , ll1:VDRNodeHealthMonitor ,
                                 ll1:CommunicationNodeHealthMonitor , ll1:ElectricalNodeHealthMonitor .

# ── Health-event records ──────────────────────────────────────────────────

ll1:GPSSpoofingDetectionEvent
    warrant:hasIdentifier "HE-LL1-20260601-0001" ;
    obs:hasSource ll1:NavigationIntegrityService ;
    obs:affectsAsset ll1:GPS_1 , ll1:GPS_2 , ll1:OwnShipPositionData , ll1:ECDIS_1 , ll1:AIS_Transponder , ll1:Autopilot , ll1:NavigationFunction ;
    obs:indicatesCondition ll1:Threat_GNSSSpoofing , ll1:HazHazardousAreaApproach ;
    obs:hasConfidenceValue "0.80"^^xsd:decimal ;
    obs:hasSeverityLevel "CRITICAL" ;
    obs:isPersistent true ;
    obs:hasOperationalImpact "Own-ship position not trustworthy while GNSS, ECDIS and AIS all remain available: the chart position, the autopilot track and the position broadcast over AIS are all affected." ;
    obs:hasRootCause ll1:Vul_UnauthenticatedGNSSSignal ;
    obs:hasMissionContext ll1:GNSSInterferenceAreaCondition ;
    obs:hasControlStatus "UNCONTROLLED" ;
    obs:hasTrendIndicator "DECLINING" .

ll1:SurroundingTrafficGNSSCorruptionEvent
    warrant:hasIdentifier "HE-LL1-20260601-0002" ;
    obs:hasSource ll1:NavigationIntegrityService ;
    obs:affectsAsset ll1:AIS_Transponder , ll1:SurroundingTrafficAISReports , ll1:ECDIS_1 , ll1:NavigationFunction ;
    obs:indicatesCondition ll1:Threat_GNSSSpoofing , ll1:HazHazardousAreaApproach ;
    obs:hasConfidenceValue "0.75"^^xsd:decimal ;
    obs:hasSeverityLevel "HIGH" ;
    obs:isPersistent true ;
    obs:hasOperationalImpact "Traffic picture not trustworthy: the AIS positions of most surrounding vessels are wrong at source, so collision-avoidance decisions cannot be taken on the AIS overlay." ;
    obs:hasRootCause ll1:Threat_GNSSSpoofing ;
    obs:hasMissionContext ll1:HighTrafficDensityCondition ;
    obs:hasControlStatus "UNCONTROLLED" ;
    obs:hasTrendIndicator "DECLINING" .

ll1:AISSpoofingDetectionEvent
    warrant:hasIdentifier "HE-LL1-20260523-0001" ;
    obs:hasSource ll1:IDSAnalyticalService ;
    obs:affectsAsset ll1:AIS_Transponder , ll1:ECDIS_1 , ll1:NavigationFunction ;
    obs:indicatesCondition ll1:Threat_AISSpoofing , ll1:HazHazardousAreaApproach ;
    obs:hasConfidenceValue "0.85"^^xsd:decimal ;
    obs:hasSeverityLevel "HIGH" ;
    obs:isPersistent false ;
    obs:hasOperationalImpact "Traffic picture partly counterfeit; own-ship position unaffected." ;
    obs:hasRootCause ll1:Vul_UnauthenticatedAISBroadcast ;
    obs:hasMissionContext ll1:CoastalApproachSegment ;
    obs:hasControlStatus "MITIGATED" ;
    obs:hasTrendIndicator "STABLE" .

ll1:AMSDataCorruptionEvent
    warrant:hasIdentifier "HE-LL1-20260507-0001" ;
    obs:hasSource ll1:IDSAnalyticalService ;
    obs:affectsAsset ll1:AlarmMonitoringSystem , ll1:ElectricalAlarmFunction ;
    obs:indicatesCondition ll1:Threat_AMSCompromise , ll1:HazUnmonitoredEngineRoom ;
    obs:hasConfidenceValue "0.70"^^xsd:decimal ;
    obs:hasSeverityLevel "CRITICAL" ;
    obs:isPersistent false ;
    obs:hasOperationalImpact "Engine room alarm state could not be trusted until the AMS data was restored from backup." ;
    obs:hasRootCause ll1:FM_AMSDataChange ;
    obs:hasControlStatus "MITIGATED" ;
    obs:hasTrendIndicator "STABLE" .

ll1:VDRDataTamperEvent
    warrant:hasIdentifier "HE-LL1-20260529-0001" ;
    obs:hasSource ll1:VDRHealthService ;
    obs:affectsAsset ll1:VDR , ll1:VoyageRecordingFunction ;
    obs:indicatesCondition ll1:Threat_VDRTampering , ll1:HazLossOfVDREvidence ;
    obs:hasConfidenceValue "0.90"^^xsd:decimal ;
    obs:hasSeverityLevel "HIGH" ;
    obs:isPersistent false ;
    obs:hasOperationalImpact "Part of the voyage record for the affected period cannot be relied on for investigation." ;
    obs:hasRootCause ll1:Threat_VDRTampering ;
    obs:hasControlStatus "MITIGATED" ;
    obs:hasTrendIndicator "STABLE" .

ll1:NavigationNodeHealthMonitor obs:producesHealthEvent ll1:GPSSpoofingDetectionEvent , ll1:SurroundingTrafficGNSSCorruptionEvent , ll1:AISSpoofingDetectionEvent .
ll1:ElectricalNodeHealthMonitor obs:producesHealthEvent ll1:AMSDataCorruptionEvent .
ll1:VDRNodeHealthMonitor        obs:producesHealthEvent ll1:VDRDataTamperEvent .

# ── Attributes, mode-scoped weights and per-node state thresholds ─────────

ll1:NavSafetyAttribute   a assr:Safety        ; warrant:hasName "Navigation — safety"@en .
ll1:NavCyberAttribute    a assr:Cybersecurity ; warrant:hasName "Navigation — cybersecurity (information integrity)"@en .
ll1:NavAvailAttribute    a assr:Availability  ; warrant:hasName "Navigation — availability (equipment and feeds)"@en .
ll1:NavRelAttribute      a assr:Reliability   ; warrant:hasName "Navigation — reliability (correct position solution)"@en .
ll1:PosCyberAttribute    a assr:Cybersecurity ; warrant:hasName "Own-ship position data — integrity"@en .
ll1:PosAvailAttribute    a assr:Availability  ; warrant:hasName "Own-ship position data — availability"@en .
ll1:VDRSafetyAttribute   a assr:Safety        ; warrant:hasName "Voyage recording — safety"@en .
ll1:VDRCyberAttribute    a assr:Cybersecurity ; warrant:hasName "Voyage recording — cybersecurity"@en .
ll1:VDRAvailAttribute    a assr:Availability  ; warrant:hasName "Voyage recording — availability"@en .
ll1:VDRRelAttribute      a assr:Reliability   ; warrant:hasName "Voyage recording — reliability"@en .
ll1:CommSafetyAttribute  a assr:Safety        ; warrant:hasName "Communication — safety"@en .
ll1:CommCyberAttribute   a assr:Cybersecurity ; warrant:hasName "Communication — cybersecurity"@en .
ll1:CommAvailAttribute   a assr:Availability  ; warrant:hasName "Communication — availability"@en .
ll1:CommRelAttribute     a assr:Reliability   ; warrant:hasName "Communication — reliability"@en .
ll1:ElecSafetyAttribute  a assr:Safety        ; warrant:hasName "Electrical and alarm — safety"@en .
