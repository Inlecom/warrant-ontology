ll1:V_CommRel a assr:AssuranceAttributeValue ; assr:hasAttributeValueNumber "0.80"^^xsd:decimal ; assr:hasSourceConfidence "0.85"^^xsd:decimal ; assr:hasValueSource ll1:CommunicationNodeHealthMonitor ; assr:assessedAt "2026-06-01T09:45:05Z"^^xsd:dateTime ; di:hasAttributeState di:NormalState .
ll1:V_ElecSafety a assr:AssuranceAttributeValue ; assr:hasAttributeValueNumber "0.80"^^xsd:decimal ; assr:hasSourceConfidence "0.80"^^xsd:decimal ; assr:hasValueSource ll1:ElectricalNodeHealthMonitor ; assr:assessedAt "2026-06-01T09:45:05Z"^^xsd:dateTime ; di:hasAttributeState di:NormalState .
ll1:V_ElecCyber a assr:AssuranceAttributeValue ; assr:hasAttributeValueNumber "0.80"^^xsd:decimal ; assr:hasSourceConfidence "0.75"^^xsd:decimal ; assr:hasValueSource ll1:IDSAnalyticalService ; assr:assessedAt "2026-06-01T09:45:05Z"^^xsd:dateTime ; di:hasAttributeState di:NormalState .
ll1:V_ElecAvail a assr:AssuranceAttributeValue ; assr:hasAttributeValueNumber "0.90"^^xsd:decimal ; assr:hasSourceConfidence "0.85"^^xsd:decimal ; assr:hasValueSource ll1:ElectricalNodeHealthMonitor ; assr:assessedAt "2026-06-01T09:45:05Z"^^xsd:dateTime ; di:hasAttributeState di:NormalState .
