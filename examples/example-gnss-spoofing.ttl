# ═══════════════════════════════════════════════════════════════════════════════
# BRIDGE NETWORK — Communication Links (from Diagram 2)
# ═══════════════════════════════════════════════════════════════════════════════

# — LAN segment (Radar ↔ ECDIS backbone — primary navigation data bus)
ll1:Link_RadarECDIS_LAN a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-RAD-ECDIS-LAN" ;
    warrant:hasName "Radar–ECDIS LAN Link" ;
    davom:hasInterfaceType davom:LAN ;
    warrant:hasDescription "Carries X-band Radar ↔ S-band Radar ↔ No1/No2 ECDIS target and overlay data. Highest-bandwidth navigation data bus. LAN exposure: shared with other bridge systems — potential lateral movement path." .

# — GPS serial bus (GPS → many receivers)
ll1:Link_GPS_NavBus a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-GPS-NAVBUS" ;
    warrant:hasName "GPS Serial Navigation Bus" ;
    davom:hasInterfaceType davom:SERIAL ;
    warrant:hasDescription "IEC-61162 / NMEA 0183. GPS No1/No2 position data distributed to X/S Radars, ECDIS, Gyrocompass, Autopilot, Speedlog, VDR, VHF, MF/HF, INM-C, Navtex. A spoofed or jammed fix reaches every listener on the bus at once; the bus itself is not the attack surface, the radio signal received by the GPS antennas is." .

# — Gyrocompass serial bus
ll1:Link_Gyro_NavBus a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-GYR-NAVBUS" ;
    warrant:hasName "Gyrocompass Serial Distribution Bus" ;
    davom:hasInterfaceType davom:SERIAL ;
    warrant:hasDescription "IEC-61162. Gyrocompass heading distributed to X/S Radars, ECDIS, Autopilot, AIS, Course recorder, Speedlog, VDR, Inmarsat GX, CX-100. Compromise propagates to all heading-dependent subsystems." .

# — AIS serial link (bidirectional with ECDIS and Radars)
ll1:Link_AIS_NavBus a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-AIS-NAVBUS" ;
    warrant:hasName "AIS–Navigation Serial Link" ;
    davom:hasInterfaceType davom:SERIAL ;
    warrant:hasDescription "IEC-61162. AIS data (own-ship identity, target positions) distributed to X/S Radars, ECDIS No1, VDR. AIS transponder also receives GPS, Gyrocompass, Speedlog. The VHF side is an open protocol with no authentication (the direct AIS spoofing vector); authentication would not help against a genuine message whose position was wrong at the transmitting vessel's GNSS." .

# — VDR data collection links
ll1:Link_VDR_Serial a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-VDR-SERIAL" ;
    warrant:hasName "VDR Serial/Contact Collection Link" ;
    davom:hasInterfaceType davom:SERIAL_CONTACT ;
    warrant:hasDescription "VDR collects from GPS, Gyrocompass, AIS, Speedlog, Autopilot, Echosounder, Anemometer (SERIAL), and Engine control system, Watertight door, Hull door, Hull stress monitoring, AMS (SERIAL+CONTACT)." .

ll1:Link_VDR_AudioVideo a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-VDR-AV" ;
    warrant:hasName "VDR Audio-Video Collection Link" ;
    davom:hasInterfaceType davom:VIDEO ;
    warrant:hasDescription "S-band Radar image (VIDEO) and VHF channels and bridge microphones (AUDIO) captured by VDR. Tampering with VDR audio/video input blocks accident investigation evidence." .

# — Satellite/shore communications LAN
ll1:Link_SatComm_LAN a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-SAT-LAN" ;
    warrant:hasName "Satellite Communication LAN (IT/OT Boundary)" ;
    davom:hasInterfaceType davom:LAN ;
    warrant:hasDescription "Inmarsat GX and FBB-500 connect to Communications PC via LAN. Key IT/OT boundary: shore-based internet traffic reaches this LAN. Both GX and FBB run Linux with no antivirus/firewall (per makers' inventory). Principal external attack ingress path." .

# — BNWAS → AMS link
ll1:Link_BNWAS_AMS a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-BNWAS-AMS" ;
    warrant:hasName "BNWAS–AMS Serial Link" ;
    davom:hasInterfaceType davom:SERIAL ;
    warrant:hasDescription "BNWAS bridge watch alarm status reported to AMS. Failure of this link can mask watch alarm suppression." .

# — AIS VHF data link: the radio side of the AIS transponder, shared with every
#   AIS station in range. Outside the vessel's boundary.
ll1:Link_AIS_VHFDataLink a davom:CommunicationLink ;
    warrant:hasIdentifier "LINK-AIS-VDL" ;
    warrant:hasName "AIS VHF Data Link (CH 87B/88B)" ;
    davom:hasInterfaceType davom:WIRELESS ;
    warrant:hasDescription "The shared VHF data link over which the AIS transponder broadcasts own-ship reports and receives the reports of surrounding vessels. Open and unauthenticated." .


# ═══════════════════════════════════════════════════════════════════════════════
# POSITION DATA FLOWS
#
# The GNSS-derived position is modelled as a data product in its own right, so
# the KG can trace GNSS receiver → position data → consumers → navigation
# function. Surrounding vessels are represented at data-flow level rather than
# as vessel models: what matters to this vessel is that their AIS reports carry
# a position produced by their own GNSS receiver, which the same area-wide
# spoofing can corrupt.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:OwnShipPositionData a davom:DataFlow ;
    warrant:hasIdentifier "DF-POS-OWN" ;
    warrant:hasName "Own-ship GNSS position data" ;
    davom:hasInterfaceType davom:SERIAL ;
    warrant:hasDescription "Position, course and speed over ground and time from GPS No1 (or No2), distributed over the IEC 61162 GPS bus to ECDIS, radars, AIS, autopilot, gyrocompass, speed log, VDR and the GMDSS radios. Its availability (sentences arriving with a valid-fix flag) and its integrity (the position being true) are separate properties: spoofing leaves the first intact and destroys the second." .

ll1:OwnShipAISBroadcast a davom:DataFlow ;
    warrant:hasIdentifier "DF-AIS-OWN" ;
    warrant:hasName "Own-ship AIS position reports (transmitted)" ;
    davom:hasInterfaceType davom:WIRELESS ;
    warrant:hasDescription "The position reports this vessel's AIS transponder broadcasts to surrounding vessels and shore stations. The position in them is the own-ship GNSS position; if that is spoofed, the broadcast is wrong while the transponder works correctly." .

ll1:SurroundingVesselGNSSPositionData a davom:DataFlow ;
    warrant:hasIdentifier "DF-POS-TRAFFIC" ;
    warrant:hasName "Surrounding vessels' GNSS position data (external)" ;
    warrant:hasDescription "The position each surrounding vessel's own GNSS receiver supplies to its AIS transponder. Outside this vessel's boundary and not observable directly; it reaches this vessel only through their AIS reports. Exposed to the same area-wide spoofing signal as own-ship GNSS." .

ll1:SurroundingTrafficAISReports a davom:DataFlow ;
    warrant:hasIdentifier "DF-AIS-TRAFFIC" ;
    warrant:hasName "Surrounding traffic AIS position reports (received)" ;
    davom:hasInterfaceType davom:WIRELESS ;
    warrant:hasDescription "AIS position reports received from surrounding vessels. A report can be authentic at the protocol and transmitter level (the genuine vessel, a well-formed message, a consistent identity and history) and still carry a wrong position, because the transmitting vessel's GNSS source is corrupted. Counterfeit reports (direct AIS spoofing) are a different condition." .

ll1:Link_GPS_NavBus       davom:carriesDataFlow ll1:OwnShipPositionData .
ll1:Link_AIS_VHFDataLink  davom:carriesDataFlow ll1:OwnShipAISBroadcast , ll1:SurroundingTrafficAISReports .
ll1:OwnShipPositionData   davom:usesCommunicationLink ll1:Link_GPS_NavBus .
ll1:OwnShipAISBroadcast   davom:usesCommunicationLink ll1:Link_AIS_VHFDataLink .
ll1:SurroundingTrafficAISReports davom:usesCommunicationLink ll1:Link_AIS_VHFDataLink .
ll1:GPS_1                 davom:hasDataFlow ll1:OwnShipPositionData .
ll1:GPS_2                 davom:hasDataFlow ll1:OwnShipPositionData .
ll1:AIS_Transponder       davom:hasDataFlow ll1:OwnShipAISBroadcast , ll1:SurroundingTrafficAISReports .
ll1:NavigationFunction    davom:hasDataFlow ll1:OwnShipPositionData , ll1:SurroundingTrafficAISReports .

# — Function ↔ link associations
ll1:NavigationFunction      davom:usesCommunicationLink ll1:Link_RadarECDIS_LAN .
ll1:NavigationFunction      davom:usesCommunicationLink ll1:Link_GPS_NavBus .
ll1:NavigationFunction      davom:usesCommunicationLink ll1:Link_Gyro_NavBus .
ll1:NavigationFunction      davom:usesCommunicationLink ll1:Link_AIS_NavBus .
ll1:NavigationFunction      davom:usesCommunicationLink ll1:Link_AIS_VHFDataLink .
ll1:VoyageRecordingFunction davom:usesCommunicationLink ll1:Link_VDR_Serial .
ll1:VoyageRecordingFunction davom:usesCommunicationLink ll1:Link_VDR_AudioVideo .
ll1:CommunicationFunction   davom:usesCommunicationLink ll1:Link_SatComm_LAN .
ll1:ElectricalAlarmFunction davom:usesCommunicationLink ll1:Link_BNWAS_AMS .


# ═══════════════════════════════════════════════════════════════════════════════
# HUMAN OPERATOR ROLES
# ═══════════════════════════════════════════════════════════════════════════════

ll1:NavigationOfficerRole a davom:HumanOperatorRole ;
    warrant:hasName "Navigation Officer" ;
    warrant:hasDescription "Officer responsible for safe navigation using ECDIS, RADAR, and chart systems. Responsible authority for navigation OT FMEA controls." .

ll1:ChiefEngineerRole a davom:HumanOperatorRole ;
    warrant:hasName "Chief Engineer" ;
    warrant:hasDescription "Responsible for AMS, M/E remote control, power management, and electrical OT. Responsible authority for electrical/automation OT FMEA controls." .

ll1:ElectricalDeptRole a davom:HumanOperatorRole ;
    warrant:hasName "Electrical Department Officer" ;
    warrant:hasDescription "Responsible for fire detection, general alarm, MF/HF, and Inmarsat-C maintenance." .

ll1:NavigationFunction      davom:requiresOperatorRole ll1:NavigationOfficerRole .
ll1:CommunicationFunction   davom:requiresOperatorRole ll1:NavigationOfficerRole .
ll1:VoyageRecordingFunction davom:requiresOperatorRole ll1:NavigationOfficerRole .
ll1:ElectricalAlarmFunction davom:requiresOperatorRole ll1:ChiefEngineerRole .
ll1:ElectricalAlarmFunction davom:requiresOperatorRole ll1:ElectricalDeptRole .


# ═══════════════════════════════════════════════════════════════════════════════
# METRICS
# ═══════════════════════════════════════════════════════════════════════════════

# — Own-ship position integrity metrics (primary scenario). Each compares the
#   GNSS-derived position with evidence that does not come from GNSS.
ll1:GNSSRadarFixResidualMetric a obs:SafetyMetric ;
    warrant:hasName "Own-ship GNSS position vs radar fix on charted features" ;
    warrant:hasDescription "Distance between the GNSS fix and the fix from radar ranges and bearings to charted, radar-conspicuous features. Independent of GNSS provided the radar measurements are used in range and bearing, not as geo-referenced latitude and longitude. Requires charted features within radar range." ;
    obs:hasUnit "m" ;
    obs:hasExternalTimeSeriesId "timeseries.nav.gnss_radar_fix_residual.LL1" .

ll1:GNSSDeadReckoningResidualMetric a obs:SafetyMetric ;
    warrant:hasName "Own-ship GNSS position vs dead reckoning" ;
    warrant:hasDescription "Divergence between the GNSS track and the dead-reckoning track from gyro heading and speed-log speed through water since the last verified fix. Sensitive to a slow drag-off that a jump detector misses; the tolerance grows with set, drift and time since the fix." ;
    obs:hasUnit "m" ;
    obs:hasExternalTimeSeriesId "timeseries.nav.gnss_dr_residual.LL1" .

ll1:DepthConsistencyMetric a obs:SafetyMetric ;
    warrant:hasName "Echo-sounder depth vs charted depth at the GNSS position" ;
    obs:hasUnit "m" ;
    obs:hasExternalTimeSeriesId "timeseries.nav.depth_consistency.LL1" .

ll1:GPSPositionConsistencyMetric a obs:DataQualityMetric ;
    warrant:hasName "GPS No1 vs GPS No2 position agreement" ;
    warrant:hasDescription "Detects a fault in one receiver. Both receivers see the same radio environment, so their agreement is not evidence of a correct position under jamming or spoofing." ;
    obs:hasUnit "m" ;
    obs:hasExternalTimeSeriesId "timeseries.gps.position_consistency.LL1" .

ll1:NavigationPositionConfidenceMetric a obs:SafetyMetric ;
    warrant:hasName "Fused own-ship position confidence" ;
    warrant:hasDescription "Confidence in the own-ship position used for conning, fused from the independent residuals above. Falls under spoofing while every equipment availability metric stays high." ;
    obs:hasUnit "ratio" ;
    obs:hasExternalTimeSeriesId "timeseries.nav.position_confidence.LL1" .

# — Traffic picture integrity metrics
ll1:AISPositionIntegrityMetric a obs:CybersecurityMetric ;
    warrant:hasName "AIS target vs radar track divergence (range and bearing frame)" ;
    warrant:hasDescription "Per-target divergence between the AIS-reported position and the associated radar track, compared as range and bearing from own ship so that the radar side does not inherit own-ship GNSS error." ;
    obs:hasUnit "m" ;
    obs:hasExternalTimeSeriesId "timeseries.ais.position_integrity.LL1" .

ll1:AISCoherentDivergenceFractionMetric a obs:CybersecurityMetric ;
    warrant:hasName "Fraction of AIS targets diverging from radar in a common pattern" ;
    warrant:hasDescription "Share of radar-associated AIS targets whose divergence follows one pattern, such as reported positions converging on a common false point. A high fraction with every AIS target still holding a radar echo points to GNSS corruption at the transmitting vessels; isolated divergence or contacts without an echo point to direct AIS spoofing." ;
    obs:hasUnit "ratio" ;
    obs:hasExternalTimeSeriesId "timeseries.ais.coherent_divergence_fraction.LL1" .

ll1:AISMessageIntegrityMetric a obs:CybersecurityMetric ;
    warrant:hasName "AIS message plausibility" ;
    warrant:hasDescription "Identity and message-sequence consistency, and contacts with no radar echo. The direct AIS spoofing indicator; it does not see a genuine message carrying a wrong GNSS position." ;
    obs:hasUnit "integrity_score" ;
    obs:hasExternalTimeSeriesId "timeseries.ais.message_integrity.LL1" .

ll1:GyroHeadingConsistencyMetric a obs:SafetyMetric ;
    warrant:hasName "Gyrocompass–Sat-Compass Heading Consistency" ;
    obs:hasUnit "deg" ;
    obs:hasExternalTimeSeriesId "timeseries.gyro.heading_consistency.LL1" .

ll1:ECDISAvailabilityMetric a obs:AvailabilityMetric ;
    warrant:hasName "ECDIS System Availability (No1 + No2)" ;
    warrant:hasDescription "Whether the display service is up. Says nothing about whether what it displays is correct; stays at 1.0 throughout the GNSS spoofing scenario." ;
    obs:hasUnit "ratio" ;
    obs:hasExternalTimeSeriesId "timeseries.ecdis.availability.LL1" .

# — VDR recording health metrics
ll1:VDRRecordingStatusMetric a obs:AvailabilityMetric ;
    warrant:hasName "VDR Recording Status" ;
    obs:hasUnit "boolean" ;
    obs:hasExternalTimeSeriesId "timeseries.vdr.recording_status.LL1" .

ll1:VDRDataIntegrityMetric a obs:CybersecurityMetric ;
    warrant:hasName "VDR Data Integrity Hash" ;
    obs:hasUnit "hash_match_score" ;
    obs:hasExternalTimeSeriesId "timeseries.vdr.data_integrity.LL1" .

# — Communication health metrics
ll1:SatCommAvailabilityMetric a obs:AvailabilityMetric ;
    warrant:hasName "Satellite Communication Link Availability (GX + FBB)" ;
    obs:hasUnit "ratio" ;
    obs:hasExternalTimeSeriesId "timeseries.satcomm.availability.LL1" .

# — AMS health
ll1:AMSDataIntegrityMetric a obs:CybersecurityMetric ;
    warrant:hasName "AMS Monitoring Data Integrity" ;
    obs:hasUnit "integrity_score" ;
    obs:hasExternalTimeSeriesId "timeseries.ams.data_integrity.LL1" .

# — Metric assignments
ll1:GPS_1               obs:hasDependabilityMetric ll1:GNSSRadarFixResidualMetric , ll1:GNSSDeadReckoningResidualMetric , ll1:GPSPositionConsistencyMetric .
ll1:Echosounder         obs:hasDependabilityMetric ll1:DepthConsistencyMetric .
ll1:OwnShipPositionData obs:hasDependabilityMetric ll1:GNSSRadarFixResidualMetric , ll1:NavigationPositionConfidenceMetric .
ll1:NavigationFunction  obs:hasDependabilityMetric ll1:NavigationPositionConfidenceMetric .
ll1:AIS_Transponder     obs:hasDependabilityMetric ll1:AISPositionIntegrityMetric , ll1:AISCoherentDivergenceFractionMetric .
ll1:SurroundingTrafficAISReports obs:hasDependabilityMetric ll1:AISPositionIntegrityMetric , ll1:AISCoherentDivergenceFractionMetric .
ll1:Link_AIS_NavBus     obs:hasDependabilityMetric ll1:AISMessageIntegrityMetric .
ll1:Gyrocompass         obs:hasDependabilityMetric ll1:GyroHeadingConsistencyMetric .
ll1:ECDIS_1             obs:hasDependabilityMetric ll1:ECDISAvailabilityMetric .
ll1:VDR                 obs:hasDependabilityMetric ll1:VDRRecordingStatusMetric .
ll1:VDR                 obs:hasDependabilityMetric ll1:VDRDataIntegrityMetric .
ll1:Link_SatComm_LAN    obs:hasDependabilityMetric ll1:SatCommAvailabilityMetric .
ll1:AlarmMonitoringSystem obs:hasDependabilityMetric ll1:AMSDataIntegrityMetric .


# ═══════════════════════════════════════════════════════════════════════════════
# ANALYTICAL SERVICES
# ═══════════════════════════════════════════════════════════════════════════════

ll1:IDSAnalyticalService a obs:AnalyticalService ;
    warrant:hasName "IDS Analytical Service — Bridge and Automation OT Intrusion Monitoring" ;
    warrant:hasDescription "Network and log intrusion detection on bridge and automation OT (unauthorised configuration changes, log anomalies, satellite LAN traffic) and AIS message plausibility. It cannot see GNSS spoofing, which arrives over radio and leaves no network or log trace; that is the navigation integrity service's job." .

ll1:NavigationIntegrityService a obs:AnalyticalService ;
    warrant:hasName "Navigation Integrity Cross-Check Service" ;
    warrant:hasDescription "Compares GNSS-derived information with independent evidence: own-ship GNSS fix against radar ranges and bearings to charted features, echo-sounder depth against charted depth and dead reckoning; AIS targets against radar tracks in range and bearing, including the pattern of divergence across targets; gyrocompass against satellite compass. Treats agreement between GPS No1 and No2, or between own-ship GNSS and own-ship AIS, as no evidence of correctness. Does not use signal strength as a spoofing indicator." .

ll1:VDRHealthService a obs:AnalyticalService ;
    warrant:hasName "VDR Recording Health Monitoring Service" ;
    warrant:hasDescription "Monitors VDR recording status, data write health, and hash-based integrity of stored records. Detects tampering, data loss, or storage failure." .

ll1:IDSAnalyticalService obs:consumes ll1:AISMessageIntegrityMetric .
ll1:IDSAnalyticalService obs:consumes ll1:AMSDataIntegrityMetric .
ll1:NavigationIntegrityService obs:consumes ll1:GNSSRadarFixResidualMetric , ll1:GNSSDeadReckoningResidualMetric ,
                                           ll1:DepthConsistencyMetric , ll1:GPSPositionConsistencyMetric ,
                                           ll1:AISPositionIntegrityMetric , ll1:AISCoherentDivergenceFractionMetric ,
                                           ll1:GyroHeadingConsistencyMetric .
ll1:VDRHealthService obs:consumes ll1:VDRRecordingStatusMetric .
ll1:VDRHealthService obs:consumes ll1:VDRDataIntegrityMetric .


# ═══════════════════════════════════════════════════════════════════════════════
# DETECTION EVENTS
#
# Every Deviation is reached through a DetectionEvent (Critical Design
# Constraint 1). The two events of the primary scenario are timed on
# 2026-06-01. The other events are reference detections for the FMEA baseline
# and the secondary AIS scenario: each shows what would raise its deviation and
# which service performs the check. They are dated on earlier legs so that they
# are not read as concurrent with, or as part of, the GNSS scenario; they are
# not a record of real incidents on the vessel.
# ═══════════════════════════════════════════════════════════════════════════════

# — Primary scenario: area-wide GNSS spoofing

ll1:GPSSpoofingDetectionEvent a obs:DetectionEvent ;
    warrant:hasName "Own-Ship GNSS Position Integrity Breach" ;
    warrant:hasDescription "Navigation integrity service: the GNSS fix is 1.2 NM from the fix obtained from radar ranges and bearings to two charted conspicuous features; the echo sounder reads 38 m where the chart at the GNSS position shows 12 m; the GNSS track has drifted steadily from the dead-reckoning track since about 09:30, without a position jump. GPS No1 and No2 agree within 10 m and carrier-to-noise density is normal. Neither is evidence of a correct position: both receivers see the same counterfeit signal, and a spoofed signal normally arrives at normal strength. Because the AIS transponder broadcasts the own-ship GNSS position (ll1:Dep_PositionData_to_AIS), the same finding establishes that the own-ship AIS broadcast is wrong." ;
    obs:hasTimestamp "2026-06-01T09:44:30Z"^^xsd:dateTime .

ll1:SurroundingTrafficGNSSCorruptionEvent a obs:DetectionEvent ;
    warrant:hasName "Coherent AIS-to-Radar Divergence Across Surrounding Traffic" ;
    warrant:hasDescription "Navigation integrity service: eleven of the fourteen AIS targets that were associated with radar tracks before 09:30 have since separated from them, and their reported positions have converged within 0.4 NM of the position our own GNSS reports, while radar still holds the same vessels at 2 to 7 NM on dispersed bearings. Every AIS target keeps a radar echo, identities and message sequences are consistent with each vessel's history, and there are no contacts without an echo. The pattern is GNSS corruption at the transmitting vessels, the same area-wide spoofing that affects own ship, not counterfeit AIS. The three unaffected targets are the most distant, outside the spoofing footprint. Compared in range and bearing from own ship, so the radar side does not inherit own-ship GNSS error." ;
    obs:hasTimestamp "2026-06-01T09:45:00Z"^^xsd:dateTime .

ll1:NavigationIntegrityService obs:producesDetectionEvent ll1:GPSSpoofingDetectionEvent , ll1:SurroundingTrafficGNSSCorruptionEvent .

# — Secondary scenario: direct AIS spoofing

ll1:AISSpoofingDetectionEvent a obs:DetectionEvent ;
    warrant:hasName "Direct AIS Spoofing Detection Event" ;
    warrant:hasDescription "AIS plausibility and radar correlation: one AIS contact has no radar return at all, and two further contacts are displaced from their radar echoes by more than 0.5 NM in unrelated directions, while own-ship GNSS agrees with the radar fix on charted features. Incoherent divergence and a contact without an echo are the signature of counterfeit AIS messages, not of GNSS corruption." ;
    obs:hasTimestamp "2026-05-23T14:10:00Z"^^xsd:dateTime .

ll1:IDSAnalyticalService obs:producesDetectionEvent ll1:AISSpoofingDetectionEvent .

# — FMEA baseline reference detections

ll1:GPSJammingDetectionEvent a obs:DetectionEvent ;
    warrant:hasName "GPS Jamming Detection Event" ;
    warrant:hasDescription "Navigation integrity service detected simultaneous loss of GPS No1 and No2 position fix with raised receiver noise floor, characteristic of broadband jamming. Vessel fell back to dead reckoning. Unlike spoofing, jamming removes the fix and the receivers alarm." ;
    obs:hasTimestamp "2026-05-25T11:10:00Z"^^xsd:dateTime .

ll1:ECDISSettingsModifiedEvent a obs:DetectionEvent ;
    warrant:hasName "ECDIS Settings Modification Event" ;
    warrant:hasDescription "IDS log analysis detected unauthorised write to ECDIS No1 configuration file. Access was not from authorised service engineer session." ;
    obs:hasTimestamp "2026-05-12T08:30:00Z"^^xsd:dateTime .

ll1:VDRDataTamperEvent a obs:DetectionEvent ;
    warrant:hasName "VDR Data Tampering Detection Event" ;
    warrant:hasDescription "VDR health service detected hash mismatch in stored voyage record block — possible erasure or overwrite of recorded data." ;
    obs:hasTimestamp "2026-05-29T13:00:00Z"^^xsd:dateTime .

ll1:AMSDataCorruptionEvent a obs:DetectionEvent ;
    warrant:hasName "AMS Data Corruption Detection Event" ;
    warrant:hasDescription "IDS detected anomalous data in AMS monitoring feed — sensor values outside physical range, consistent with unauthorised data change. FMEA worst-case entry: RPN=315." ;
    obs:hasTimestamp "2026-05-07T07:00:00Z"^^xsd:dateTime .

ll1:GyroHeadingDivergenceEvent a obs:DetectionEvent ;
    warrant:hasName "Gyrocompass–Satellite Compass Heading Divergence Event" ;
    warrant:hasDescription "Heading divergence between Gyrocompass (CMZ-900) and Satellite Compass exceeded 3° — possible gyrocompass settings modification or hardware fault." ;
    obs:hasTimestamp "2026-05-19T10:15:00Z"^^xsd:dateTime .

ll1:ECDISSensorFeedLossEvent a obs:DetectionEvent ;
    warrant:hasName "ECDIS Sensor Feed Loss Detection Event" ;
    warrant:hasDescription "ECDIS No1 reported loss of one or more IEC 61162 sensor inputs (GPS, gyro, speed log, echo sounder, anemometer); the integrated display alarmed and fell back to manual entry for the affected values." ;
    obs:hasTimestamp "2026-05-14T16:20:00Z"^^xsd:dateTime .

ll1:SpeedlogInconsistencyEvent a obs:DetectionEvent ;
    warrant:hasName "Speedlog Inconsistency Detection Event" ;
    warrant:hasDescription "Speed through water from the speed log diverged from GPS speed over ground beyond the value explicable by set and drift on this leg, indicating invalid speed-log output rather than current." ;
    obs:hasTimestamp "2026-05-18T10:05:00Z"^^xsd:dateTime .

ll1:GyroFeedLossEvent a obs:DetectionEvent ;
    warrant:hasName "Gyrocompass Feed Loss Detection Event" ;
    warrant:hasDescription "Loss of the gyrocompass heading telegram on the serial distribution bus; radars, ECDIS, autopilot and AIS lost their heading reference simultaneously, which distinguishes a bus or interface failure from a single-consumer fault." ;
    obs:hasTimestamp "2026-05-21T10:20:00Z"^^xsd:dateTime .

ll1:RadarConfigurationChangeEvent a obs:DetectionEvent ;
    warrant:hasName "Radar Configuration Change Detection Event" ;
    warrant:hasDescription "IDS log analysis detected a change to X-band radar display and target-tracking settings outside an authorised service-engineer session." ;
    obs:hasTimestamp "2026-05-15T08:50:00Z"^^xsd:dateTime .

ll1:VDRRecordingStoppedEvent a obs:DetectionEvent ;
    warrant:hasName "VDR Recording Stopped Detection Event" ;
    warrant:hasDescription "VDR health service detected that no new voyage data blocks had been written for longer than the configured interval: recording has stopped rather than been altered." ;
    obs:hasTimestamp "2026-05-28T12:40:00Z"^^xsd:dateTime .

ll1:VHFConfigurationChangeEvent a obs:DetectionEvent ;
    warrant:hasName "VHF Configuration Change Detection Event" ;
    warrant:hasDescription "IDS detected a change to VHF No1 channel and DSC configuration; distress alerting capability could no longer be assumed available on that set." ;
    obs:hasTimestamp "2026-05-26T11:30:00Z"^^xsd:dateTime .

ll1:SatCommLinkLossEvent a obs:DetectionEvent ;
    warrant:hasName "Satellite Communication Link Loss Detection Event" ;
    warrant:hasDescription "Loss of both Inmarsat GX and FBB-500 connectivity at the Communications PC LAN boundary, beyond the duration explicable by ordinary beam handover or rain fade." ;
    obs:hasTimestamp "2026-05-27T11:45:00Z"^^xsd:dateTime .

ll1:IDSAnalyticalService       obs:producesDetectionEvent ll1:ECDISSettingsModifiedEvent , ll1:AMSDataCorruptionEvent ,
                                                          ll1:ECDISSensorFeedLossEvent , ll1:RadarConfigurationChangeEvent ,
                                                          ll1:VHFConfigurationChangeEvent , ll1:SatCommLinkLossEvent .
ll1:NavigationIntegrityService obs:producesDetectionEvent ll1:GPSJammingDetectionEvent , ll1:GyroHeadingDivergenceEvent ,
                                                          ll1:SpeedlogInconsistencyEvent , ll1:GyroFeedLossEvent .
ll1:VDRHealthService           obs:producesDetectionEvent ll1:VDRDataTamperEvent , ll1:VDRRecordingStoppedEvent .


# ═══════════════════════════════════════════════════════════════════════════════
# DEVIATIONS
# (FMEA failure modes mapped to HAZOP guidewords; RPN documented in description)
# ═══════════════════════════════════════════════════════════════════════════════

# — Primary scenario: area-wide GNSS spoofing. None of these is in the Danaos
#   FMEA worksheet, which covers GNSS jamming but not spoofing, so they carry no
#   failure-mode ratings.
ll1:DevGPSSpoofed a cdm:Deviation ;
    warrant:hasName "GNSS Position Spoofed (Plausible but Wrong Fix)" ;
    warrant:hasDescription "A counterfeit GNSS signal makes GPS No1 and No2 output a plausible but wrong position, course and speed over ground with a valid-fix flag. Every consumer on the GPS bus receives it: ECDIS (own-ship position), radars (geo-referencing and ground-stabilised vectors, not raw echo detection), AIS (the position broadcast about own ship), autopilot (track control), gyrocompass and speed log (latitude and speed corrections), VDR, and the VHF DSC, MF/HF and Inmarsat-C position used in distress alerts. The receivers remain available throughout. Distinct from jamming (ll1:DevGPSJammed), which removes the fix and raises alarms." ;
    cdm:hasDeviationType cdm:SPOOFED ;
    cdm:degrades ll1:GPS_1 , ll1:GPS_2 , ll1:OwnShipPositionData .

ll1:DevOwnShipAISBroadcastWrong a cdm:Deviation ;
    warrant:hasName "Own-Ship AIS Broadcast Carries Wrong Position" ;
    warrant:hasDescription "The AIS transponder operates normally and broadcasts the own-ship position its GNSS input supplies, which is wrong. Surrounding vessels and shore stations see this vessel in the wrong place. Not AIS spoofing: the equipment and the messages are genuine." ;
    cdm:hasDeviationType cdm:WRONG ;
    cdm:degrades ll1:OwnShipAISBroadcast .

ll1:DevSurroundingTrafficAISPositionsWrong a cdm:Deviation ;
    warrant:hasName "Surrounding Traffic AIS Positions Wrong at Source" ;
    warrant:hasDescription "Surrounding vessels inside the spoofing footprint compute wrong positions with their own GNSS receivers and their AIS transponders broadcast them. This vessel's AIS receives technically valid messages from the genuine vessels, and ECDIS displays those vessels in the wrong place. Not direct AIS spoofing (ll1:DevSpoofedAIS): nothing is counterfeit, every target has a radar echo, and the divergence from radar is coherent across targets rather than isolated." ;
    cdm:hasDeviationType cdm:WRONG ;
    cdm:degrades ll1:SurroundingTrafficAISReports , ll1:SurroundingVesselGNSSPositionData .

# — Secondary scenario: direct AIS spoofing
ll1:DevSpoofedAIS a cdm:Deviation ;
    warrant:hasName "Spoofed AIS Target Data (Direct AIS Spoofing)" ;
    warrant:hasDescription "Counterfeit AIS messages injected by an adversary over the open VHF AIS channels (87B/88B), which carry no authentication. The effect is on the TARGET picture: phantom, displaced or suppressed contacts appear in the ECDIS AIS overlay and in the radar-AIS correlation. It is NOT an own-ship position error: ECDIS takes own-ship position from the GNSS receiver over the IEC 61162 bus (ll1:Link_GPS_NavBus), not from AIS, so own-ship GNSS position stays correct. FMEA: AIS transponder, interfaces modified / SW infected." ;
    cdm:hasDeviationType cdm:SPOOFED .

# — ECDIS failure modes (alternative causes, not part of the GNSS chain)
ll1:DevECDISSettingsModified a cdm:Deviation ;
    warrant:hasName "ECDIS Settings Modified (Unauthorised)" ;
    warrant:hasDescription "ECDIS display parameters, antenna offsets or chart datum modified by unauthorised access. An alternative cause of a wrong own-ship position on the chart, with its own detection (configuration and log monitoring); ECDIS is not the source of the error in the GNSS spoofing scenario. FMEA Asset 2: settings modified Sev=6 Prob=6 Det=3 RPN=108. Storage: CF/SD card, DVD update interface." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:DevECDISInterfaceModified a cdm:Deviation ;
    warrant:hasName "ECDIS Sensor Interface Disconnected/Modified" ;
    warrant:hasDescription "Loss of sensor feeds (GPS, Gyro, Speedlog, Anemometer, Echosounder) to ECDIS due to SERIAL interface manipulation. ECDIS alarms and the position is missing rather than silently wrong. FMEA RPN=90." ;
    cdm:hasDeviationType cdm:UNAVAILABLE .

# — GPS failure modes
ll1:DevGPSJammed a cdm:Deviation ;
    warrant:hasName "GPS Signal Jammed (External)" ;
    warrant:hasDescription "External GPS jamming causes loss of position fix on both GPS units. FMEA Asset 8: signal jammed Sev=7 Prob=3 Det=3 RPN=63. Fallback: celestial/visual navigation, dead reckoning. Not equivalent to spoofing: the fix is lost and alarmed, not replaced by a wrong one." ;
    cdm:hasDeviationType cdm:NO .

# — Gyrocompass failure modes
ll1:DevGyroSettingsModified a cdm:Deviation ;
    warrant:hasName "Gyrocompass Settings Modified" ;
    warrant:hasDescription "Invalid heading data distributed to X/S Radars, ECDIS, Autopilot, AIS, Course recorder, Speedlog, VDR. FMEA Asset 4: Sev=7 Prob=3 Det=3 RPN=63. Fallback: Satellite Compass and Magnetic Compass." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:DevGyroInterfaceDisconnected a cdm:Deviation ;
    warrant:hasName "Gyrocompass Interface Disconnected" ;
    warrant:hasDescription "Loss of gyro heading feed to all interconnected equipment. FMEA Asset 4: interface disconnected Sev=7 Prob=3 Det=3 RPN=63." ;
    cdm:hasDeviationType cdm:UNAVAILABLE .

# — Speedlog failure modes
ll1:DevSpeedlogModified a cdm:Deviation ;
    warrant:hasName "Speedlog Data Invalid" ;
    warrant:hasDescription "False speed-through-water data distributed to RADAR, ECDIS, Gyrocompass, Autopilot, AIS, VDR. FMEA Asset 6: settings modified Sev=7 Prob=5 Det=3 RPN=105. Fallback: GPS SOG." ;
    cdm:hasDeviationType cdm:WRONG .

# — RADAR failure modes
ll1:DevRADARSettingsModified a cdm:Deviation ;
    warrant:hasName "RADAR Settings Modified" ;
    warrant:hasDescription "Loss of RADAR display settings or user controls. FMEA Asset 1: settings modified Sev=6 Prob=6 Det=3 RPN=108. Fallback: second RADAR available." ;
    cdm:hasDeviationType cdm:WRONG .

# — VDR failure modes (separate FMEA risk; not part of the GNSS scenario)
ll1:DevVDRDataModified a cdm:Deviation ;
    warrant:hasName "VDR Data Modified or Erased" ;
    warrant:hasDescription "Voyage record data erased or overwritten; accident investigation evidence destroyed. FMEA Asset 11: data modified/erased Sev=6 Prob=6 Det=5 RPN=180 — highest RPN in navigation OT." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:DevVDRDataNotStored a cdm:Deviation ;
    warrant:hasName "VDR Data Not Stored" ;
    warrant:hasDescription "VDR fails to record incoming data streams. FMEA Asset 11: data not stored Sev=7 Prob=5 Det=5 RPN=175. Cause: procedures not followed or system failure." ;
    cdm:hasDeviationType cdm:NO .

# — AMS failure modes (electrical OT — highest RPN overall)
ll1:DevAMSDataCorrupted a cdm:Deviation ;
    warrant:hasName "AMS Monitoring Data Corrupted" ;
    warrant:hasDescription "Engine room and vessel alarm data changed or falsified; crew unable to monitor engine room state. FMEA Asset 18 (Electrical OT): change data Sev=7 Prob=9 Det=5 RPN=315 — highest RPN in entire FMEA. Responsibility: Chief Engineer." ;
    cdm:hasDeviationType cdm:WRONG .

# — Communication failure modes
ll1:DevVHFSettingsModified a cdm:Deviation ;
    warrant:hasName "VHF Communication Disrupted (Settings Modified)" ;
    warrant:hasDescription "VHF settings modified, disrupting short-range comms and potentially disabling DSC distress functionality. FMEA Asset 12: Sev=6 Prob=5 Det=3 RPN=90." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:DevSatCommUnavailable a cdm:Deviation ;
    warrant:hasName "Satellite Communication Link Unavailable" ;
    warrant:hasDescription "Inmarsat GX or FBB settings modified or Linux system compromised via Communications PC LAN boundary. Both systems run Linux with no antivirus/firewall. FMEA Asset 16/17: RPN=72 each." ;
    cdm:hasDeviationType cdm:UNAVAILABLE .

# — Detection event ↔ deviation
ll1:GPSSpoofingDetectionEvent     obs:detectionEventDetects ll1:DevGPSSpoofed , ll1:DevOwnShipAISBroadcastWrong .
ll1:SurroundingTrafficGNSSCorruptionEvent obs:detectionEventDetects ll1:DevSurroundingTrafficAISPositionsWrong .
ll1:AISSpoofingDetectionEvent     obs:detectionEventDetects ll1:DevSpoofedAIS .
ll1:GPSJammingDetectionEvent      obs:detectionEventDetects ll1:DevGPSJammed .
ll1:ECDISSettingsModifiedEvent    obs:detectionEventDetects ll1:DevECDISSettingsModified .
ll1:VDRDataTamperEvent            obs:detectionEventDetects ll1:DevVDRDataModified .
ll1:AMSDataCorruptionEvent        obs:detectionEventDetects ll1:DevAMSDataCorrupted .
ll1:GyroHeadingDivergenceEvent    obs:detectionEventDetects ll1:DevGyroSettingsModified .
ll1:ECDISSensorFeedLossEvent      obs:detectionEventDetects ll1:DevECDISInterfaceModified .
ll1:SpeedlogInconsistencyEvent    obs:detectionEventDetects ll1:DevSpeedlogModified .
ll1:GyroFeedLossEvent             obs:detectionEventDetects ll1:DevGyroInterfaceDisconnected .
ll1:RadarConfigurationChangeEvent obs:detectionEventDetects ll1:DevRADARSettingsModified .
ll1:VDRRecordingStoppedEvent      obs:detectionEventDetects ll1:DevVDRDataNotStored .
ll1:VHFConfigurationChangeEvent   obs:detectionEventDetects ll1:DevVHFSettingsModified .
ll1:SatCommLinkLossEvent          obs:detectionEventDetects ll1:DevSatCommUnavailable .


# ═══════════════════════════════════════════════════════════════════════════════
# STPA — CONTROL STRUCTURE, PROCESS MODEL FLAWS, UCAs
#
# The officer's process model has two parts that the primary scenario degrades
# through different propagation paths: own-ship position understanding (via
# own-ship GNSS → ECDIS) and surrounding-traffic understanding (via the
# surrounding vessels' GNSS → their AIS → our AIS → ECDIS). Radar feedback is
# modelled separately because it is the independent channel.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:BridgeControlStructure a cdm:ControlStructure ;
    warrant:hasName "Bridge Navigation Control Structure" ;
    warrant:hasDescription "Controller: Navigation Officer. Controlled process: Vessel course and speed. Feedback: ECDIS own-ship position and AIS overlay (GNSS-derived), radar picture in range and bearing (independent). Control actions: course/speed commands to Autopilot or helm." .

ll1:NavigationOfficerController a cdm:Controller ;
    warrant:hasName "Navigation Officer (STPA Controller)" .

ll1:VesselCourseControlledProcess a cdm:ControlledProcess ;
    warrant:hasName "Vessel Course and Speed (Controlled Process)" .

ll1:ECDISFeedback a cdm:Feedback ;
    warrant:hasName "ECDIS Own-Ship Position and AIS Target Feedback" ;
    warrant:hasDescription "Own-ship position on the chart (from GNSS) and the AIS target overlay (positions from the transmitting vessels' GNSS). Both parts are GNSS-derived, so area-wide spoofing corrupts both while ECDIS itself works correctly." .

ll1:RadarFeedback a cdm:Feedback ;
    warrant:hasName "Radar Range and Bearing Feedback" ;
    warrant:hasDescription "Echoes of surrounding vessels and charted features in range and bearing from own ship. Independent of GNSS for detection and relative geometry; its geo-referenced positions and chart overlay alignment are not." .

ll1:CourseAlterationControlAction a davom:ControlAction ;
    warrant:hasName "Course Alteration Command" ;
    warrant:hasDescription "Course or speed order issued by the navigation officer to the autopilot or the helm on the basis of the ECDIS and radar picture." .

ll1:NavigationOfficerRole davom:authorizes ll1:CourseAlterationControlAction .
ll1:NavigationOfficerController cdm:issues ll1:CourseAlterationControlAction .
ll1:CourseAlterationControlAction cdm:actsOn ll1:VesselCourseControlledProcess .
ll1:VesselCourseControlledProcess cdm:providesFeedback ll1:ECDISFeedback , ll1:RadarFeedback .
ll1:ECDISFeedback cdm:updates ll1:NavigationOfficerProcessModel .
ll1:RadarFeedback cdm:updates ll1:NavigationOfficerProcessModel .

ll1:NavigationOfficerProcessModel a cdm:ProcessModel ;
    warrant:hasName "Navigation Officer Process Model (Navigation Situational Awareness)" ;
    warrant:hasDescription "The officer's working picture of where the vessel is (own-ship position understanding) and what the surrounding traffic is doing (surrounding-traffic understanding), built from ECDIS own-ship position, the AIS target overlay and the radar picture." .

ll1:WrongPositionProcessModelFlaw a cdm:ProcessModelFlaw ;
    warrant:hasName "Wrong Own-Ship Position Understanding" ;
    warrant:hasDescription "ECDIS shows own ship at a wrong position, so the officer believes the vessel is on a safe track while it is standing into danger. Primary path: GNSS spoofing, with ECDIS correctly displaying the wrong position it receives. Alternative cause, outside the scenario: an ECDIS compromise that alters antenna offsets or chart datum. Not reachable from AIS spoofing. Loss of sensor feeds gives an alarmed, missing position rather than a silently wrong one and is modelled under loss of the navigation picture." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:WrongTrafficPictureProcessModelFlaw a cdm:ProcessModelFlaw ;
    warrant:hasName "Wrong Surrounding-Traffic Understanding" ;
    warrant:hasDescription "The AIS overlay shows vessels in the wrong place, or shows contacts that do not exist. Two separate paths reach it. Primary: area-wide GNSS spoofing corrupts the positions surrounding vessels broadcast; this co-occurs with the wrong own-ship position, every target keeps a radar echo, and the divergence from radar is coherent across targets. Secondary: direct AIS spoofing; own-ship position stays correct, and the divergence is isolated or a contact has no echo. Radar range and bearing is what makes both detectable." ;
    cdm:hasDeviationType cdm:WRONG .

ll1:WrongCollisionAvoidanceUCA a cdm:UnsafeControlAction ;
    warrant:hasName "Wrong or Unnecessary Collision-Avoidance Manoeuvre" ;
    warrant:hasDescription "The officer alters course or speed for a contact whose AIS position is wrong, or fails to give way to a real contact that the AIS overlay misplaces or omits. STPA: control action provided when not required, or not provided when required, because the process model of the traffic situation is wrong. In confined or heavily trafficked water the avoiding action can itself set the vessel toward a hazard or into conflict with a genuine target." .

ll1:WrongCourseAlterationUCA a cdm:UnsafeControlAction ;
    warrant:hasName "Wrong Course Alteration (Based on Wrong Own-Ship Position)" ;
    warrant:hasDescription "Navigation officer issues a course alteration based on a wrong ECDIS own-ship position, manoeuvring the vessel toward shallow water, a charted danger or a traffic separation zone. With the autopilot in track control, the same wrong position steers the vessel without any officer action. STPA: control action wrong in direction or amount given the flawed process model." .

ll1:DevGPSSpoofed                          cdm:mayCause ll1:WrongPositionProcessModelFlaw .
ll1:DevSurroundingTrafficAISPositionsWrong cdm:mayCause ll1:WrongTrafficPictureProcessModelFlaw .
ll1:WrongPositionProcessModelFlaw          cdm:mayCause ll1:WrongCourseAlterationUCA .
ll1:WrongTrafficPictureProcessModelFlaw    cdm:mayCause ll1:WrongCollisionAvoidanceUCA .
ll1:WrongCourseAlterationUCA               cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:WrongCollisionAvoidanceUCA             cdm:mayCause ll1:HazHazardousAreaApproach .

# Alternative and secondary causes, kept distinct from the primary chain.
ll1:DevECDISSettingsModified cdm:mayCause ll1:WrongPositionProcessModelFlaw .
ll1:DevSpoofedAIS            cdm:mayCause ll1:WrongTrafficPictureProcessModelFlaw .

ll1:WrongCourseAlterationUCA   assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .
ll1:WrongCollisionAvoidanceUCA assr:causesAssuranceDegradation ll1:NavigationCyberDegradation .


# ═══════════════════════════════════════════════════════════════════════════════
# SCENARIOS
# ═══════════════════════════════════════════════════════════════════════════════

ll1:AreaWideGNSSSpoofingScenario a scen:CyberattackScenario ;
    warrant:hasIdentifier "SCN-LL1-001" ;
    warrant:hasName "Area-Wide GNSS Spoofing and Navigation Situational Awareness Degradation" ;
    warrant:hasDescription "Primary LL1 scenario. On a coastal approach in dense traffic, an external transmitter spoofs GNSS across the sea area. Own-ship GNSS outputs a plausible but wrong position that ECDIS displays and AIS broadcasts; surrounding vessels inside the footprint broadcast wrong positions that ECDIS displays as the traffic picture. The equipment stays available; the navigation picture becomes unreliable. The officer risks a wrong course alteration and a wrong collision-avoidance manoeuvre. Detected by cross-source inconsistency against radar range and bearing, depth and dead reckoning; handled by reverting to independent position fixing and radar-based collision avoidance." ;
    scen:hasTrigger ll1:DevGPSSpoofed ;
    scen:affects ll1:GPS_1 , ll1:GPS_2 , ll1:ECDIS_1 , ll1:ECDIS_2 , ll1:AIS_Transponder , ll1:RadarXBand , ll1:RadarSBand , ll1:Autopilot , ll1:NavigationFunction ;
    scen:causes ll1:HazHazardousAreaApproach , ll1:RiskCollisionGrounding .

ll1:DirectAISSpoofingScenario a scen:CyberattackScenario ;
    warrant:hasIdentifier "SCN-LL1-002" ;
    warrant:hasName "Direct AIS Spoofing (Secondary Scenario)" ;
    warrant:hasDescription "Counterfeit AIS messages over the unauthenticated VHF AIS channels create phantom, displaced or suppressed contacts in the ECDIS overlay. Only the traffic picture is falsified; own-ship GNSS position, and therefore own-ship position on ECDIS, stays correct. Detected by contacts without a radar echo and by isolated, incoherent AIS-to-radar divergence." ;
    scen:hasTrigger ll1:DevSpoofedAIS ;
    scen:affects ll1:AIS_Transponder , ll1:ECDIS_1 , ll1:NavigationFunction ;
    scen:causes ll1:HazHazardousAreaApproach .


# ═══════════════════════════════════════════════════════════════════════════════
# HAZARDS
# ═══════════════════════════════════════════════════════════════════════════════

ll1:HazHazardousAreaApproach a cdm:Hazard ;
    warrant:hasName "Standing into Danger or Close-Quarters Situation" ;
    warrant:hasDescription "Vessel manoeuvres toward shallow water, a charted danger or a traffic separation zone, or into a close-quarters or collision situation with another vessel, based on wrong position, traffic or heading information." .

ll1:HazLossOfNavigationPicture a cdm:Hazard ;
    warrant:hasName "Loss of Navigation Picture" ;
    warrant:hasDescription "Simultaneous failure or loss of GPS, Gyrocompass, and/or ECDIS leaves the officer with no position or heading reference. The information is absent and alarmed, as distinct from present but wrong." .

ll1:HazLossOfVDREvidence a cdm:Hazard ;
    warrant:hasName "Loss of Voyage Data Record Evidence" ;
    warrant:hasDescription "VDR data erased or not stored — post-incident investigation, P&I Club claims, and flag-state requirements cannot be met." .

ll1:HazLossOfDistressComms a cdm:Hazard ;
    warrant:hasName "Loss of Distress Communication Capability" ;
    warrant:hasDescription "VHF DSC, MF/HF, and/or Inmarsat-C unavailable or misconfigured — vessel cannot transmit MAYDAY or receive SAR coordination." .

ll1:HazUnmonitoredEngineRoom a cdm:Hazard ;
    warrant:hasName "Unmonitored Engine Room State" ;
    warrant:hasDescription "AMS data corrupted — crew cannot detect engine room alarms, fire, flooding, or mechanical failure. Highest-probability hazard in FMEA (Prob=9)." .

# — Deviation → Hazard
ll1:DevGPSSpoofed                          cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevOwnShipAISBroadcastWrong            cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevSurroundingTrafficAISPositionsWrong cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevSpoofedAIS             cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevGPSJammed              cdm:mayCause ll1:HazLossOfNavigationPicture .
ll1:DevECDISSettingsModified  cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevECDISInterfaceModified cdm:mayCause ll1:HazLossOfNavigationPicture .
ll1:DevGyroSettingsModified   cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevGyroInterfaceDisconnected cdm:mayCause ll1:HazLossOfNavigationPicture .
ll1:DevSpeedlogModified       cdm:mayCause ll1:HazHazardousAreaApproach .
ll1:DevRADARSettingsModified  cdm:mayCause ll1:HazLossOfNavigationPicture .
ll1:DevVDRDataModified        cdm:mayCause ll1:HazLossOfVDREvidence .
ll1:DevVDRDataNotStored       cdm:mayCause ll1:HazLossOfVDREvidence .
ll1:DevVHFSettingsModified    cdm:mayCause ll1:HazLossOfDistressComms .
ll1:DevSatCommUnavailable     cdm:mayCause ll1:HazLossOfDistressComms .
ll1:DevAMSDataCorrupted       cdm:mayCause ll1:HazUnmonitoredEngineRoom .


# ═══════════════════════════════════════════════════════════════════════════════
# RISKS
# ═══════════════════════════════════════════════════════════════════════════════

ll1:RiskCollisionGrounding a cdm:Risk ;
    warrant:hasName "Collision or Grounding Risk" ;
    warrant:hasDescription "Evaluated against three threat scenarios: area-wide GNSS spoofing (primary), direct AIS spoofing and ECDIS compromise. The FMEA figures that bear on it (ECDIS/GPS/RADAR settings modified, RPN=108, Sev=6, Prob=6, Det=3) cover configuration tampering only; the worksheet has no GNSS spoofing entry, so the likelihood for the spoofing path is the WARRaNT LL1 baseline assessment for a known interference area." ;
    cdm:hasLikelihood    "0.50"^^xsd:decimal ;
    cdm:hasImpact        "0.95"^^xsd:decimal ;
    cdm:hasSeverity      "0.90"^^xsd:decimal ;
    cdm:hasRiskLevel     "Critical" ;
    cdm:hasAcceptability "Unacceptable" .

ll1:RiskNavigationPictureLoss a cdm:Risk ;
    warrant:hasName "Loss of Navigation Picture Risk" ;
    warrant:hasDescription "FMEA basis: GPS jamming (RPN=63) + gyrocompass interface failure (RPN=63) occurring simultaneously. Dead reckoning fallback for limited time only." ;
    cdm:hasLikelihood    "0.25"^^xsd:decimal ;
    cdm:hasImpact        "0.85"^^xsd:decimal ;
    cdm:hasSeverity      "0.80"^^xsd:decimal ;
    cdm:hasRiskLevel     "High" ;
    cdm:hasAcceptability "Unacceptable" .

ll1:RiskVDREvidenceLoss a cdm:Risk ;
    warrant:hasName "Voyage Record Evidence Loss Risk" ;
    warrant:hasDescription "FMEA basis: VDR data modified/erased RPN=180 (Sev=6,Prob=6,Det=5) — highest RPN in navigation OT. Consequences: P&I Club liability, flag-state implications, inability to reconstruct accident." ;
    cdm:hasLikelihood    "0.40"^^xsd:decimal ;
    cdm:hasImpact        "0.70"^^xsd:decimal ;
    cdm:hasSeverity      "0.65"^^xsd:decimal ;
    cdm:hasRiskLevel     "High" ;
    cdm:hasAcceptability "ALARP" .

ll1:RiskDistressCommsLoss a cdm:Risk ;
    warrant:hasName "Loss of Distress Communication Risk" ;
    warrant:hasDescription "FMEA basis: VHF settings modified RPN=90; Inmarsat-C interface modified RPN=72. Combined loss of VHF + Inmarsat-C leaves vessel unable to transmit MAYDAY." ;
    cdm:hasLikelihood    "0.20"^^xsd:decimal ;
    cdm:hasImpact        "0.90"^^xsd:decimal ;
    cdm:hasSeverity      "0.85"^^xsd:decimal ;
    cdm:hasRiskLevel     "Critical" ;
    cdm:hasAcceptability "Unacceptable" .

ll1:RiskEngineRoomUnmonitored a cdm:Risk ;
    warrant:hasName "Engine Room Unmonitored Risk" ;
    warrant:hasDescription "FMEA basis: AMS data change RPN=315 (Sev=7,Prob=9,Det=5) — highest RPN in entire FMEA. Crew cannot detect engine/fire/flooding events. Chief Engineer responsible." ;
    cdm:hasLikelihood    "0.60"^^xsd:decimal ;
    cdm:hasImpact        "0.85"^^xsd:decimal ;
    cdm:hasSeverity      "0.80"^^xsd:decimal ;
    cdm:hasRiskLevel     "Critical" ;
    cdm:hasAcceptability "Unacceptable" .

ll1:HazHazardousAreaApproach   cdm:isEvaluatedAs ll1:RiskCollisionGrounding .
ll1:HazLossOfNavigationPicture cdm:isEvaluatedAs ll1:RiskNavigationPictureLoss .
ll1:HazLossOfVDREvidence       cdm:isEvaluatedAs ll1:RiskVDREvidenceLoss .
ll1:HazLossOfDistressComms     cdm:isEvaluatedAs ll1:RiskDistressCommsLoss .
ll1:HazUnmonitoredEngineRoom   cdm:isEvaluatedAs ll1:RiskEngineRoomUnmonitored .


# ═══════════════════════════════════════════════════════════════════════════════
# HAZARD CLASSES AND THE IMPACT TRIPLE
#
# A hazard class governs which dependency types a class of risk can propagate
# over. Impact is assessed separately against safety, environmental and
# financial consequence; the governing value already recorded in cdm:hasImpact
# is the most severe of the three.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:HazHazardousAreaApproach   cdm:hasHazardClass cdm:CYBER_THREAT , cdm:DATA_LOSS .
ll1:HazLossOfNavigationPicture cdm:hasHazardClass cdm:DATA_LOSS .
ll1:HazLossOfVDREvidence       cdm:hasHazardClass cdm:CYBER_THREAT .
ll1:HazLossOfDistressComms     cdm:hasHazardClass cdm:CYBER_THREAT , cdm:DATA_LOSS .
ll1:HazUnmonitoredEngineRoom   cdm:hasHazardClass cdm:CYBER_THREAT .

ll1:RiskCollisionGrounding
    cdm:hasHazardClass         cdm:CYBER_THREAT ;
    cdm:hasSafetyImpact        "0.95"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.70"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.85"^^xsd:decimal .

ll1:RiskNavigationPictureLoss
    cdm:hasHazardClass         cdm:DATA_LOSS ;
    cdm:hasSafetyImpact        "0.85"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.55"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.60"^^xsd:decimal .

ll1:RiskVDREvidenceLoss
    cdm:hasHazardClass         cdm:CYBER_THREAT ;
    cdm:hasSafetyImpact        "0.20"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.10"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.70"^^xsd:decimal .

ll1:RiskDistressCommsLoss
    cdm:hasHazardClass         cdm:CYBER_THREAT , cdm:DATA_LOSS ;
    cdm:hasSafetyImpact        "0.90"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.40"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.50"^^xsd:decimal .

ll1:RiskEngineRoomUnmonitored
    cdm:hasHazardClass         cdm:CYBER_THREAT ;
    cdm:hasSafetyImpact        "0.85"^^xsd:decimal ;
    cdm:hasEnvironmentalImpact "0.75"^^xsd:decimal ;
    cdm:hasFinancialImpact     "0.70"^^xsd:decimal .


# ═══════════════════════════════════════════════════════════════════════════════
# OPERATIONAL CONTEXT
#
# Hazards and risks are scoped to where they apply. For an ocean-going
# containership the navigation hazards below are landfall, coastal and traffic
# separation hazards rather than mid-ocean ones, and GNSS interference is
# concentrated in known areas rather than spread along a route.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:CoastalApproachSegment a warrant:VoyageSegment ;
    warrant:hasName "Coastal approach and traffic separation scheme transit" ;
    warrant:hasDescription "The phase in which the navigation hazards modelled here are live: charted dangers within manoeuvring distance, dense traffic, and a requirement to keep to a scheme. In the open-ocean phase the same deviations are far less consequential because sea room and time to act are measured in hours." .

ll1:HighTrafficDensityCondition a warrant:TrafficCondition ;
    warrant:hasName "High traffic density" ;
    warrant:hasDescription "Traffic density at which an avoidance manoeuvre must be taken on the AIS and radar picture rather than on visual assessment alone, which is what makes a wrong traffic picture consequential, whether the AIS positions were corrupted at their GNSS source or counterfeited." .

ll1:GNSSInterferenceAreaCondition a warrant:EnvironmentalCondition ;
    warrant:hasName "Known GNSS interference area" ;
    warrant:hasDescription "A sea area with reported jamming or spoofing activity, typically notified by NAVAREA or coastal warnings received on NAVTEX. Interference is regionally concentrated and a single transmitter affects every receiver within its footprint, own ship and surrounding traffic alike, so the likelihood attached to the GNSS threat scenario is a function of where the vessel is, not a constant of the equipment." .

ll1:HazHazardousAreaApproach   cdm:hasOperationalContext ll1:CoastalApproachSegment .
ll1:HazLossOfNavigationPicture cdm:hasOperationalContext ll1:CoastalApproachSegment .
ll1:HazLossOfDistressComms     cdm:hasOperationalContext ll1:CoastalApproachSegment .

ll1:HazHazardousAreaApproach cdm:isCriticalUnder ll1:HighTrafficDensityCondition , ll1:GNSSInterferenceAreaCondition .
ll1:HazLossOfNavigationPicture cdm:isCriticalUnder ll1:GNSSInterferenceAreaCondition .

ll1:GNSSInterferenceAreaCondition cdm:modifiesLikelihoodOf ll1:RiskCollisionGrounding , ll1:RiskNavigationPictureLoss .
ll1:HighTrafficDensityCondition   cdm:modifiesImpactOf     ll1:RiskCollisionGrounding .

ll1:RiskCollisionGrounding    cdm:hasEnvironmentalCondition ll1:HighTrafficDensityCondition , ll1:GNSSInterferenceAreaCondition .
ll1:RiskNavigationPictureLoss cdm:hasEnvironmentalCondition ll1:GNSSInterferenceAreaCondition .

# The bridge team conns the vessel directly; there is no remote operation on a
# deep-sea containership, and the operator-authority model reflects that.
ll1:CourseAlterationControlAction cdm:isPerformedUnder warrant:ManualOperationMode .
ll1:DevSpoofedAIS   cdm:wasObservedUnder warrant:ManualOperationMode .
ll1:DevGPSSpoofed   cdm:wasObservedUnder warrant:ManualOperationMode .
ll1:DevOwnShipAISBroadcastWrong            cdm:wasObservedUnder warrant:ManualOperationMode .
ll1:DevSurroundingTrafficAISPositionsWrong cdm:wasObservedUnder warrant:ManualOperationMode .
ll1:DevGPSSpoofed cdm:hasOperationalContext ll1:GNSSInterferenceAreaCondition , ll1:CoastalApproachSegment .
ll1:DevSurroundingTrafficAISPositionsWrong cdm:hasOperationalContext ll1:GNSSInterferenceAreaCondition , ll1:HighTrafficDensityCondition .


# ═══════════════════════════════════════════════════════════════════════════════
# ASSET ROLES AND CRITICAL NODES
#
# Primary assets are the information and services of value; supporting assets
# are the equipment and roles that store, process, transmit or execute them.
# Every primary asset should be reachable from at least one supporting asset,
# which is the graph-completeness check of the cybersecurity methodology.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:NavigationFunction      davom:hasAssetRole davom:PRIMARY_ASSET ; davom:isCriticalNode true .
ll1:CommunicationFunction   davom:hasAssetRole davom:PRIMARY_ASSET ; davom:isCriticalNode true .
ll1:VoyageRecordingFunction davom:hasAssetRole davom:PRIMARY_ASSET ; davom:isCriticalNode false .
ll1:ElectricalAlarmFunction davom:hasAssetRole davom:PRIMARY_ASSET ; davom:isCriticalNode true .

ll1:GPS_1           davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction ; davom:isCriticalNode true .
ll1:GPS_2           davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:Gyrocompass     davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction ; davom:isCriticalNode true .
ll1:ECDIS_1         davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction ; davom:isCriticalNode true .
ll1:ECDIS_2         davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:RadarXBand      davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction ; davom:isCriticalNode true .
ll1:RadarSBand      davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:AIS_Transponder davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:OwnShipPositionData davom:hasAssetRole davom:PRIMARY_ASSET ; davom:isCriticalNode true .
ll1:SurroundingTrafficAISReports davom:hasAssetRole davom:PRIMARY_ASSET .
ll1:Echosounder     davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:Autopilot       davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:Speedlog        davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:VDR             davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:VoyageRecordingFunction ; davom:isCriticalNode true .
ll1:VHF_1           davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:CommunicationFunction ; davom:isCriticalNode true .
ll1:InmarsatC_1     davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:CommunicationFunction .
ll1:InmarsatGX      davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:CommunicationFunction .
ll1:CommunicationsPC davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:CommunicationFunction .
ll1:BNWAS           davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:ElectricalAlarmFunction .

ll1:NavigationOfficerRole davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:NavigationFunction .
ll1:ChiefEngineerRole     davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:ElectricalAlarmFunction .
ll1:ElectricalDeptRole    davom:hasAssetRole davom:SUPPORTING_ASSET ; davom:supportsAsset ll1:ElectricalAlarmFunction .

ll1:AlarmMonitoringSystem davom:isCriticalNode true .


# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY ZONES AND CONDUITS (IEC 62443-3-2)
#
# Partitioning the vessel into zones makes the reach of a network compromise a
# typed graph query: a cyber effect crosses a conduit and travels over data,
# control and cyber dependencies, and does not travel over physical ones.
# GNSS spoofing does not cross a conduit; it enters every receiver directly
# from the external radio environment.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:Zone_BridgeNavigationOT a davom:SecurityZone ;
    warrant:hasName "Bridge Navigation OT Zone" ;
    warrant:hasDescription "Radars, ECDIS, GPS, gyrocompass, satellite compass, autopilot, speed log, echo sounder, anemometer, AIS, BNWAS and the VDR, connected by the IEC 61162 serial buses and the radar-ECDIS LAN. Access restricted to service engineers with authorisation codes." .

ll1:Zone_ElectricalAutomationOT a davom:SecurityZone ;
    warrant:hasName "Electrical and Automation OT Zone" ;
    warrant:hasDescription "Alarm monitoring system, fire detection, general alarm and public address, navigation light panel. Carries the highest-RPN entry in the FMEA." .

ll1:Zone_ShipBusinessIT a davom:SecurityZone ;
    warrant:hasName "Ship Business IT Zone" ;
    warrant:hasDescription "The Communications PC and the satellite terminals it is connected to over the LAN. The principal ingress path: shore internet traffic reaches this zone, and both satellite terminals run without endpoint protection per the equipment inventory." .

ll1:Zone_ShoreExternal a davom:SecurityZone ;
    warrant:hasName "Shore and External Zone" ;
    warrant:hasDescription "Everything outside the vessel: shore offices, service providers, and the open radio environment in which AIS and GNSS signals are received without authentication. GNSS spoofing enters from here over radio, not across a network conduit, so zone and conduit controls do not contain it." .

ll1:RadarXBand davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:RadarSBand davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:ECDIS_1 davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:ECDIS_2 davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:GPS_1 davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:GPS_2 davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Gyrocompass davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:SatelliteCompass davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Autopilot davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Speedlog davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Echosounder davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Anemometer davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:AIS_Transponder davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:BNWAS davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:VDR davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:CourseRecorder davom:belongsToZone ll1:Zone_BridgeNavigationOT .
ll1:Link_AIS_VHFDataLink davom:belongsToZone ll1:Zone_ShoreExternal .
ll1:SurroundingVesselGNSSPositionData davom:belongsToZone ll1:Zone_ShoreExternal .

ll1:AlarmMonitoringSystem davom:belongsToZone ll1:Zone_ElectricalAutomationOT .
ll1:FireDetectionSystem davom:belongsToZone ll1:Zone_ElectricalAutomationOT .
ll1:GeneralAlarmPA davom:belongsToZone ll1:Zone_ElectricalAutomationOT .
ll1:NavLightPanel davom:belongsToZone ll1:Zone_ElectricalAutomationOT .

ll1:CommunicationsPC davom:belongsToZone ll1:Zone_ShipBusinessIT .
ll1:InmarsatGX davom:belongsToZone ll1:Zone_ShipBusinessIT .
ll1:InmarsatFBB davom:belongsToZone ll1:Zone_ShipBusinessIT .

# The satellite LAN is the conduit between ship IT and the shore; the BNWAS to
# AMS serial line is the conduit between the two OT zones.
ll1:Link_SatComm_LAN a davom:Conduit ;
    davom:connectsZone ll1:Zone_ShipBusinessIT , ll1:Zone_ShoreExternal .

ll1:Link_BNWAS_AMS a davom:Conduit ;
    davom:connectsZone ll1:Zone_BridgeNavigationOT , ll1:Zone_ElectricalAutomationOT .


# ═══════════════════════════════════════════════════════════════════════════════
# TYPED DEPENDENCIES
#
# Direction convention: source is the upstream provider, target the downstream
# consumer. Following these edges from ll1:GPS_1 answers the question WARRaNT
# asks when GNSS integrity is lost: which components, links, functions and
# roles depend, directly or indirectly, on GNSS-derived position.
# ═══════════════════════════════════════════════════════════════════════════════

# — The own-ship GNSS position path (primary scenario, paths A and B)

ll1:Dep_GPS_to_PositionData a davom:DataDependency ;
    warrant:hasName "GPS No1 → own-ship position data" ;
    davom:dependencySource ll1:GPS_1 ; davom:dependencyTarget ll1:OwnShipPositionData ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "1.0"^^xsd:decimal ;
    davom:hasCriticality "Critical" ; davom:hasRedundancyLevel 1 ;
    warrant:hasDescription "GPS No2 can take over as the source, which covers a receiver fault but not interference: both receivers are exposed to the same signal." .

ll1:Dep_GPS_to_ECDIS a davom:DataDependency ;
    warrant:hasName "Own-ship position data → ECDIS own-ship position" ;
    davom:dependencySource ll1:OwnShipPositionData ; davom:dependencyTarget ll1:ECDIS_1 ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.6"^^xsd:decimal ;
    davom:hasCriticality "Critical" ; davom:hasRedundancyLevel 1 ;
    warrant:hasDescription "The path that makes GNSS spoofing an own-ship position error on the chart. ECDIS displays correctly what it receives. AIS has no equivalent path into own-ship position." .

ll1:Dep_GPS_to_Radar a davom:DataDependency ;
    warrant:hasName "Own-ship position data → radar geo-referencing" ;
    davom:dependencySource ll1:OwnShipPositionData ; davom:dependencyTarget ll1:RadarXBand ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.4"^^xsd:decimal ; davom:hasCriticality "High" ;
    warrant:hasDescription "Radar uses own-ship GNSS position and ground speed to geo-reference echoes: target latitude and longitude, chart overlay alignment and ground-stabilised target vectors. Echo detection, range and bearing do not depend on it, which is why radar range and bearing remain independent evidence under spoofing." .

ll1:Dep_PositionData_to_AIS a davom:DataDependency ;
    warrant:hasName "Own-ship position data → AIS transponder" ;
    davom:dependencySource ll1:OwnShipPositionData ; davom:dependencyTarget ll1:AIS_Transponder ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.8"^^xsd:decimal ; davom:hasCriticality "High" ;
    warrant:hasDescription "The AIS transponder takes own-ship position from the GPS bus (per the interconnection details). Our own AIS position therefore repeats our GNSS and is never independent evidence for it." .

ll1:Dep_AIS_to_OwnShipBroadcast a davom:DataDependency ;
    warrant:hasName "AIS transponder → own-ship AIS broadcast" ;
    davom:dependencySource ll1:AIS_Transponder ; davom:dependencyTarget ll1:OwnShipAISBroadcast ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "1.0"^^xsd:decimal ; davom:hasCriticality "High" .

ll1:Dep_PositionData_to_Autopilot a davom:ControlDependency ;
    warrant:hasName "Own-ship position data → autopilot track control" ;
    davom:dependencySource ll1:OwnShipPositionData ; davom:dependencyTarget ll1:Autopilot ;
    davom:hasDependencyType davom:CONTROL , davom:DATA ;
    davom:hasDependencyWeight "0.5"^^xsd:decimal ; davom:hasCriticality "High" ;
    warrant:hasDescription "The autopilot receives GPS (per the equipment inventory). In track-control mode it steers to hold the planned track against the GNSS position, so a spoofed position steers the vessel off the true track without any officer action. In heading mode the dependency is not in use." .

ll1:Dep_PositionData_to_NavigationFunction a davom:DataDependency ;
    warrant:hasName "Own-ship position data → navigation function" ;
    davom:dependencySource ll1:OwnShipPositionData ; davom:dependencyTarget ll1:NavigationFunction ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.6"^^xsd:decimal ; davom:hasCriticality "Critical" ;
    warrant:hasDescription "Function-level summary of the component paths above, at the granularity of the dependability indices. Mirrored by the CYBER_THREAT propagation edge from the position-data index to the navigation index." .

# — The surrounding-traffic path (primary scenario, path C)

ll1:Dep_TrafficGNSS_to_TrafficAIS a davom:DataDependency ;
    warrant:hasName "Surrounding vessels' GNSS position → their AIS reports" ;
    davom:dependencySource ll1:SurroundingVesselGNSSPositionData ; davom:dependencyTarget ll1:SurroundingTrafficAISReports ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "1.0"^^xsd:decimal ; davom:hasCriticality "High" ;
    warrant:hasDescription "Outside this vessel's boundary. The reason a genuine, well-formed AIS report can carry a wrong position." .

ll1:Dep_TrafficAIS_to_AIS a davom:DataDependency ;
    warrant:hasName "Surrounding traffic AIS reports → AIS transponder (received)" ;
    davom:dependencySource ll1:SurroundingTrafficAISReports ; davom:dependencyTarget ll1:AIS_Transponder ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.8"^^xsd:decimal ; davom:hasCriticality "High" .

# — Presentation to the officer: the GNSS-derived channel and the independent one

ll1:Dep_ECDIS_to_NavigationOfficer a davom:DataDependency ;
    warrant:hasName "ECDIS → navigation officer (own-ship position and AIS overlay)" ;
    davom:dependencySource ll1:ECDIS_1 ; davom:dependencyTarget ll1:NavigationOfficerRole ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.6"^^xsd:decimal ; davom:hasCriticality "Critical" .

ll1:Dep_Radar_to_NavigationOfficer a davom:DataDependency ;
    warrant:hasName "Radar → navigation officer (range and bearing)" ;
    davom:dependencySource ll1:RadarXBand ; davom:dependencyTarget ll1:NavigationOfficerRole ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.4"^^xsd:decimal ; davom:hasCriticality "High" ;
    warrant:hasDescription "The independent channel for both own-ship position (ranges and bearings to charted features) and traffic (echoes in range and bearing)." .

# — Other bridge data dependencies

ll1:Dep_Gyro_to_ECDIS a davom:DataDependency ;
    warrant:hasName "Gyrocompass heading → ECDIS" ;
    davom:dependencySource ll1:Gyrocompass ; davom:dependencyTarget ll1:ECDIS_1 ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.5"^^xsd:decimal ; davom:hasCriticality "Critical" .

ll1:Dep_Gyro_to_Autopilot a davom:ControlDependency ;
    warrant:hasName "Gyrocompass heading → autopilot" ;
    davom:dependencySource ll1:Gyrocompass ; davom:dependencyTarget ll1:Autopilot ;
    davom:hasDependencyType davom:CONTROL , davom:DATA ;
    davom:hasDependencyWeight "0.7"^^xsd:decimal ; davom:hasCriticality "Critical" ;
    warrant:hasDescription "Loss or falsification of heading removes automatic steering; fallback is local or manual steering." .

ll1:Dep_AIS_to_ECDIS a davom:DataDependency ;
    warrant:hasName "AIS target data → ECDIS overlay" ;
    davom:dependencySource ll1:AIS_Transponder ; davom:dependencyTarget ll1:ECDIS_1 ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.3"^^xsd:decimal ; davom:hasCriticality "High" ;
    warrant:hasDescription "Carries the traffic picture, not own-ship position. Both direct AIS spoofing and GNSS corruption at the transmitting vessels reach ECDIS over this dependency." .

ll1:Dep_Radar_to_ECDIS a davom:DataDependency ;
    warrant:hasName "Radar targets → ECDIS overlay (LAN)" ;
    davom:dependencySource ll1:RadarXBand ; davom:dependencyTarget ll1:ECDIS_1 ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.4"^^xsd:decimal ; davom:hasCriticality "High" ;
    warrant:hasDescription "Radar targets and overlay. Echo range and bearing are the independent leg of the traffic cross-check; the overlay's geographic alignment uses own-ship GNSS and is not independent." .

ll1:Dep_Sensors_to_VDR a davom:DataDependency ;
    warrant:hasName "Bridge sensor feeds → VDR" ;
    davom:dependencySource ll1:GPS_1 ; davom:dependencyTarget ll1:VDR ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.3"^^xsd:decimal ; davom:hasCriticality "Medium" .

ll1:Dep_CommsPC_to_SatTerminals a davom:CyberDependency ;
    warrant:hasName "Communications PC ↔ satellite terminals (IT/OT ingress)" ;
    davom:dependencySource ll1:CommunicationsPC ; davom:dependencyTarget ll1:InmarsatGX ;
    davom:hasDependencyType davom:CYBER , davom:DATA ;
    davom:hasDependencyWeight "0.6"^^xsd:decimal ; davom:hasCriticality "High" ;
    davom:isBidirectional true ;
    warrant:hasDescription "Bidirectional because the conduit permits reverse access: shore traffic reaches the terminals and the terminals reach the PC. Neither terminal runs endpoint protection per the equipment inventory." .

ll1:Dep_BNWAS_to_AMS a davom:DataDependency ;
    warrant:hasName "BNWAS watch alarm status → AMS" ;
    davom:dependencySource ll1:BNWAS ; davom:dependencyTarget ll1:AlarmMonitoringSystem ;
    davom:hasDependencyType davom:DATA ;
    davom:hasDependencyWeight "0.4"^^xsd:decimal ; davom:hasCriticality "High" .


# ═══════════════════════════════════════════════════════════════════════════════
# FMEA FAILURE MODES WITH TYPED RATINGS
#
# Ratings are Danaos FMEA worksheet values for vessel V145 (severity,
# occurrence, detection, and the risk priority number as recorded), not values
# computed by the graph. They are engineering baseline knowledge in the KG; a
# high RPN does not place a failure mode in the GNSS spoofing scenario, and the
# worksheet has no GNSS spoofing entry.
# ═══════════════════════════════════════════════════════════════════════════════

ll1:FM_AMSDataChange a cdm:FailureMode ;
    warrant:hasName "AMS monitoring data changed or falsified" ;
    cdm:affectsComponent ll1:AlarmMonitoringSystem ;
    cdm:producesDeviation ll1:DevAMSDataCorrupted ;
    cdm:hasHazardClass cdm:CYBER_THREAT ;
    cdm:hasSeverityScore 7 ; cdm:hasOccurrenceScore 9 ; cdm:hasDetectionScore 5 ; cdm:hasRiskPriorityNumber 315 .

