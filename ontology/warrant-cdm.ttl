##############################################################################
# WARRaNT CDM Ontology Module
# Causal Dependability Model (STPA / HAZOP)
# Version: 1.0.0
# IRI: https://warrant-project.eu/ontology/cdm
# Imports: warrant-core.ttl, warrant-davom.ttl
#
# DEPRECATION NOTICE:
# The Deviation subclass pattern (cdm:UnavailableDeviation, cdm:LessDeviation,
# etc.) is DEPRECATED in v0.9. All deviation typing MUST use cdm:hasDeviationType
# with the named cdm:DeviationType individuals (cdm:NO, cdm:LESS, cdm:MORE,
# cdm:LATE, cdm:WRONG, cdm:UNAVAILABLE, cdm:UNTRUSTED, cdm:INCONSISTENT,
# cdm:NOISY, cdm:SPOOFED).
# Subclasses are retained with owl:deprecated true for one minor release.
#
# NOTE: VoyageSegment and OperationalMode are NOT defined here.
# They are warrant:ContextEntity subclasses in warrant-core.ttl.
#
# Design-time knowledge encoded here (HAZOP, FMEA/FMECA, STPA, cybersecurity
# assessment): deviations, hazards, risks (with the safety/environmental/
# financial impact triple), accidents, losses, failure modes (with FMEA
# scores), controls with residual risk, threat scenarios and vulnerabilities,
# and hazard classes with their admissible propagation dependency types.
# Runtime responses are NOT defined here (see warrant-mitigation.ttl).
##############################################################################

@prefix warrant: <https://warrant-project.eu/ontology/core#> .
@prefix davom:   <https://warrant-project.eu/ontology/davom#> .
@prefix cdm:     <https://warrant-project.eu/ontology/cdm#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://warrant-project.eu/ontology/cdm>
    a owl:Ontology ;
    owl:imports <warrant-core.ttl> , <warrant-davom.ttl> ;
    rdfs:label "WARRaNT CDM Module"@en ;
    rdfs:comment "Causal Dependability Model supporting STPA/HAZOP/FMEA and cybersecurity-assessment causal reasoning. Core chain: Deviation → Hazard → Risk → Accident → Loss, with design-time Controls (and their residual risk) mitigating Hazards and ThreatScenarios, and HazardClasses declaring the dependency types over which each class of risk propagates."@en ;
    dcterms:creator "WARRaNT Consortium (Horizon Europe RIA 101202581)" ;
    dcterms:issued "2026-06-05"^^xsd:date ;
    dcterms:modified "2026-06-08"^^xsd:date ;
    owl:versionInfo "1.0.0" .


##############################################################################
# Causal Entity Superclass
##############################################################################

cdm:CausalEntity a owl:Class ;
    rdfs:label "Causal Entity"@en ;
    rdfs:comment "Abstract superclass for all entities in the causal dependability chain."@en .


##############################################################################
# Core Causal Chain: Deviation → Hazard → Risk → Accident → Loss
##############################################################################

cdm:Loss a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Loss"@en ;
    rdfs:comment "Unacceptable outcome: property damage, environmental damage, loss of life, or loss of mission."@en .

cdm:Accident a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Accident"@en ;
    rdfs:comment "Sudden, unwanted, unplanned event or sequence that has led to harm (Rausand & Haugen, 2020)."@en .

cdm:Hazard a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:subClassOf warrant:VisualisableEntity ;
    rdfs:label "Hazard"@en ;
    rdfs:comment "A system state or condition that may lead to an accident or loss."@en .

cdm:Risk a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:subClassOf warrant:VisualisableEntity ;
    rdfs:label "Risk"@en ;
    rdfs:comment "Evaluation of a hazard or threat scenario in terms of likelihood and impact. Impact is assessed separately against safety, environmental, and financial consequences (cdm:hasSafetyImpact, cdm:hasEnvironmentalImpact, cdm:hasFinancialImpact); the governing value recorded in cdm:hasImpact is the most severe of the three. A Risk may be the design-time (inherent) evaluation of a hazard or the residual risk that remains after a Control (cdm:hasResidualRisk). Tag with cdm:hasHazardClass so that runtime risk propagation follows only the admissible dependency types."@en .

cdm:Control a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Control"@en ;
    rdfs:comment "A design-time safeguard, control, or mitigation measure identified by HAZOP, FMEA/FMECA, STPA, or the cybersecurity risk assessment and approved as part of the baseline (e.g. redundant positioning source, message authentication at a gateway, bridge access restriction). A Control mitigates one or more Hazards or ThreatScenarios (cdm:mitigates) and is associated with the residual risk that remains once it is in place (cdm:hasResidualRisk) rather than with an assumption of elimination. Design-time controls are what the Living Dependability Case holds claims about; the runtime response that activates or relies on a control is a mit:MitigationAction linked back through mit:implementsControl. Governed configuration: version, approval, and validity are recorded with warrant:hasVersion, warrant:approvedBy, warrant:validFrom/validTo."@en .

cdm:ThreatScenario a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:subClassOf warrant:VisualisableEntity ;
    rdfs:label "Threat Scenario"@en ;
    rdfs:comment "A cybersecurity threat scenario identified at design time through Cyber-HAZOP, STPA-Sec, vulnerability assessment, or threat modelling (e.g. GNSS spoofing, AIS manipulation, denial of service, unauthorised access, malware propagation, compromised software update, adversarial input to an AI-enabled function). Represented with the same principles as a safety Hazard: it exploits a Vulnerability, degrades assets, is evaluated as a Risk (likelihood and the impact triple), is mitigated by Controls, and carries a HazardClass (normally cdm:CYBER_THREAT). Distinct from scen:Threat, which is a trigger for a what-if Scenario."@en .

cdm:Vulnerability a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Vulnerability"@en ;
    rdfs:comment "A weakness of a component, system, link, data flow, zone, or procedure that a ThreatScenario can exploit (e.g. an unauthenticated broadcast protocol, an unpatched firmware version recorded in warrant:hasSoftwareVersion, an open update interface). Link to the affected asset with cdm:affectsComponent or cdm:degrades."@en .

cdm:HazardClass a owl:Class ;
    rdfs:label "Hazard Class"@en ;
    rdfs:comment "Closed controlled vocabulary of hazard classes used by typed risk propagation. Each class is associated at design time with the admissible set of dependency types through which its mechanism can act (cdm:propagatesOverDependencyType); the in-neighbourhood of a node during propagation contains only nodes connected by a dependency of an admissible type for that class. Risk is propagated per class and aggregated conservatively per node (max) by the external calculation. Adding a class requires ontology revision, as for DependabilityIndexState."@en .

cdm:CYBER_THREAT     a cdm:HazardClass ; rdfs:label "CYBER_THREAT"@en ;
    rdfs:comment "Cyber threats and attacks. Propagates over DATA and CONTROL dependencies (and CYBER paths and conduits), never over PHYSICAL dependencies."@en ;
    cdm:propagatesOverDependencyType davom:DATA , davom:CONTROL , davom:CYBER .
cdm:PHYSICAL_FAILURE a cdm:HazardClass ; rdfs:label "PHYSICAL_FAILURE"@en ;
    rdfs:comment "Mechanical, thermal, electrical, or structural failure. Propagates over PHYSICAL and FUNCTIONAL dependencies."@en ;
    cdm:propagatesOverDependencyType davom:PHYSICAL , davom:FUNCTIONAL .
cdm:DATA_LOSS        a cdm:HazardClass ; rdfs:label "DATA_LOSS"@en ;
    rdfs:comment "Loss, unavailability, or corruption of a data product (e.g. position, heading, context data). Propagates over DATA and FUNCTIONAL dependencies."@en ;
    cdm:propagatesOverDependencyType davom:DATA , davom:FUNCTIONAL .

cdm:Deviation a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:subClassOf warrant:VisualisableEntity ;
    rdfs:label "Deviation"@en ;
    rdfs:comment "An abnormal condition relative to expected operation or data. Tag with cdm:hasDeviationType using a named cdm:DeviationType individual. Do NOT create Deviation subclasses — that pattern is deprecated."@en .


##############################################################################
# DeviationType Controlled Vocabulary (named individuals)
##############################################################################

cdm:DeviationType a owl:Class ;
    rdfs:label "Deviation Type"@en ;
    rdfs:comment "Controlled vocabulary of HAZOP guidewords. Use cdm:hasDeviationType to tag a Deviation individual."@en .

cdm:NO           a cdm:DeviationType ; rdfs:label "NO"@en ;           rdfs:comment "No flow, no signal, function absent."@en .
cdm:LESS         a cdm:DeviationType ; rdfs:label "LESS"@en ;         rdfs:comment "Less than intended quantity, flow, or signal."@en .
cdm:MORE         a cdm:DeviationType ; rdfs:label "MORE"@en ;         rdfs:comment "More than intended quantity, flow, or signal."@en .
cdm:LATE         a cdm:DeviationType ; rdfs:label "LATE"@en ;         rdfs:comment "Later than expected."@en .
cdm:WRONG        a cdm:DeviationType ; rdfs:label "WRONG"@en ;        rdfs:comment "Wrong direction, content, or target."@en .
cdm:UNAVAILABLE  a cdm:DeviationType ; rdfs:label "UNAVAILABLE"@en ;  rdfs:comment "Component, service, or signal unavailable."@en .
cdm:UNTRUSTED    a cdm:DeviationType ; rdfs:label "UNTRUSTED"@en ;    rdfs:comment "Source, identity, or integrity cannot be verified."@en .
cdm:INCONSISTENT a cdm:DeviationType ; rdfs:label "INCONSISTENT"@en ; rdfs:comment "Conflicting or incoherent data from multiple sources."@en .
cdm:NOISY        a cdm:DeviationType ; rdfs:label "NOISY"@en ;        rdfs:comment "Excessive noise or degraded signal quality."@en .
cdm:SPOOFED      a cdm:DeviationType ; rdfs:label "SPOOFED"@en ;      rdfs:comment "Data injected or manipulated by an adversary (cyberattack)."@en .


##############################################################################
# DEPRECATED Deviation Subclasses
# Retained for one minor release (v0.2.0 will remove them).
# Use cdm:hasDeviationType with named individuals instead.
##############################################################################

cdm:NoDeviation a owl:Class ;
    rdfs:subClassOf cdm:Deviation ;
    owl:deprecated true ;
    rdfs:label "No Deviation (DEPRECATED)"@en ;
    skos:altLabel "NO"@en ;
    rdfs:comment "DEPRECATED. Use cdm:Deviation with cdm:hasDeviationType cdm:NO instead. Will be removed in v0.2.0."@en .

cdm:LessDeviation a owl:Class ;
    rdfs:subClassOf cdm:Deviation ;
    owl:deprecated true ;
    rdfs:label "Less Deviation (DEPRECATED)"@en ;
    skos:altLabel "LESS"@en ;
    rdfs:comment "DEPRECATED. Use cdm:Deviation with cdm:hasDeviationType cdm:LESS instead. Will be removed in v0.2.0."@en .

cdm:MoreDeviation a owl:Class ;
    rdfs:subClassOf cdm:Deviation ;
    owl:deprecated true ;
    rdfs:label "More Deviation (DEPRECATED)"@en ;
    skos:altLabel "MORE"@en ;
    rdfs:comment "DEPRECATED. Use cdm:Deviation with cdm:hasDeviationType cdm:MORE instead. Will be removed in v0.2.0."@en .

cdm:LateDeviation a owl:Class ;
    rdfs:subClassOf cdm:Deviation ;
    owl:deprecated true ;
    rdfs:label "Late Deviation (DEPRECATED)"@en ;
    skos:altLabel "LATE"@en ;
    rdfs:comment "DEPRECATED. Use cdm:Deviation with cdm:hasDeviationType cdm:LATE instead. Will be removed in v0.2.0."@en .

cdm:WrongDeviation a owl:Class ;
    rdfs:subClassOf cdm:Deviation ;
    owl:deprecated true ;
    rdfs:label "Wrong Deviation (DEPRECATED)"@en ;
    skos:altLabel "WRONG"@en ;
    rdfs:comment "DEPRECATED. Use cdm:Deviation with cdm:hasDeviationType cdm:WRONG instead. Will be removed in v0.2.0."@en .

cdm:UnavailableDeviation a owl:Class ;
    rdfs:subClassOf cdm:Deviation ;
    owl:deprecated true ;
    rdfs:label "Unavailable Deviation (DEPRECATED)"@en ;
    skos:altLabel "UNAVAILABLE"@en ;
    rdfs:comment "DEPRECATED. Use cdm:Deviation with cdm:hasDeviationType cdm:UNAVAILABLE instead. Will be removed in v0.2.0."@en .

cdm:UntrustedDeviation a owl:Class ;
    rdfs:subClassOf cdm:Deviation ;
    owl:deprecated true ;
    rdfs:label "Untrusted Deviation (DEPRECATED)"@en ;
    skos:altLabel "UNTRUSTED"@en ;
    rdfs:comment "DEPRECATED. Use cdm:Deviation with cdm:hasDeviationType cdm:UNTRUSTED instead. Will be removed in v0.2.0."@en .

cdm:InconsistentDeviation a owl:Class ;
    rdfs:subClassOf cdm:Deviation ;
    owl:deprecated true ;
    rdfs:label "Inconsistent Deviation (DEPRECATED)"@en ;
    skos:altLabel "INCONSISTENT"@en ;
    rdfs:comment "DEPRECATED. Use cdm:Deviation with cdm:hasDeviationType cdm:INCONSISTENT instead. Will be removed in v0.2.0."@en .

cdm:NoisyDeviation a owl:Class ;
    rdfs:subClassOf cdm:Deviation ;
    owl:deprecated true ;
    rdfs:label "Noisy Deviation (DEPRECATED)"@en ;
    skos:altLabel "NOISY"@en ;
    rdfs:comment "DEPRECATED. Use cdm:Deviation with cdm:hasDeviationType cdm:NOISY instead. Will be removed in v0.2.0."@en .

cdm:SpoofedDeviation a owl:Class ;
    rdfs:subClassOf cdm:Deviation ;
    owl:deprecated true ;
    rdfs:label "Spoofed Deviation (DEPRECATED)"@en ;
    skos:altLabel "SPOOFED"@en ;
    rdfs:comment "DEPRECATED. Use cdm:Deviation with cdm:hasDeviationType cdm:SPOOFED instead. Will be removed in v0.2.0."@en .


##############################################################################
# STPA Classes
##############################################################################

cdm:SafetyConstraint a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Safety Constraint"@en ;
    rdfs:comment "A constraint that, if violated, may lead to a hazard."@en .

cdm:ControlStructure a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Control Structure"@en .

cdm:Controller a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Controller"@en .

cdm:ControlledProcess a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Controlled Process"@en .

cdm:Feedback a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Feedback"@en .

cdm:ProcessModel a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Process Model"@en ;
    rdfs:comment "The controller's internal model of the controlled process state. A ProcessModelFlaw arises when this model diverges from the actual state."@en .

cdm:ProcessModelFlaw a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Process Model Flaw"@en ;
    rdfs:comment "A divergence between the controller's process model and actual process state, leading to an unsafe control action."@en .

cdm:UnsafeControlAction a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Unsafe Control Action"@en ;
    rdfs:comment "A control action that is missing, incorrect, late, early, stopped too soon, or applied too long (STPA terminology)."@en .

cdm:CausalScenario a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Causal Scenario"@en .

cdm:FailureMode a owl:Class ;
    rdfs:subClassOf cdm:CausalEntity ;
    rdfs:label "Failure Mode"@en ;
    rdfs:comment "A specific way in which a component or system can fail (FMEA/FMECA terminology). A FailureMode affects one or more components (cdm:affectsComponent) and produces one or more deviations (cdm:producesDeviation) that propagate into the causal chain. Use cdm:hasDeviationType on the produced Deviation to tag the HAZOP guideword. FMEA ratings are carried as typed integers (cdm:hasSeverityScore, cdm:hasOccurrenceScore, cdm:hasDetectionScore, cdm:hasRiskPriorityNumber) so that existing FMEA worksheets can be loaded as intended inputs to the graph."@en .


##############################################################################
# Object Properties
##############################################################################

cdm:hasDeviationType a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( cdm:Deviation cdm:ProcessModelFlaw ) ] ;
    rdfs:range cdm:DeviationType ;
    rdfs:label "has deviation type"@en ;
    rdfs:comment "Tags a Deviation individual (or a ProcessModelFlaw, whose divergence from reality is itself a guideword-typed condition, typically WRONG or LATE) with a HAZOP guideword from the cdm:DeviationType controlled vocabulary."@en .

cdm:hasHazardClass a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( cdm:Hazard cdm:ThreatScenario cdm:Risk cdm:FailureMode ) ] ;
    rdfs:range cdm:HazardClass ;
    rdfs:label "has hazard class"@en ;
    rdfs:comment "Assigns the hazard class that governs how the risk attached to this hazard, threat scenario, failure mode, or risk propagates through the dependency graph."@en .

cdm:propagatesOverDependencyType a owl:ObjectProperty ;
    rdfs:domain cdm:HazardClass ;
    rdfs:range davom:DependencyType ;
    rdfs:label "propagates over dependency type"@en ;
    rdfs:comment "Declares, per hazard class, the admissible dependency types through which that class of risk can act. Declared in the ontology at design time, not inferred at runtime. This restriction is what distinguishes typed propagation from a single weighted adjacency."@en .

cdm:mitigates a owl:ObjectProperty ;
    rdfs:domain cdm:Control ;
    rdfs:range [ owl:unionOf ( cdm:Hazard cdm:ThreatScenario cdm:FailureMode ) ] ;
    rdfs:label "mitigates"@en ;
    rdfs:comment "A design-time Control reduces the likelihood or impact of a Hazard, ThreatScenario, or FailureMode. The remaining exposure is recorded with cdm:hasResidualRisk."@en .

cdm:hasResidualRisk a owl:ObjectProperty ;
    rdfs:domain cdm:Control ;
    rdfs:range cdm:Risk ;
    rdfs:label "has residual risk"@en ;
    rdfs:comment "The Risk that remains once this Control is in place. The design-time assessment iterates until residual risk meets the stated objectives; the same quantity is then tracked by monitoring during operation."@en .

cdm:exploits a owl:ObjectProperty ;
    rdfs:domain cdm:ThreatScenario ;
    rdfs:range cdm:Vulnerability ;
    rdfs:label "exploits"@en .

cdm:affectsComponent a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( cdm:FailureMode cdm:Vulnerability ) ] ;
    rdfs:range davom:Component ;
    rdfs:label "affects component"@en ;
    rdfs:comment "Links a FailureMode or Vulnerability to the component(s) it degrades, puts out of service, or exposes. Range is davom:Component; subclasses (SensorComponent, SoftwareComponent, etc.) are valid."@en .

cdm:producesDeviation a owl:ObjectProperty ;
    rdfs:domain cdm:FailureMode ;
    rdfs:range cdm:Deviation ;
    rdfs:label "produces deviation"@en ;
    rdfs:comment "Links a FailureMode to the Deviation(s) it generates, connecting FMEA failure mode analysis to the HAZOP/STPA causal chain."@en .

cdm:mayCause a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( cdm:Deviation cdm:ProcessModelFlaw cdm:UnsafeControlAction ) ] ;
    rdfs:range [ owl:unionOf ( cdm:Hazard cdm:UnsafeControlAction ) ] ;
    rdfs:label "may cause"@en ;
    rdfs:comment "Causal propagation within the CDM chain. The link from a Deviation, Hazard, or UnsafeControlAction to an assr:AssuranceDegradation is expressed by assr:causesAssuranceDegradation (declared in warrant-assurance, which imports this module), not by this property."@en .

cdm:mayLeadTo a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( cdm:Hazard cdm:UnsafeControlAction ) ] ;
    rdfs:range [ owl:unionOf ( cdm:Accident cdm:Hazard ) ] ;
    rdfs:label "may lead to"@en .

cdm:isEvaluatedAs a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( cdm:Hazard cdm:ThreatScenario ) ] ;
    rdfs:range cdm:Risk ;
    rdfs:label "is evaluated as"@en ;
    rdfs:comment "Links a Hazard or ThreatScenario to its risk evaluation (likelihood and impact triple)."@en .

cdm:realises a owl:ObjectProperty ;
    rdfs:domain cdm:Accident ;
    rdfs:range cdm:Loss ;
    rdfs:label "realises"@en .

cdm:prevents a owl:ObjectProperty ;
    rdfs:domain cdm:SafetyConstraint ;
    rdfs:range cdm:Hazard ;
    rdfs:label "prevents"@en .

cdm:issues a owl:ObjectProperty ;
    rdfs:domain cdm:Controller ;
    rdfs:range davom:ControlAction ;
    rdfs:label "issues"@en .

cdm:actsOn a owl:ObjectProperty ;
    rdfs:domain davom:ControlAction ;
    rdfs:range cdm:ControlledProcess ;
    rdfs:label "acts on"@en .

cdm:providesFeedback a owl:ObjectProperty ;
    rdfs:domain cdm:ControlledProcess ;
    rdfs:range cdm:Feedback ;
    rdfs:label "provides feedback"@en .

cdm:updates a owl:ObjectProperty ;
    rdfs:domain cdm:Feedback ;
    rdfs:range cdm:ProcessModel ;
    rdfs:label "updates"@en .

cdm:degrades a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( cdm:Hazard cdm:Deviation cdm:ThreatScenario cdm:Vulnerability ) ] ;
    rdfs:range [ owl:unionOf ( davom:Component davom:System davom:VesselFunction davom:DataFlow davom:CommunicationLink davom:SecurityZone ) ] ;
    rdfs:label "degrades"@en ;
    rdfs:comment "Links a hazard, deviation, threat scenario, or vulnerability to the assets it degrades or exposes: components, systems, functions, data flows, communication links (including conduits), or security zones."@en .

cdm:isCriticalUnder a owl:ObjectProperty ;
    rdfs:domain cdm:Hazard ;
    rdfs:range warrant:EnvironmentalCondition ;
    rdfs:label "is critical under"@en .

cdm:influences a owl:ObjectProperty ;
    rdfs:domain warrant:EnvironmentalCondition ;
    rdfs:range cdm:Risk ;
    rdfs:label "influences"@en .

cdm:modifiesLikelihoodOf a owl:ObjectProperty ;
    rdfs:domain warrant:EnvironmentalCondition ;
    rdfs:range cdm:Risk ;
    rdfs:label "modifies likelihood of"@en .

cdm:modifiesImpactOf a owl:ObjectProperty ;
    rdfs:domain warrant:EnvironmentalCondition ;
    rdfs:range cdm:Risk ;
    rdfs:label "modifies impact of"@en .

cdm:isPerformedUnder a owl:ObjectProperty ;
    rdfs:domain davom:ControlAction ;
    rdfs:range warrant:OperationalMode ;
    rdfs:label "is performed under"@en .

cdm:wasObservedUnder a owl:ObjectProperty ;
    rdfs:domain cdm:Deviation ;
    rdfs:range warrant:OperationalMode ;
    rdfs:label "was observed under"@en .

cdm:hasOperationalContext a owl:ObjectProperty ;
    rdfs:domain cdm:CausalEntity ;
    rdfs:range warrant:ContextEntity ;
    rdfs:label "has operational context"@en .

cdm:hasEnvironmentalCondition a owl:ObjectProperty ;
    rdfs:domain cdm:Risk ;
    rdfs:range warrant:EnvironmentalCondition ;
    rdfs:label "has environmental condition"@en .


##############################################################################
# Datatype Properties
##############################################################################

cdm:hasLikelihood    a owl:DatatypeProperty ; rdfs:domain cdm:Risk ; rdfs:range xsd:decimal ; rdfs:label "has likelihood"@en .
cdm:hasImpact        a owl:DatatypeProperty ; rdfs:domain cdm:Risk ; rdfs:range xsd:decimal ; rdfs:label "has impact"@en ;
    rdfs:comment "Governing impact value: the most severe of cdm:hasSafetyImpact, cdm:hasEnvironmentalImpact, and cdm:hasFinancialImpact when the triple is recorded; otherwise the single assessed impact."@en .
cdm:hasSeverity      a owl:DatatypeProperty ; rdfs:domain cdm:Risk ; rdfs:range xsd:decimal ; rdfs:label "has severity"@en .
cdm:hasRiskLevel     a owl:DatatypeProperty ; rdfs:domain cdm:Risk ; rdfs:range xsd:string  ; rdfs:label "has risk level"@en .
cdm:hasAcceptability a owl:DatatypeProperty ; rdfs:domain cdm:Risk ; rdfs:range xsd:string  ; rdfs:label "has acceptability"@en .

# Impact triple (cybersecurity risk assessment methodology): impact assessed
# separately per consequence category; the governing value is the maximum.
cdm:hasSafetyImpact        a owl:DatatypeProperty ; rdfs:domain cdm:Risk ; rdfs:range xsd:decimal ; rdfs:label "has safety impact"@en ;
    rdfs:comment "Impact on safety of life and the vessel, normalised to [0,1]."@en .
cdm:hasEnvironmentalImpact a owl:DatatypeProperty ; rdfs:domain cdm:Risk ; rdfs:range xsd:decimal ; rdfs:label "has environmental impact"@en ;
    rdfs:comment "Impact on the environment (pollution, emissions), normalised to [0,1]."@en .
cdm:hasFinancialImpact     a owl:DatatypeProperty ; rdfs:domain cdm:Risk ; rdfs:range xsd:decimal ; rdfs:label "has financial impact"@en ;
    rdfs:comment "Financial and operational impact (loss of mission, damage, liability), normalised to [0,1]."@en .

# FMEA / FMECA ratings on FailureMode (integer scales as used in the worksheets,
# typically 1–10; RPN = severity × occurrence × detection).
cdm:hasSeverityScore      a owl:DatatypeProperty ; rdfs:domain cdm:FailureMode ; rdfs:range xsd:integer ; rdfs:label "has severity score"@en ;
    rdfs:comment "FMEA severity rating (S) of the failure mode's effect."@en .
cdm:hasOccurrenceScore    a owl:DatatypeProperty ; rdfs:domain cdm:FailureMode ; rdfs:range xsd:integer ; rdfs:label "has occurrence score"@en ;
    rdfs:comment "FMEA occurrence/probability rating (O)."@en .
cdm:hasDetectionScore     a owl:DatatypeProperty ; rdfs:domain cdm:FailureMode ; rdfs:range xsd:integer ; rdfs:label "has detection score"@en ;
    rdfs:comment "FMEA detection rating (D): higher means harder to detect before effect."@en .
cdm:hasRiskPriorityNumber a owl:DatatypeProperty ; rdfs:domain cdm:FailureMode ; rdfs:range xsd:integer ; rdfs:label "has risk priority number"@en ;
    rdfs:comment "FMEA risk priority number (RPN) as recorded in the worksheet. Stored, not computed, by the KG."@en .

##############################################################################
# END warrant-cdm.ttl
##############################################################################
