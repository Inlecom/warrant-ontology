##############################################################################
# WARRaNT Digital Twin Ontology Module
# Version: 1.0.0
# IRI: https://warrant-project.eu/ontology/digital-twin
# Imports: warrant-core.ttl, warrant-davom.ttl, warrant-observation.ttl,
#          warrant-di.ttl, warrant-scenario.ttl, warrant-mitigation.ttl
#
# Defines the semantic interface between the KG and the Digital Twin:
# views, visualisation layers, decision-support interfaces, and update
# channels — in both directions. The twin CONSUMES the graph (visualises,
# monitors, executes scenarios, stores results) and PRODUCES inputs to it:
# it is an obs:DataSource (state estimates, virtual sensing, health events)
# and it produces di:DIForecast individuals (predictive simulation, what-if
# analysis) that feed the Dependability Supervisor's predictive trigger and
# REDS's expected-effect estimates. The forecast class lives in warrant-di so
# that no module needs to import this one.
#
# IMPORTANT: warrant:VisualisableEntity is defined in warrant-core.ttl.
# Do NOT redefine dt:VisualisableEntity here. Import and use the core class.
##############################################################################

@prefix warrant: <https://warrant-project.eu/ontology/core#> .
@prefix davom:   <https://warrant-project.eu/ontology/davom#> .
@prefix obs:     <https://warrant-project.eu/ontology/observation#> .
@prefix di:      <https://warrant-project.eu/ontology/dependability-index#> .
@prefix scen:    <https://warrant-project.eu/ontology/scenario#> .
@prefix dt:      <https://warrant-project.eu/ontology/digital-twin#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://warrant-project.eu/ontology/digital-twin>
    a owl:Ontology ;
    owl:imports <warrant-core.ttl> , <warrant-davom.ttl> , <warrant-observation.ttl> ,
                <warrant-di.ttl> , <warrant-scenario.ttl> , <warrant-mitigation.ttl> ;
    rdfs:label "WARRaNT Digital Twin Module"@en ;
    rdfs:comment "Semantic interface between the WARRaNT KG and the Digital Twin: views, visualisation layers, decision-support, and update channels in both directions. The twin consumes the graph (visualises, monitors, executes scenarios, stores results) and produces inputs to it: as an observation data source (state estimation, virtual sensing, health events) and as the producer of DI forecasts used by the Dependability Supervisor and REDS. The KG defines what the DT executes, visualises, stores and forecasts — it does NOT implement the DT."@en ;
    dcterms:creator "WARRaNT Consortium (Horizon Europe RIA 101202581)" ;
    dcterms:issued "2026-06-05"^^xsd:date ;
    dcterms:modified "2026-06-08"^^xsd:date ;
    owl:versionInfo "1.0.0" .


##############################################################################
# VisualisableEntity subclass declarations
# (warrant:VisualisableEntity is defined in warrant-core.ttl)
##############################################################################

di:DependabilityIndex       rdfs:subClassOf warrant:VisualisableEntity .
di:SystemDependabilityIndex rdfs:subClassOf warrant:VisualisableEntity .
scen:Scenario               rdfs:subClassOf warrant:VisualisableEntity .
scen:ScenarioExecution      rdfs:subClassOf warrant:VisualisableEntity .
warrant:OperationalEntity   rdfs:subClassOf warrant:VisualisableEntity .
warrant:AgentEntity         rdfs:subClassOf warrant:VisualisableEntity .


##############################################################################
# Digital Twin Classes
##############################################################################

dt:DigitalTwin a owl:Class ;
    rdfs:subClassOf obs:DataSource ;
    rdfs:label "Digital Twin"@en ;
    rdfs:comment "A synchronised digital representation of a vessel or system integrating physics-based models, data-driven models, virtual sensors, operational telemetry and simulation. It provides real-time state estimation, virtual sensing, predictive analysis, scenario exploration and what-if evaluation. Consumer role: executes scenarios, visualises indices, states, triggers, hazards, evaluations and failover procedures, monitors operational entities, and receives live updates from analytical services. Producer role: as an obs:DataSource its state estimates and predictions are admissible sources of measurements, virtual-sensor outputs and health events (obs:hasSource, obs:producesHealthEvent); it provides virtual sensors (dt:providesVirtualSensor); and it produces DI forecasts (dt:producesForecast → di:DIForecast) that feed the Supervisor's predictive resilience trigger and REDS's expected-effect estimates."@en .

dt:DigitalTwinView a owl:Class ;
    rdfs:label "Digital Twin View"@en ;
    rdfs:comment "A configurable view displayed on the DT interface (e.g. vessel overview, function health panel, scenario panel)."@en .

dt:VisualisationLayer a owl:Class ;
    rdfs:label "Visualisation Layer"@en ;
    rdfs:comment "A rendering layer within a DigitalTwinView. Instances declare which KG entities they render via dt:visualises (e.g. DI heatmap layer, hazard overlay, alert layer)."@en .

dt:DecisionSupportView a owl:Class ;
    rdfs:subClassOf dt:DigitalTwinView ;
    rdfs:label "Decision Support View"@en ;
    rdfs:comment "A specialised DigitalTwinView for operator decision-support: presents the operational state and DI (always with the Assurance Level), active resilience triggers, the ranked REDS response evaluations with their expected-effect forecasts, the authorisation status of the selected response, and scenario results side-by-side. The operator approves or overrides from here; the input is recorded as evidence."@en .

dt:ScenarioExecutionState a owl:Class ;
    owl:deprecated true ;
    rdfs:label "Scenario Execution State (DEPRECATED)"@en ;
    rdfs:comment "DEPRECATED. Use scen:ScenarioExecutionState (warrant-scenario), which carries the PENDING, RUNNING, COMPLETED and FAILED individuals and is the range of scen:hasExecutionState. This class had no individuals and no property used it. Will be removed in the next minor release."@en .


##############################################################################
# Object Properties
##############################################################################

dt:executes a owl:ObjectProperty ;
    rdfs:domain dt:DigitalTwin ;
    rdfs:range scen:Scenario ;
    rdfs:label "executes"@en .

dt:visualises a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( dt:DigitalTwin dt:VisualisationLayer ) ] ;
    rdfs:range warrant:VisualisableEntity ;
    rdfs:label "visualises"@en ;
    rdfs:comment "Range constrained to warrant:VisualisableEntity (defined in warrant-core.ttl). Do NOT use dt:VisualisableEntity."@en .

dt:storesResult a owl:ObjectProperty ;
    rdfs:domain dt:DigitalTwin ;
    rdfs:range scen:ScenarioExecution ;
    rdfs:label "stores result"@en .

dt:monitors a owl:ObjectProperty ;
    rdfs:domain dt:DigitalTwin ;
    rdfs:range warrant:OperationalEntity ;
    rdfs:label "monitors"@en .

dt:representsStateOf a owl:ObjectProperty ;
    rdfs:domain dt:DigitalTwin ;
    rdfs:range davom:Vessel ;
    rdfs:label "represents state of"@en .

dt:hasView a owl:ObjectProperty ;
    rdfs:domain dt:DigitalTwin ;
    rdfs:range dt:DigitalTwinView ;
    rdfs:label "has view"@en .

dt:hasLayer a owl:ObjectProperty ;
    rdfs:domain dt:DigitalTwinView ;
    rdfs:range dt:VisualisationLayer ;
    rdfs:label "has layer"@en .

dt:supportsDecision a owl:ObjectProperty ;
    rdfs:domain dt:DigitalTwin ;
    rdfs:range dt:DecisionSupportView ;
    rdfs:label "supports decision"@en .

dt:receivesUpdateFrom a owl:ObjectProperty ;
    rdfs:domain dt:DigitalTwin ;
    rdfs:range obs:DataSource ;
    rdfs:label "receives update from"@en ;
    rdfs:comment "Documents that the DT receives live updates from analytical services, sensors, node health monitors, or operator inputs."@en .

dt:producesForecast a owl:ObjectProperty ;
    rdfs:domain dt:DigitalTwin ;
    rdfs:range di:DIForecast ;
    rdfs:label "produces forecast"@en ;
    rdfs:comment "The twin's predictive simulation or what-if analysis produced this DI forecast. This is the Digital Twin → Dependability Supervisor / REDS direction of the framework: the forecast is consumed by di:ResilienceTrigger (PREDICTED_FLOOR_CROSSING) and by mit:ResponseEvaluation (expected effect of a candidate response). Declared here so that neither warrant-di nor warrant-mitigation imports this module; the forecast should also carry di:forecastProducedBy pointing back at the twin."@en .

dt:providesVirtualSensor a owl:ObjectProperty ;
    rdfs:domain dt:DigitalTwin ;
    rdfs:range obs:VirtualSensor ;
    rdfs:label "provides virtual sensor"@en ;
    rdfs:comment "A virtual sensor (model-based state estimate) hosted by the twin, which may substitute a failed or untrusted physical observer (obs:substitutesFor) as a fail-operational response."@en .

##############################################################################
# END warrant-digital-twin.ttl
##############################################################################
