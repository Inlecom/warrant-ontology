##############################################################################
# WARRaNT Observation Ontology Module
# Version: 0.10-poc
# IRI: https://warrant-project.eu/ontology/observation
# Imports: warrant-core.ttl, warrant-davom.ttl, warrant-cdm.ttl
#
# Models metrics, observers, measurements, analytical services, health events
# (detected and predicted), detection events, node health monitors, virtual
# sensors, data quality, human observations, and operator inputs.
#
# Critical modelling rules:
# - Components do NOT generate metrics; operational entities HAVE metrics.
# - obs:produces range: Status | VirtualSensorOutput only — NOT cdm:Deviation.
# - Production path: AnalyticalService → producesDetectionEvent →
#   DetectionEvent → detectionEventDetects → Deviation.
# - obs:detects is a SPARQL shortcut only; its domain is DetectionEvent.
# - obs:HealthEvent is the structured health-event record exchanged between
#   Node Health Monitors. DetectionEvent is the HealthEvent that identifies a
#   Deviation (the detection-event rule applies to it); PredictedConditionEvent
#   is the HealthEvent that anticipates a condition (no Deviation required).
# - Raw time-series data stays outside the KG; use hasExternalRecordReference
#   and hasExternalTimeSeriesId to link to external stores.
##############################################################################

@prefix warrant: <https://warrant-project.eu/ontology/core#> .
@prefix davom:   <https://warrant-project.eu/ontology/davom#> .
@prefix obs:     <https://warrant-project.eu/ontology/observation#> .
@prefix cdm:     <https://warrant-project.eu/ontology/cdm#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://warrant-project.eu/ontology/observation>
    a owl:Ontology ;
    owl:imports <warrant-core.ttl> , <warrant-davom.ttl> , <warrant-cdm.ttl> ;
    rdfs:label "WARRaNT Observation Module"@en ;
    rdfs:comment "Metrics, observers, measurements, analytical services, health events (detected and predicted), detection events, node health monitors, virtual sensors, data quality, human observations, and operator inputs."@en ;
    dcterms:creator "WARRaNT Consortium (Horizon Europe RIA 101202581)" ;
    dcterms:issued "2026-06-05"^^xsd:date ;
    dcterms:modified "2026-09-06"^^xsd:date ;
    owl:versionInfo "0.10-poc" .


##############################################################################
# Evidence Superclass (aligns with warrant:EvidenceEntity in core)
##############################################################################

obs:EvidenceEntity a owl:Class ;
    rdfs:subClassOf warrant:EvidenceEntity ;
    rdfs:label "Evidence Entity (Observation)"@en ;
    rdfs:comment "Observation-module superclass for all observation and evidence entities."@en .


##############################################################################
# DataSource
##############################################################################

obs:DataSource a owl:Class ;
    rdfs:subClassOf obs:EvidenceEntity ;
    rdfs:label "Data Source"@en ;
    rdfs:comment "A source of measurements, observations, operator inputs, analytical outputs, or evidence. Subclasses include Observer, AnalyticalService, and system-level data producers."@en .

obs:Observer rdfs:subClassOf obs:DataSource .
obs:AnalyticalService rdfs:subClassOf obs:DataSource .
davom:HumanOperatorRole rdfs:subClassOf obs:DataSource .


##############################################################################
# Metric
##############################################################################

obs:Metric a owl:Class ;
    rdfs:subClassOf obs:EvidenceEntity ;
    rdfs:label "Metric"@en ;
    rdfs:comment "A dependability-relevant measurable property of an operational entity (Component, System, VesselFunction, DataFlow, CommunicationLink, or HumanOperatorRole). Components have metrics; they do not generate metrics."@en .

obs:DependabilityMetric    a owl:Class ; rdfs:subClassOf obs:Metric ; rdfs:label "Dependability Metric"@en .
obs:PerformanceMetric      a owl:Class ; rdfs:subClassOf obs:Metric ; rdfs:label "Performance Metric"@en .
obs:SafetyMetric           a owl:Class ; rdfs:subClassOf obs:Metric ; rdfs:label "Safety Metric"@en .
obs:CybersecurityMetric    a owl:Class ; rdfs:subClassOf obs:Metric ; rdfs:label "Cybersecurity Metric"@en .
obs:AvailabilityMetric     a owl:Class ; rdfs:subClassOf obs:Metric ; rdfs:label "Availability Metric"@en .
obs:ReliabilityMetric      a owl:Class ; rdfs:subClassOf obs:Metric ; rdfs:label "Reliability Metric"@en .
obs:DataQualityMetric      a owl:Class ; rdfs:subClassOf obs:Metric ; rdfs:label "Data Quality Metric"@en .
obs:HumanPerformanceMetric a owl:Class ; rdfs:subClassOf obs:Metric ; rdfs:label "Human Performance Metric"@en .


##############################################################################
# Measurement and Auxiliary Evidence
##############################################################################

obs:Measurement a owl:Class ;
    rdfs:subClassOf obs:EvidenceEntity ;
    rdfs:label "Measurement"@en ;
    rdfs:comment "An observed value of a metric at a specific time. Raw high-frequency measurements are stored externally; only semantic events and latest states live in the KG. Use hasExternalRecordReference to link to the external store."@en .

obs:Status               a owl:Class ; rdfs:subClassOf obs:EvidenceEntity ; rdfs:label "Status"@en .
obs:Alert                a owl:Class ; rdfs:subClassOf obs:EvidenceEntity ; rdfs:label "Alert"@en .
obs:DataQualityIndicator a owl:Class ; rdfs:subClassOf obs:EvidenceEntity ; rdfs:label "Data Quality Indicator"@en .
obs:ConfidenceLevel      a owl:Class ; rdfs:subClassOf obs:EvidenceEntity ; rdfs:label "Confidence Level"@en .


##############################################################################
# Observer
##############################################################################

obs:Observer a owl:Class ;
    rdfs:subClassOf obs:DataSource ;
    rdfs:label "Observer"@en ;
    rdfs:comment "An entity that observes, measures, or estimates a metric. Informative alignment: obs:Observer ≈ sosa:Sensor (W3C SOSA/SSN)."@en .

obs:Sensor          a owl:Class ; rdfs:subClassOf obs:Observer ; rdfs:label "Sensor"@en .
obs:Probe           a owl:Class ; rdfs:subClassOf obs:Observer ; rdfs:label "Probe"@en .
obs:DiagnosticService a owl:Class ; rdfs:subClassOf obs:Observer ; rdfs:label "Diagnostic Service"@en .
obs:APIConnector    a owl:Class ; rdfs:subClassOf obs:Observer ; rdfs:label "API Connector"@en .
obs:LogCollector    a owl:Class ; rdfs:subClassOf obs:Observer ; rdfs:label "Log Collector"@en .
obs:VirtualSensor   a owl:Class ; rdfs:subClassOf obs:Observer ;
    rdfs:label "Virtual Sensor"@en ;
    rdfs:comment "Software-based observer that estimates a metric from other data streams (model-based estimator, observer bank, fusion algorithm, ML inference, or a Digital Twin state estimate). May substitute a failed physical observer (obs:substitutesFor), which is one of the fail-operational responses the resilience layer can select. Informative alignment: obs:VirtualSensor ≈ sosa:Sensor (software-only variant)."@en .

obs:VirtualSensorOutput a owl:Class ;
    rdfs:subClassOf obs:EvidenceEntity ;
    rdfs:label "Virtual Sensor Output"@en .


##############################################################################
# AnalyticalService
##############################################################################

obs:AnalyticalService a owl:Class ;
    rdfs:subClassOf obs:DataSource ;
    rdfs:label "Analytical Service"@en ;
    rdfs:comment "A computational service that consumes metrics and produces Status, VirtualSensorOutput, or HealthEvents (including DetectionEvents). It does NOT produce Deviation directly — use the DetectionEvent production path. The WARRaNT runtime agents are modelled as subclasses so that their outputs carry provenance: obs:NodeHealthMonitor (here), di:DependabilitySupervisor, mit:DecisionSupportService (REDS), and mit:ResilienceSupervisor (IRDS)."@en .

obs:NodeHealthMonitor a owl:Class ;
    rdfs:subClassOf obs:AnalyticalService ;
    rdfs:label "Node Health Monitor"@en ;
    rdfs:comment "A distributed reasoning agent responsible for one node (component, function, or system) that interprets local observations, evaluates potential future states, estimates operational consequences, and communicates dependency-aware health assessments to the monitors of dependent nodes. It produces HealthEvents for its node and attribute assessments (assr:AssuranceAttributeValue with source confidence) that the Dependability Supervisor fuses. Beyond fault severity it considers persistence and duration. Health information exchanged between monitors follows the dependency topology encoded in the graph (obs:exchangesHealthEventWith)."@en .

obs:MonitoringLevel a owl:Class ;
    rdfs:label "Monitoring Level"@en ;
    rdfs:comment "Controlled vocabulary for the hierarchy level at which a Node Health Monitor operates. As information moves upward the focus shifts from component observations to subsystem impacts, functional consequences, and system-level dependability implications."@en .

obs:COMPONENT_LEVEL a obs:MonitoringLevel ; rdfs:label "COMPONENT_LEVEL"@en ; rdfs:comment "Monitor responsible for a Component or a Subsystem."@en .
obs:FUNCTION_LEVEL  a obs:MonitoringLevel ; rdfs:label "FUNCTION_LEVEL"@en ;  rdfs:comment "Monitor responsible for a VesselFunction."@en .
obs:SYSTEM_LEVEL    a obs:MonitoringLevel ; rdfs:label "SYSTEM_LEVEL"@en ;    rdfs:comment "Monitor responsible for a System, the Vessel, or a system of systems."@en .

obs:DetectionRule    a owl:Class ; rdfs:subClassOf obs:EvidenceEntity ; rdfs:label "Detection Rule"@en .

obs:HumanObservation a owl:Class ;
    rdfs:subClassOf obs:EvidenceEntity ;
    rdfs:label "Human Observation"@en ;
    rdfs:comment "A human-reported observation about a metric, status, or deviation."@en .

obs:OperatorInput a owl:Class ;
    rdfs:subClassOf obs:EvidenceEntity ;
    rdfs:label "Operator Input"@en .


##############################################################################
# HealthEvent, DetectionEvent, PredictedConditionEvent
##############################################################################

obs:HealthEvent a owl:Class ;
    rdfs:subClassOf obs:EvidenceEntity ;
    rdfs:label "Health Event"@en ;
    rdfs:comment """The structured health-event record into which runtime observations are transformed (detected, filtered, correlated, fused, contextualised, and classified against the hazard and remedy knowledge in the graph) and which Node Health Monitors exchange along dependency paths. It describes a detected fault, a predicted failure, or an abnormal operating condition. Its named fields map to properties as follows:
  eventId → warrant:hasIdentifier; time → obs:hasTimestamp; source/provenance → obs:hasSource and warrant:derivedFrom;
  affectedAsset → obs:affectsAsset; condition → obs:indicatesCondition (and, for a DetectionEvent, obs:detectionEventDetects);
  confidence → obs:hasConfidenceValue; severity → obs:hasSeverityLevel; duration/persistence → obs:hasDuration, obs:isPersistent;
  operationalImpact → obs:hasOperationalImpact; rootCause → obs:hasRootCause; missionContext → obs:hasMissionContext;
  controlStatus → obs:hasControlStatus; trend → obs:hasTrendIndicator.
Fields may be unknown when the event is first created and enriched as diagnosis proceeds. A HealthEvent is admissible as the source of an assr:Evidence item and may challenge an assr:AssuranceClaim. Interpreted events reside in the graph; raw telemetry stays in the external store."""@en .

obs:DetectionEvent a owl:Class ;
    rdfs:subClassOf obs:HealthEvent ;
    rdfs:label "Detection Event"@en ;
    rdfs:comment "A HealthEvent produced by a DetectionRule, AnalyticalService, NodeHealthMonitor, or VirtualSensor indicating that a Deviation has been detected. This is the ONLY production path to Deviation: AnalyticalService → producesDetectionEvent → DetectionEvent → detectionEventDetects → Deviation. obs:detects is a SPARQL shortcut only. Inherits the full health-event record from obs:HealthEvent."@en .

obs:PredictedConditionEvent a owl:Class ;
    rdfs:subClassOf obs:HealthEvent ;
    rdfs:label "Predicted Condition Event"@en ;
    rdfs:comment "A HealthEvent that anticipates rather than detects: a predicted failure or degradation produced by a Node Health Monitor evaluating potential future states, a Digital Twin prediction, or a predictive analytical model. It carries the same record as any HealthEvent, with obs:indicatesCondition naming the anticipated Hazard, FailureMode, or Deviation and obs:hasConfidenceValue the prediction confidence. The detection-event rule does not apply: a PredictedConditionEvent does not assert that a Deviation has occurred. Quantitative DI forecasts are stored separately as di:DIForecast."@en .


##############################################################################
# Object Properties
##############################################################################

obs:hasDependabilityMetric a owl:ObjectProperty ;
    rdfs:domain warrant:OperationalEntity ;
    rdfs:range obs:Metric ;
    rdfs:label "has dependability metric"@en ;
    rdfs:comment "Associates a metric with an operational entity (Component, System, VesselFunction, HumanOperatorRole, DataFlow, CommunicationLink)."@en .

obs:observes a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( obs:Observer obs:HumanObservation ) ] ;
    rdfs:range [ owl:unionOf ( obs:Metric obs:Status ) ] ;
    rdfs:label "observes"@en .

obs:measures a owl:ObjectProperty ;
    rdfs:domain obs:Observer ;
    rdfs:range obs:Metric ;
    rdfs:label "measures"@en .

obs:estimates a owl:ObjectProperty ;
    rdfs:domain obs:VirtualSensor ;
    rdfs:range obs:Metric ;
    rdfs:label "estimates"@en .

obs:hasMeasurement a owl:ObjectProperty ;
    rdfs:domain obs:Metric ;
    rdfs:range obs:Measurement ;
    rdfs:label "has measurement"@en .

obs:hasSource a owl:ObjectProperty ;
    rdfs:domain obs:EvidenceEntity ;
    rdfs:range obs:DataSource ;
    rdfs:label "has source"@en ;
    rdfs:comment "Source of a measurement, observation, or analytical output."@en .

obs:hasDataQuality a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( obs:Measurement obs:HumanObservation obs:OperatorInput ) ] ;
    rdfs:range obs:DataQualityIndicator ;
    rdfs:label "has data quality"@en .

obs:indicates a owl:ObjectProperty ;
    rdfs:domain obs:Measurement ;
    rdfs:range obs:Status ;
    rdfs:label "indicates"@en .

obs:detects a owl:ObjectProperty ;
    rdfs:domain obs:DetectionEvent ;
    rdfs:range cdm:Deviation ;
    rdfs:label "detects"@en ;
    rdfs:comment "SPARQL shortcut traversal property only. Domain is DetectionEvent (not AnalyticalService or Measurement directly). Production pattern: use obs:producesDetectionEvent + obs:detectionEventDetects."@en .

obs:consumes a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( obs:AnalyticalService obs:VirtualSensor ) ] ;
    rdfs:range obs:Metric ;
    rdfs:label "consumes"@en .

obs:produces a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( obs:AnalyticalService obs:VirtualSensor ) ] ;
    rdfs:range [ owl:unionOf ( obs:Status obs:VirtualSensorOutput ) ] ;
    rdfs:label "produces"@en ;
    rdfs:comment "Range is Status or VirtualSensorOutput. cdm:Deviation is NOT in the range — deviations are reached only via the DetectionEvent production path."@en .

obs:presents a owl:ObjectProperty ;
    rdfs:domain davom:OperatorInterface ;
    rdfs:range [ owl:unionOf ( obs:Metric obs:Status obs:Alert ) ] ;
    rdfs:label "presents"@en .

obs:captures a owl:ObjectProperty ;
    rdfs:domain davom:OperatorInterface ;
    rdfs:range obs:OperatorInput ;
    rdfs:label "captures"@en .

obs:supportsDetection a owl:ObjectProperty ;
    rdfs:domain obs:Measurement ;
    rdfs:range obs:DetectionEvent ;
    rdfs:label "supports detection"@en ;
    rdfs:comment "A measurement provides evidence contributing to a detection event."@en .

obs:producesHealthEvent a owl:ObjectProperty ;
    rdfs:domain obs:DataSource ;
    rdfs:range obs:HealthEvent ;
    rdfs:label "produces health event"@en ;
    rdfs:comment "A data source (sensor, virtual sensor, analytical service, Node Health Monitor, cybersecurity monitor, Digital Twin, operator role, or vessel automation system) produces a structured HealthEvent. obs:producesDetectionEvent is the specialisation for events that identify a Deviation."@en .

obs:producesDetectionEvent a owl:ObjectProperty ;
    rdfs:subPropertyOf obs:producesHealthEvent ;
    rdfs:domain [ owl:unionOf ( obs:AnalyticalService obs:VirtualSensor obs:DetectionRule ) ] ;
    rdfs:range obs:DetectionEvent ;
    rdfs:label "produces detection event"@en .

obs:monitorsNode a owl:ObjectProperty ;
    rdfs:domain obs:NodeHealthMonitor ;
    rdfs:range warrant:OperationalEntity ;
    rdfs:label "monitors node"@en ;
    rdfs:comment "The component, subsystem, function, system, or vessel for which this Node Health Monitor is responsible."@en .

obs:hasMonitoringLevel a owl:ObjectProperty ;
    rdfs:domain obs:NodeHealthMonitor ;
    rdfs:range obs:MonitoringLevel ;
    rdfs:label "has monitoring level"@en .

obs:exchangesHealthEventWith a owl:ObjectProperty ;
    rdfs:domain obs:NodeHealthMonitor ;
    rdfs:range obs:NodeHealthMonitor ;
    rdfs:label "exchanges health event with"@en ;
    rdfs:comment "Peer exchange of interpreted health assessments between Node Health Monitors. Which monitors receive updates is determined by the dependency topology in the graph: a monitor exchanges with the monitors of the nodes its node depends on and of the nodes that depend on it."@en .

obs:affectsAsset a owl:ObjectProperty ;
    rdfs:domain obs:HealthEvent ;
    rdfs:range [ owl:unionOf ( warrant:OperationalEntity warrant:AgentEntity ) ] ;
    rdfs:label "affects asset"@en ;
    rdfs:comment "The affected component, subsystem, function, system, link, or operational role (health-event field affectedAsset)."@en .

obs:indicatesCondition a owl:ObjectProperty ;
    rdfs:domain obs:HealthEvent ;
    rdfs:range [ owl:unionOf ( cdm:Hazard cdm:FailureMode cdm:Deviation cdm:ThreatScenario ) ] ;
    rdfs:label "indicates condition"@en ;
    rdfs:comment "The condition or hazard class the event has been classified against in the design-time knowledge (health-event field condition). For a DetectionEvent the detected Deviation is asserted with obs:detectionEventDetects; this property may additionally name the Hazard or FailureMode the event was classified under."@en .

obs:hasRootCause a owl:ObjectProperty ;
    rdfs:domain obs:HealthEvent ;
    rdfs:range [ owl:unionOf ( cdm:CausalEntity obs:HealthEvent warrant:OperationalEntity ) ] ;
    rdfs:label "has root cause"@en ;
    rdfs:comment "Root-cause information when known (health-event field rootCause): the originating deviation, failure mode, upstream health event, or upstream node identified by diagnosis (e.g. observer-based fault isolation) or by graph traversal along the dependency path."@en .

obs:hasMissionContext a owl:ObjectProperty ;
    rdfs:domain obs:HealthEvent ;
    rdfs:range warrant:ContextEntity ;
    rdfs:label "has mission context"@en ;
    rdfs:comment "Mission and operational context at the time of the event (health-event field missionContext): OperationalMode, VoyageSegment, or EnvironmentalCondition."@en .

obs:substitutesFor a owl:ObjectProperty ;
    rdfs:domain obs:VirtualSensor ;
    rdfs:range obs:Observer ;
    rdfs:label "substitutes for"@en ;
    rdfs:comment "The physical or other observer whose measurements this virtual sensor replaces when that observer is failed, degraded, or untrusted (virtual-sensor substitution, a fail-operational response)."@en .

obs:detectionEventDetects a owl:ObjectProperty ;
    rdfs:domain obs:DetectionEvent ;
    rdfs:range cdm:Deviation ;
    rdfs:label "detection event detects"@en ;
    rdfs:comment "The terminal step of the production chain. A DetectionEvent identifies a specific Deviation individual."@en .

obs:supportsDetectionOf a owl:ObjectProperty ;
    rdfs:domain obs:Observer ;
    rdfs:range obs:DetectionRule ;
    rdfs:label "supports detection of"@en .


##############################################################################
# Datatype Properties
##############################################################################

obs:hasValue a owl:DatatypeProperty ;
    rdfs:domain obs:Measurement ;
    rdfs:range xsd:decimal ;
    rdfs:label "has value"@en .

obs:hasTimestamp a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( obs:Measurement obs:HumanObservation obs:OperatorInput obs:HealthEvent ) ] ;
    rdfs:range xsd:dateTime ;
    rdfs:label "has timestamp"@en .

obs:hasUnit a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( obs:Measurement obs:Metric ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "has unit"@en ;
    rdfs:comment "Unit of measurement as a string. Future alignment: obs:hasUnit ≈ qudt:unit."@en .

obs:hasSamplingRate a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( obs:Metric obs:Observer ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "has sampling rate"@en .

obs:hasConfidenceValue a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( obs:ConfidenceLevel obs:VirtualSensorOutput obs:HumanObservation obs:HealthEvent ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "has confidence value"@en ;
    rdfs:comment "Confidence in [0,1] associated with a detection, prediction, estimate, or human observation. Confidence controls the influence of a source in attribute fusion and contributes to evidence quality; it is never multiplied into an operational value as a separate degradation."@en .

obs:hasSeverityLevel a owl:DatatypeProperty ;
    rdfs:domain obs:HealthEvent ;
    rdfs:range xsd:string ;
    rdfs:label "has severity level"@en ;
    rdfs:comment "Severity classification of the event (health-event field severity), e.g. LOW, MEDIUM, HIGH, CRITICAL. Distinct from cdm:hasSeverity (a design-time risk score) and from the operational state, which is assigned attribute-wise by the Dependability Supervisor."@en .

obs:hasDuration a owl:DatatypeProperty ;
    rdfs:domain obs:HealthEvent ;
    rdfs:range xsd:duration ;
    rdfs:label "has duration"@en ;
    rdfs:comment "Observed or estimated duration of the condition (health-event field duration). Monitors weigh persistence: temporary disturbances may be negligible, persistent degradations progressively reduce assurance."@en .

obs:isPersistent a owl:DatatypeProperty ;
    rdfs:domain obs:HealthEvent ;
    rdfs:range xsd:boolean ;
    rdfs:label "is persistent"@en ;
    rdfs:comment "True when the condition has persisted beyond the configured transient window and should be treated as a sustained degradation rather than a temporary disturbance."@en .

obs:hasOperationalImpact a owl:DatatypeProperty ;
    rdfs:domain obs:HealthEvent ;
    rdfs:range xsd:string ;
    rdfs:label "has operational impact"@en ;
    rdfs:comment "Expected operational impact of the condition as assessed by the monitor (health-event field operationalImpact)."@en .

obs:hasControlStatus a owl:DatatypeProperty ;
    rdfs:domain obs:HealthEvent ;
    rdfs:range xsd:string ;
    rdfs:label "has control status"@en ;
    rdfs:comment "Current control or authorisation status of the condition (health-event field controlStatus): e.g. UNCONTROLLED, LOCALLY_CONTROLLED, MITIGATION_PENDING_AUTHORISATION, MITIGATED. A locally controlled fault may have limited influence on system dependability; the Supervisor evaluates both intrinsic severity and propagated consequences."@en .

obs:hasTrendIndicator a owl:DatatypeProperty ;
    rdfs:domain obs:HealthEvent ;
    rdfs:range xsd:string ;
    rdfs:label "has trend indicator"@en ;
    rdfs:comment "Direction of the monitored node's health as assessed by the monitor: IMPROVING, STABLE, or DECLINING."@en .

obs:hasQualityValue a owl:DatatypeProperty ;
    rdfs:domain obs:DataQualityIndicator ;
    rdfs:range xsd:decimal ;
    rdfs:label "has quality value"@en .

obs:hasExternalRecordReference a owl:DatatypeProperty ;
    rdfs:domain obs:Measurement ;
    rdfs:range xsd:string ;
    rdfs:label "has external record reference"@en ;
    rdfs:comment "Key or URI pointing to the raw measurement record in an external time-series store. Prevents the KG from being used as a telemetry database."@en .

obs:hasExternalTimeSeriesId a owl:DatatypeProperty ;
    rdfs:domain obs:Metric ;
    rdfs:range xsd:string ;
    rdfs:label "has external time series id"@en ;
    rdfs:comment "Identifier of the metric's data stream in the external telemetry platform."@en .

##############################################################################
# END warrant-observation.ttl
##############################################################################
